---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sitio, contacto } from '../content/sitio.ts';
import { normalizar } from '../content/navegacion.ts';

interface Props { titulo: string; descripcion: string }
const { titulo, descripcion } = Astro.props;

const rutaActual = normalizar(Astro.url.pathname);
const canonica = new URL(rutaActual, sitio.dominio).href;
const og = new URL('/og.png', sitio.dominio).href;
const produccion = import.meta.env.PROD && process.env.VERCEL_ENV !== 'preview';

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${sitio.dominio}/#organizacion`,
  name: sitio.razon,
  alternateName: sitio.nombre,
  url: sitio.dominio,
  telephone: contacto.fijo.valor,
  email: contacto.comercial.valor,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Transversal 27 N.º 53C-47',
    addressLocality: 'Bogotá',
    addressRegion: 'Bogotá D.C.',
    addressCountry: 'CO',
  },
  areaServed: { '@type': 'Country', name: 'Colombia' },
};
---
<!doctype html>
<html lang="es-CO">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#26416B" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={sitio.nombre} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:locale" content="es_CO" />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />

  {!produccion && <meta name="robots" content="noindex, nofollow" />}

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
</head>
<body>
  <a href="#contenido" class="salto">Saltar al contenido</a>
  <Header rutaActual={rutaActual} />
  <main id="contenido"><slot /></main>
  <Footer />
</body>
</html>
