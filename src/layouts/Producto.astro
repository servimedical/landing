---
/* PLANTILLA DE PÁGINA DE PRODUCTO — una sola para cualquier marca y
   cualquier línea.

   Abre con una ficha de datos para que la página diga algo antes de pedirle
   al lector que lea prosa: marca, método, material y dónde se usa. Después,
   el orden en que la jefa de central decide: qué procesa, qué no, qué le
   preguntamos, qué más necesita y quién responde. */
import Base from './Base.astro';
import Migas from '../components/Migas.astro';
import Logotipo from '../components/marca/Logotipo.astro';
import Formulario from '../components/formulario/Formulario.astro';
import { normalizar } from '../content/navegacion.ts';
import { sitio } from '../content/sitio.ts';
import { urlLinea, type Marca } from '../content/marcas.ts';
import type { Producto } from '../content/productos/index.ts';

interface Props { marca: Marca; producto: Producto }
const { marca, producto: p } = Astro.props;

/** El bloque «qué más necesita» referencia líneas; la marca resuelve la URL. */
const destino = (n: { linea?: string; url?: string }) => (n.linea ? urlLinea(n.linea) : n.url!);

/* El título lleva la marca sólo si aporta algo: para la línea propia,
   «Servimedical — Servimedical Group» sería ruido. */
const tituloPagina = marca.nombre === 'Servimedical'
  ? `${p.titulo} | Servimedical Group`
  : `${p.titulo} — ${marca.nombre} | Servimedical Group`;
const rutaActual = normalizar(Astro.url.pathname);

/* Ficha de datos: lo que un comprador mira antes de leer nada. */
const ficha: [string, string][] = [
  ['Marca', marca.nombre],
  ['Procesa', p.procesa.slice(0, 2).join(' · ')],
  ...(p.noProcesa?.length ? ([['No procesa', p.noProcesa[0]!]] as [string, string][]) : []),
  ['Servicio', 'Instalación y mantenimiento propios'],
  ['Origen', 'Importación directa · existencias en Bogotá'],
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.titulo,
  description: p.seo.descripcion,
  url: new URL(rutaActual, sitio.dominio).href,
  brand: { '@type': 'Brand', name: marca.nombre },
  seller: { '@type': 'Organization', '@id': `${sitio.dominio}/#organizacion` },
};
---
<Base titulo={tituloPagina} descripcion={p.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  <!-- Encabezado y ficha -->
  <div class="contenedor grid gap-10 py-12 lg:grid-cols-[1.15fr_.85fr] lg:py-16">
    <div>
      <a href={`/marcas/${marca.slug}`} class="flex h-6 items-center text-steel hover:text-navy">
        <Logotipo marca={marca} class="!text-[15px]" />
      </a>
      <h1 class="mt-4 max-w-[20ch] text-[clamp(28px,3.6vw,44px)]">{p.titulo}</h1>
      <p class="mt-5 max-w-[54ch] text-[clamp(16px,1.3vw,18px)] text-steel">{p.entradilla}</p>
      <a href="#cotizar" class="mt-7 inline-flex items-center gap-2.5 border border-navy bg-navy px-5 py-3.5 text-[14.5px] font-medium text-white hover:bg-navy-deep">
        <span aria-hidden="true" class="senal"></span>Pedir cotización
      </a>
    </div>

    <dl class="h-fit border border-rule">
      {ficha.map(([k, v], i) => (
        <div class:list={['flex items-baseline justify-between gap-6 px-5 py-4', i > 0 && 'border-t border-rule']}>
          <dt class="meta shrink-0 text-[10px] text-steel">{k}</dt>
          <dd class="text-right text-[14.5px]">{v}</dd>
        </div>
      ))}
    </dl>
  </div>

  <!-- Qué procesa y qué no -->
  <section class="field-paper border-t border-rule" aria-labelledby="b1">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="b1" class="max-w-[24ch] text-[clamp(22px,2.6vw,30px)]">Qué procesa y qué no</h2>

      <div class="mt-8 grid gap-px border border-rule bg-rule lg:grid-cols-2">
        <div class="bg-white p-6 lg:p-8">
          <p class="meta text-steel">Procesa</p>
          <ul class="mt-4">
            {p.procesa.map((x) => (
              <li class="flex items-start gap-3 border-t border-rule py-3 text-[15.5px]">
                <span aria-hidden="true" class="senal mt-2"></span>{x}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white p-6 lg:p-8">
          {p.noProcesa && p.noProcesa.length > 0 ? (
            <>
              <p class="meta text-steel">No procesa</p>
              <ul class="mt-4">
                {p.noProcesa.map((x) => (
                  <li class="flex items-start gap-3 border-t border-rule py-3 text-[15.5px] text-steel">
                    <span aria-hidden="true" class="mt-2 block h-[7px] w-[7px] shrink-0 bg-mist"></span>{x}
                  </li>
                ))}
              </ul>
              {p.alternativa && (
                <p class="mt-6 border-t border-rule pt-5 text-[15px] text-steel">
                  {p.alternativa.nota}{' '}
                  <a href={destino(p.alternativa)} class="whitespace-nowrap text-navy underline decoration-rule underline-offset-4">
                    {p.alternativa.titulo} →
                  </a>
                </p>
              )}
            </>
          ) : (
            <>
              <p class="meta text-steel">Cómo se escoge</p>
              <p class="mt-4 max-w-[38ch] border-t border-rule pt-4 text-[15.5px] text-steel">
                No se descarta material: se escoge por volumen y por flujo. Eso se resuelve en
                el bloque siguiente.
              </p>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Qué preguntamos -->
  <section class="border-t border-rule" aria-labelledby="b2">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="b2" class="max-w-[26ch] text-[clamp(22px,2.6vw,30px)]">Qué preguntamos antes de cotizar</h2>

      <ol class="mt-8 max-w-[70ch] border-t border-rule">
        {p.dimensionamiento.map((q, i) => (
          <li class="grid grid-cols-[44px_1fr] items-baseline gap-4 border-b border-rule py-4">
            <span class="meta text-[11px] text-steel">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[15.5px]">{q}</span>
          </li>
        ))}
      </ol>

      <p class="mt-7 flex max-w-[58ch] items-start gap-3 text-[15.5px] font-medium">
        <span aria-hidden="true" class="senal mt-2"></span>{p.cierreDimensionamiento}
      </p>
    </div>
  </section>

  <!-- Qué más necesita -->
  <section class="field-paper border-t border-rule" aria-labelledby="b3">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="b3" class="max-w-[26ch] text-[clamp(22px,2.6vw,30px)]">Qué más necesita para operar</h2>

      <div class="mt-8 grid gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-3">
        {p.necesita.map((n) => (
          <a href={destino(n)} class="group flex flex-col bg-white p-6 transition-colors hover:bg-white/60">
            <span class="font-display text-[18px] leading-tight font-bold [font-variation-settings:'wdth'_110]">
              {n.titulo}
            </span>
            <span class="mt-3 flex-1 text-[14.5px] leading-relaxed text-steel">{n.porQue}</span>
            <span class="meta mt-5 border-t border-rule pt-4 text-[10px] text-steel group-hover:text-navy">Ver línea →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Servicio -->
  <section class="border-t border-rule" aria-labelledby="b4">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="b4" class="max-w-[26ch] text-[clamp(22px,2.6vw,30px)]">Servicio que lo acompaña</h2>

      <ul class="mt-8 max-w-[62ch] border-t border-rule">
        {p.servicio.map((s) => (
          <li class="flex items-start gap-3 border-b border-rule py-3.5 text-[15.5px]">
            <span aria-hidden="true" class="senal mt-2"></span>{s}
          </li>
        ))}
      </ul>

      <a href="/servicios" class="mt-7 inline-flex items-center border border-rule px-5 py-3 text-[14.5px] hover:bg-paper">
        Ver los servicios
      </a>
    </div>
  </section>

  <Formulario fijo={`${p.titulo} — ${marca.nombre}`} titulo={`Cotice ${p.titulo.toLowerCase()}`} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
</Base>
