---
/* PLANTILLA DE PÁGINA DE PRODUCTO — seis bloques en orden fijo.
   El orden no es configurable a propósito: es lo que impide que trece páginas
   se conviertan en trece variaciones del mismo texto vacío. */
import Base from './Base.astro';
import Migas from '../components/Migas.astro';
import MiniRueda from '../components/ciclo/MiniRueda.astro';
import Formulario from '../components/formulario/Formulario.astro';
import { estaciones } from '../content/ciclo.ts';
import { normalizar } from '../content/navegacion.ts';
import { sitio } from '../content/sitio.ts';
import type { Producto } from '../content/productos/index.ts';

interface Props { producto: Producto }
const { producto: p } = Astro.props;
const rutaActual = normalizar(Astro.url.pathname);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.titulo,
  description: p.seo.descripcion,
  url: new URL(rutaActual, sitio.dominio).href,
  category: p.categoria,
  ...(p.marcas && !p.marcas[0]!.startsWith('{{')
    ? { brand: p.marcas.map((m) => ({ '@type': 'Brand', name: m })) }
    : {}),
  seller: { '@type': 'Organization', '@id': `${sitio.dominio}/#organizacion` },
};
---
<Base titulo={p.seo.titulo} descripcion={p.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[20ch] text-[clamp(30px,4vw,48px)]">{p.titulo}</h1>
    <p class="mt-6 max-w-[62ch] text-[clamp(16px,1.3vw,18px)] text-steel">{p.entradilla}</p>
    {p.marcas && p.marcas.length > 0 && (
      <p class="meta mt-6 text-[10.5px] text-steel">{p.marcas.join(' · ')}</p>
    )}
  </div>

  <!-- 1 · Para qué material sirve -->
  <section class="border-t border-rule" aria-labelledby="b1">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">01 · Para qué material sirve</p>
      <h2 id="b1" class="mt-4 max-w-[24ch] text-[clamp(24px,3vw,34px)]">
        Qué se procesa aquí y qué no.
      </h2>

      <div class="mt-9 grid gap-px border border-rule bg-rule lg:grid-cols-2">
        <div class="bg-white p-6 lg:p-8">
          <p class="meta text-steel">Procesa</p>
          <ul class="mt-4">
            {p.procesa.map((x) => (
              <li class="flex items-start gap-3 border-t border-rule py-3 text-[15.5px]">
                <span aria-hidden="true" class="senal mt-2"></span>{x}
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white p-6 lg:p-8">
          {p.noProcesa && p.noProcesa.length > 0 ? (
            <>
              <p class="meta text-steel">No procesa</p>
              <ul class="mt-4">
                {p.noProcesa.map((x) => (
                  <li class="flex items-start gap-3 border-t border-rule py-3 text-[15.5px] text-steel">
                    <span aria-hidden="true" class="mt-2 block h-[7px] w-[7px] shrink-0 bg-mist"></span>{x}
                  </li>
                ))}
              </ul>
              {p.alternativa && (
                <p class="mt-6 border-t border-rule pt-5 text-[15px] text-steel">
                  {p.alternativa.nota}{' '}
                  <a href={p.alternativa.url} class="whitespace-nowrap text-navy underline decoration-rule underline-offset-4">
                    {p.alternativa.titulo} →
                  </a>
                </p>
              )}
            </>
          ) : (
            <>
              <p class="meta text-steel">Dónde encaja</p>
              <p class="mt-4 max-w-[38ch] border-t border-rule pt-4 text-[15.5px] text-steel">
                Esta línea no excluye material por su naturaleza: se define por el volumen
                y el flujo de la central. Es lo que se resuelve en el bloque siguiente.
              </p>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 2 · Cómo se dimensiona -->
  <section class="field-paper border-t border-rule" aria-labelledby="b2">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">02 · Cómo se dimensiona</p>
      <h2 id="b2" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">
        Lo que preguntamos antes de cotizar.
      </h2>

      <ol class="mt-9 max-w-[70ch] border-t border-rule">
        {p.dimensionamiento.map((q, i) => (
          <li class="grid grid-cols-[44px_1fr] items-baseline gap-4 border-b border-rule py-4">
            <span class="meta text-[11px] text-steel">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[15.5px]">{q}</span>
          </li>
        ))}
      </ol>

      <p class="mt-7 flex max-w-[58ch] items-start gap-3 text-[15.5px] font-medium">
        <span aria-hidden="true" class="senal mt-2"></span>{p.cierreDimensionamiento}
      </p>
    </div>
  </section>

  <!-- 3 · En qué estación del ciclo vive -->
  <section class="border-t border-rule" aria-labelledby="b3">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">03 · En qué estación del ciclo vive</p>
      <h2 id="b3" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">
        Dónde entra dentro del proceso.
      </h2>

      <div class="mt-9 max-w-[560px]">
        <MiniRueda estacion={p.estacionPrimaria} />
      </div>

      {p.estacionesSecundarias && p.estacionesSecundarias.length > 0 && (
        <div class="mt-6">
          <p class="meta text-steel">También interviene en</p>
          <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
            {p.estacionesSecundarias.map((n) => (
              <li>
                <a href={`/#/ciclo/0${n}`} class="meta text-[10.5px] text-steel underline decoration-rule underline-offset-4 hover:text-navy">
                  Estación 0{n} · {estaciones[n - 1]!.nombre}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- 4 · Qué necesita para operar -->
  <section class="field-paper border-t border-rule" aria-labelledby="b4">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">04 · Qué necesita para operar</p>
      <h2 id="b4" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">
        Lo que tiene que estar resuelto alrededor.
      </h2>

      <div class="mt-9 grid gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-3">
        {p.necesita.map((n) => (
          <a href={n.url} class="group flex flex-col bg-white p-6 transition-colors hover:bg-white/60">
            <span class="font-display text-[18px] leading-tight font-bold [font-variation-settings:'wdth'_110]">
              {n.titulo}
            </span>
            <span class="mt-3 flex-1 text-[14.5px] leading-relaxed text-steel">{n.porQue}</span>
            <span class="meta mt-5 border-t border-rule pt-4 text-[10px] text-steel group-hover:text-navy">
              Ver producto →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 · Qué servicio lo acompaña -->
  <section class="border-t border-rule" aria-labelledby="b5">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">05 · Qué servicio lo acompaña</p>
      <h2 id="b5" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">
        Quién responde después de la entrega.
      </h2>

      <ul class="mt-9 max-w-[62ch] border-t border-rule">
        {p.servicio.map((s) => (
          <li class="flex items-start gap-3 border-b border-rule py-3.5 text-[15.5px]">
            <span aria-hidden="true" class="senal mt-2"></span>{s}
          </li>
        ))}
      </ul>

      <a href="/servicios" class="btn-linea mt-7 inline-flex items-center border border-rule px-5 py-3 text-[14.5px] hover:bg-paper">
        Ver los servicios
      </a>
    </div>
  </section>

  <!-- 6 · Solicitar cotización -->
  <Formulario tipo="cotizacion" fijo={p.titulo} titulo={`Pida la cotización de ${p.titulo.toLowerCase()}.`} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
</Base>
