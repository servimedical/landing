---
import Logo from './Logo.astro';
import NavEscritorio from './NavEscritorio.astro';
import MenuMovil from './MenuMovil.astro';
import { inicio } from '../content/navegacion.ts';
import { cta, sitio } from '../content/sitio.ts';

interface Props { rutaActual: string }
const { rutaActual } = Astro.props;
---
<!--
  El desenfoque va en una capa de fondo propia y no en el <header>.
  `backdrop-filter` convierte a su elemento en bloque contenedor de los
  descendientes `position: fixed`, y eso dejaba el panel del menú móvil
  encerrado en los 72 px de la barra. La capa no tiene descendientes, así que
  el efecto es idéntico y el panel vuelve a medirse contra el viewport.
-->
<header class="sticky top-0 z-50 border-b border-rule">
  <div class="absolute inset-0 -z-10 bg-white/93 backdrop-blur-[12px]" aria-hidden="true"></div>

  <div class="contenedor flex h-(--spacing-header) items-center gap-7">
    <a href={inicio.url} class="mr-auto" aria-label={`${sitio.nombre} — ir al inicio`}>
      <Logo />
    </a>

    <NavEscritorio rutaActual={rutaActual} />

    <a
      href={cta.url}
      class="hidden items-center gap-2.5 border border-navy bg-navy px-5 py-3 text-[14.5px]
             font-medium text-white transition-colors hover:bg-navy-deep hover:border-navy-deep lg:inline-flex"
    >
      <span class="block h-[7px] w-[7px] bg-signal" aria-hidden="true"></span>{cta.texto}
    </a>

    <MenuMovil rutaActual={rutaActual} />
  </div>
</header>
