---
/* Logotipo de Servimedical Group, en el encabezado y en el pie.

   Si el archivo existe, se usa; si no, cae a la marca tipográfica, que es la
   que está hoy. Dos archivos porque el pie va sobre navy y un logotipo azul
   ahí no se lee:

     public/logos/servimedical-group.svg          fondo claro  · encabezado
     public/logos/servimedical-group-blanco.svg   fondo oscuro · pie

   Se acepta .svg, .webp o .png con el mismo nombre. Mientras falte el blanco,
   el pie sigue con la marca tipográfica, que ya cumple contraste AA: un
   logotipo azul sobre navy no se lee, y recolorearlo sería rehacer la marca. */
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  sufijo?: string;
  /** `oscuro` para fondos navy: sube el contraste del sufijo a AA. */
  variante?: 'claro' | 'oscuro';
  class?: string;
}
const { sufijo = 'GROUP', variante = 'claro', class: clase = '' } = Astro.props;

const base = variante === 'oscuro' ? 'servimedical-group-blanco' : 'servimedical-group';
/* Se resuelve contra `process.cwd()`, que en build y en dev es la raíz del
   proyecto. No contra `import.meta.url`: en el build el componente vive en
   dist/.prerender/chunks y la ruta relativa apunta a otra parte. */
const archivo = ['svg', 'webp', 'png']
  .map((ext) => `/logos/${base}.${ext}`)
  .find((f) => existsSync(join(process.cwd(), 'public', f)));

/* La proporción se lee del `viewBox` del propio archivo en vez de escribirse
   a mano. El logotipo anterior era un bloque apilado de 2,2:1 y el actual es
   horizontal de 5:1; con la proporción escrita a mano, cambiar el archivo
   dejaba el `width`/`height` mintiendo y el navegador reservando una caja que
   no era, que es salto de maquetación. */
const PROPORCION_POR_DEFECTO = 300 / 60;
const proporcion = (() => {
  if (!archivo?.endsWith('.svg')) return PROPORCION_POR_DEFECTO;
  const svg = readFileSync(join(process.cwd(), 'public', archivo), 'utf8').slice(0, 2000);
  const vb = svg.match(/viewBox="[\d.\s-]*?([\d.]+)[\s,]+([\d.]+)"/);
  if (!vb) return PROPORCION_POR_DEFECTO;
  const r = Number(vb[1]) / Number(vb[2]);
  return Number.isFinite(r) && r > 0 ? r : PROPORCION_POR_DEFECTO;
})();
const alto = 60;
const ancho = Math.round(alto * proporcion);
---
{archivo ? (
  <img
    src={archivo}
    alt="Servimedical Group"
    class:list={['svmg-marca', clase]}
    width={ancho} height={alto} loading="eager" decoding="async"
  />
) : (
  <span class:list={['inline-flex items-baseline gap-[7px]', clase]}>
    <span class="font-display text-[19px] leading-none [font-variation-settings:'wdth'_118] font-extrabold">
      SERVIMEDICAL
    </span>
    <span
      class:list={[
        'font-mono text-[10px] leading-none tracking-[.22em]',
        variante === 'oscuro' ? 'text-white/70' : 'text-steel',
      ]}
    >{sufijo}</span>
  </span>
)}

<style>
  /* Alto fijo y ancho al contenido: el logotipo manda el ancho, no al revés,
     para que no se deforme ni empuje la barra.

     38 px, no 46. El logotipo apilado de antes necesitaba altura para que su
     segunda línea se leyera; el horizontal de ahora es 5:1 y a 46 px se comía
     la barra de 72. A 38 px la palabra «SERVIMEDICAL» mide lo mismo que
     antes —ya no compite con un símbolo encima— y quedan 17 px de aire a cada
     lado.

     El tope de ancho sube a 260: un 5:1 a 38 px pide 190, y 220 dejaba sin
     margen a un archivo algo más ancho. */
  .svmg-marca {
    display: block;
    block-size: 38px;
    inline-size: auto;
    max-inline-size: 260px;
    object-fit: contain;
    object-position: left center;
  }
</style>
