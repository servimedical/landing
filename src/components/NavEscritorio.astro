---
import { enNavbar, nodosLineas, rutaActiva, normalizar } from '../content/navegacion.ts';
import PanelMenu, { type ColumnaMenu } from './PanelMenu.astro';
import { marcas, urlMarca } from '../datos/marcas.ts';
import { productosDeMarca, urlProducto } from '../datos/productos.ts';

interface Props { rutaActual: string }
const { rutaActual } = Astro.props;

const cadena = rutaActiva(rutaActual).map((n) => n.url);
const exacta = normalizar(rutaActual);

/* Dos vistas del mismo catálogo. Líneas lo ordena por método —lista simple,
   sin marcas debajo—; Marcas, por fabricante. Las dos salen de src/datos. */
const columnasLineas: ColumnaMenu[] = nodosLineas.map((l) => ({
  titulo: l.titulo,
  url: l.url,
  descriptor: l.descriptor ?? '',
  items: [],
}));

const columnasMarcas: ColumnaMenu[] = [...marcas]
  .sort((a, b) => a.orden - b.orden)
  .map((m) => ({
    titulo: m.nombre,
    url: urlMarca(m.slug),
    descriptor: m.descriptor,
    /* Un ítem por producto, no por línea: 2i aporta dos productos a la misma
       línea y con una entrada por línea solo se veía uno. */
    items: productosDeMarca(m.slug).map((p) => ({
      titulo: p.nombre === 'Autoclaves' ? 'Autoclaves de vapor' : p.nombre,
      url: urlProducto(p),
    })),
  }));

/* Qué entrada del navbar abre qué panel. */
const PANELES: Record<string, { id: string; etiqueta: string }> = {
  '/lineas': { id: 'panel-lineas', etiqueta: 'el menú de líneas' },
  '/marcas': { id: 'panel-marcas', etiqueta: 'el menú de marcas' },
};
---
<nav aria-label="Principal" class="hidden lg:block">
  <ul class="flex items-center gap-5 xl:gap-7">
    {enNavbar.map((nodo) => {
      const panel = PANELES[nodo.url];
      return (
        <li class:list={['h-(--spacing-header) flex items-center', panel && 'grupo-panel']} data-panel={panel?.id}>
          <a
            href={nodo.url}
            aria-current={normalizar(nodo.url) === exacta ? 'page' : undefined}
            class:list={[
              'flex h-full items-center border-b-2 text-[14.5px] transition-colors',
              cadena.includes(nodo.url) ? 'border-signal' : 'border-transparent hover:border-rule',
            ]}
          >{nodo.titulo}</a>

          {panel && (
            <button
              type="button"
              class="disparador ml-1.5 flex h-6 w-6 items-center justify-center text-steel"
              aria-expanded="false"
              aria-controls={panel.id}
              aria-label={`Abrir ${panel.etiqueta}`}
              data-etiqueta={panel.etiqueta}
            >
              <svg viewBox="0 0 10 6" class="chevron h-[6px] w-[10px] transition-transform" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
              </svg>
            </button>
          )}
        </li>
      );
    })}
  </ul>
</nav>

<PanelMenu id="panel-lineas" columnas={columnasLineas} cols={2} variante="simple" rutaActual={rutaActual}
           pie={{ texto: 'Ver todas las líneas', url: '/lineas' }} />

<PanelMenu id="panel-marcas" columnas={columnasMarcas} cols={3} rutaActual={rutaActual}
           pie={{ texto: 'Ver todas las marcas', url: '/marcas' }} />

<style>
  .disparador[aria-expanded='true'] .chevron { transform: rotate(180deg); }
</style>

<script>
  /* Un solo guion para los dos paneles: abrir uno cierra el otro. */
  const finoOApuntador = window.matchMedia('(hover: hover) and (pointer: fine)');

  type Menu = {
    grupo: HTMLElement;
    disparador: HTMLButtonElement;
    panel: HTMLElement;
    abrir: (v: boolean) => void;
    abierto: () => boolean;
  };

  const menus: Menu[] = [];

  document.querySelectorAll<HTMLElement>('.grupo-panel').forEach((grupo) => {
    const disparador = grupo.querySelector<HTMLButtonElement>('.disparador');
    const panel = document.getElementById(grupo.dataset.panel ?? '');
    if (!disparador || !panel) return;

    const etiqueta = disparador.dataset.etiqueta ?? 'el menú';

    const abierto = () => disparador.getAttribute('aria-expanded') === 'true';

    /* Un panel angosto se ancla bajo su propia entrada del navbar; uno de
       ancho completo no se mueve. Se recalcula al abrir porque la posición
       del navbar cambia con el ancho de la ventana. */
    const anclar = () => {
      if (!panel.hasAttribute('data-anclado')) return;
      const cabecera = panel.offsetParent as HTMLElement | null;
      if (!cabecera) return;
      const margen = 20;
      const x = grupo.getBoundingClientRect().left - cabecera.getBoundingClientRect().left;
      const maximo = cabecera.clientWidth - panel.offsetWidth - margen;
      panel.style.left = `${Math.max(margen, Math.min(x, maximo))}px`;
    };

    const abrir = (v: boolean) => {
      if (v) { menus.forEach((m) => { if (m.panel !== panel && m.abierto()) m.abrir(false); }); anclar(); }
      disparador.setAttribute('aria-expanded', String(v));
      disparador.setAttribute('aria-label', `${v ? 'Cerrar' : 'Abrir'} ${etiqueta}`);
      panel.toggleAttribute('data-abierto', v);
    };

    const menu: Menu = { grupo, disparador, panel, abrir, abierto };
    menus.push(menu);

    /* Con ratón manda el hover, no el clic: si el clic también alternara,
       acercar el puntero abriría el panel y el clic lo cerraría de inmediato.
       El clic alterna sólo donde no hay hover —táctil— y cuando viene del
       teclado, que es un clic sin coordenadas (`detail === 0`). */
    disparador.addEventListener('click', (e) => {
      const porTeclado = (e as MouseEvent).detail === 0;
      if (!porTeclado && finoOApuntador.matches) return;
      abrir(!abierto());
    });

    // Hover sólo en apuntadores finos: en táctil manda el clic.
    const entra = () => { if (finoOApuntador.matches) abrir(true); };
    const sale = (e: MouseEvent) => {
      if (!finoOApuntador.matches) return;
      const hacia = e.relatedTarget as Node | null;
      if (hacia && (grupo.contains(hacia) || panel.contains(hacia))) return;
      abrir(false);
    };
    grupo.addEventListener('mouseenter', entra);
    grupo.addEventListener('mouseleave', sale);
    panel.addEventListener('mouseenter', entra);
    panel.addEventListener('mouseleave', sale);
  });

  const dentroDeAlguno = (t: Node) =>
    menus.some((m) => m.panel.contains(t) || m.grupo.contains(t));

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const abierto = menus.find((m) => m.abierto());
    if (abierto) { abierto.abrir(false); abierto.disparador.focus(); }
  });

  // Clic fuera y pérdida de foco.
  document.addEventListener('pointerdown', (e) => {
    if (!dentroDeAlguno(e.target as Node)) menus.forEach((m) => m.abierto() && m.abrir(false));
  });
  document.addEventListener('focusin', (e) => {
    if (!dentroDeAlguno(e.target as Node)) menus.forEach((m) => m.abierto() && m.abrir(false));
  });
</script>
