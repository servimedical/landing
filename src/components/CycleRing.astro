---
import { ciclo } from '../data/catalogo.ts';

/* Geometría del anillo (centro 260,260 · r 190). El flujo corre en
   sentido horario desde arriba: lo sucio entra y lo estéril sale. */
const GEO = [
  { arc:'M270.6,70.3 A190,190 0 0,1 419,156',    node:[355,95.5],  txt:[323,150.9], sp:[[307,178.6],[344,114.5]] },
  { arc:'M429.6,174.3 A190,190 0 0,1 429.6,345.7', node:[450,260],  txt:[386,260],   sp:[[354,260],[428,260]]     },
  { arc:'M419,364 A190,190 0 0,1 270.6,449.7',   node:[355,424.5], txt:[323,369.1], sp:[[307,341.4],[344,405.5]] },
  { arc:'M249.4,449.7 A190,190 0 0,1 101,364',   node:[165,424.5], txt:[197,369.1], sp:[[213,341.4],[176,405.5]] },
  { arc:'M90.4,345.7 A190,190 0 0,1 90.4,174.3', node:[70,260],    txt:[134,260],   sp:[[166,260],[92,260]]      },
  { arc:'M101,156 A190,190 0 0,1 249.4,70.3',    node:[165,95.5],  txt:[197,150.9], sp:[[213,178.6],[176,114.5]] },
];
const FLECHAS = [[424.5,165,60],[424.5,355,120],[260,450,180],[95.5,355,240],[95.5,165,300],[260,70,360]];
const p0 = ciclo[0]!;
---
<div class="ring-grid">
  <svg class="ring" viewBox="0 0 520 520" role="group" aria-label="Ciclo de esterilización en seis estaciones">
    <circle class="core" cx="260" cy="260" r="86" />

    <g id="spokes">
      {GEO.map((g) => (
        <line class="spoke" x1={g.sp[0]![0]} y1={g.sp[0]![1]} x2={g.sp[1]![0]} y2={g.sp[1]![1]} />
      ))}
    </g>

    <g id="segs">
      {GEO.map((g, i) => (
        <path class="seg" d={g.arc} data-i={i} tabindex="0" role="button"
              aria-label={`Estación ${ciclo[i]!.n}: ${ciclo[i]!.nombre}`} />
      ))}
    </g>

    {FLECHAS.map(([x, y, r]) => (
      <polygon class="wedge" points="-3.5,-4.5 -3.5,4.5 3.5,0" transform={`translate(${x},${y}) rotate(${r})`} />
    ))}

    <g id="nodes">
      {GEO.map((g, i) => (
        <>
          <circle class="node" cx={g.node[0]} cy={g.node[1]} r="17" data-i={i} />
          <text class="node-n" x={g.node[0]} y={g.node[1]}>{ciclo[i]!.n}</text>
          <text class="st-lbl" x={g.txt[0]} y={g.txt[1]}>{ciclo[i]!.etiqueta}</text>
        </>
      ))}
    </g>

    <text class="core-s" x="260" y="240">HILO CONDUCTOR</text>
    <text class="core-t" x="260" y="264">TRAZABILIDAD</text>
    <text class="core-s" x="260" y="288">ETIQUETA · LECTURA</text>
  </svg>

  <div class="ring-panel">
    <p class="mono step" id="c-step">ESTACIÓN {p0.n} / 06</p>
    <h3 id="c-title">{p0.nombre}</h3>
    <p class="desc" id="c-desc">{p0.desc}</p>
    <ul class="covers" id="c-list">
      {p0.cubre.map(([a, b]) => (<li><b>{a}</b><span>{b}</span></li>))}
    </ul>
    <p class="ring-note"><i></i><span id="c-trace">{p0.traza}</span></p>
  </div>
</div>

<style>
  .ring-grid{ display:grid; grid-template-columns:1.05fr .95fr; gap:clamp(28px,4.5vw,64px); align-items:center }
  .ring{ width:100%; max-width:500px; margin-inline:auto; display:block; overflow:visible }

  .seg{ fill:none; stroke:var(--mist); stroke-width:14; cursor:pointer; transition:stroke .25s ease }
  .seg:hover{ stroke:#c4cfdc }
  .seg.on{ stroke:var(--signal) }
  .spoke{ stroke:var(--blue); stroke-width:1; stroke-dasharray:2 5; opacity:.45; transition:opacity .25s, stroke .25s }
  .spoke.on{ opacity:1; stroke:var(--signal); stroke-dasharray:none }
  .node{ fill:#fff; stroke:var(--navy); stroke-width:1.5; cursor:pointer; transition:fill .25s, stroke .25s }
  .node.on{ fill:var(--navy) }
  .node-n{
    font-family:var(--meta); font-size:12px; font-weight:600; fill:var(--navy);
    text-anchor:middle; dominant-baseline:central; pointer-events:none; transition:fill .25s;
  }
  .node-n.on{ fill:#fff }
  .st-lbl{
    font-family:var(--meta); font-size:10.5px; letter-spacing:.11em; fill:var(--steel);
    text-anchor:middle; dominant-baseline:central; pointer-events:none; transition:fill .25s;
  }
  .st-lbl.on{ fill:var(--navy); font-weight:600 }
  .core{ fill:#fff; stroke:var(--signal); stroke-width:1.5; stroke-dasharray:4 4 }
  .core-t{ font-family:var(--display); font-variation-settings:'wdth' 108; font-weight:700; font-size:15px; fill:var(--navy); text-anchor:middle }
  .core-s{ font-family:var(--meta); font-size:8.5px; letter-spacing:.12em; fill:var(--steel); text-anchor:middle }
  .wedge{ fill:var(--blue); opacity:.45 }

  .ring-panel{ border-left:2px solid var(--signal); padding-left:clamp(20px,2.5vw,30px) }
  .step{ color:var(--steel) }
  .ring-panel h3{ font-size:clamp(24px,2.7vw,34px); margin-top:12px }
  .desc{ color:var(--steel); margin-top:14px; max-width:44ch }
  .covers{ margin-top:24px; border-top:1px solid var(--rule) }
  /* :global porque estos <li> se reconstruyen en cliente al cambiar de estación */
  .covers :global(li){
    padding:11px 0; border-bottom:1px solid var(--rule); font-size:15.5px;
    display:flex; justify-content:space-between; gap:16px; align-items:baseline;
  }
  .covers :global(b){ font-weight:400 }
  .covers :global(span){
    color:var(--steel); font-family:var(--meta); font-size:10.5px;
    letter-spacing:.1em; text-transform:uppercase; white-space:nowrap;
  }
  .ring-note{ margin-top:22px; font-size:14.5px; color:var(--steel); display:flex; gap:10px; align-items:flex-start }
  .ring-note i{ width:var(--atom); height:var(--atom); background:var(--signal); flex:none; margin-top:7px; font-style:normal }

  @media (max-width:1000px){
    .ring-grid{ grid-template-columns:1fr }
    .ring-panel{ border-left:0; border-top:2px solid var(--signal); padding-left:0; padding-top:24px }
  }
</style>

<script>
  import { ciclo } from '../data/catalogo.ts';

  const svg = document.querySelector<SVGSVGElement>('.ring');
  const S = document.getElementById('c-step');
  const T = document.getElementById('c-title');
  const D = document.getElementById('c-desc');
  const L = document.getElementById('c-list');
  const TR = document.getElementById('c-trace');

  if (svg && S && T && D && L && TR) {
    const segs = [...svg.querySelectorAll('.seg')];
    const spokes = [...svg.querySelectorAll('.spoke')];
    const nodes = [...svg.querySelectorAll('.node')];
    const nums = [...svg.querySelectorAll('.node-n')];
    const lbls = [...svg.querySelectorAll('.st-lbl')];
    let actual = 0;

    const marcar = (i: number) =>
      [segs, spokes, nodes, nums, lbls].forEach((set) =>
        set.forEach((el, k) => el.classList.toggle('on', k === i))
      );

    const render = (i: number) => {
      if (i === actual) return;
      actual = i;
      const c = ciclo[i]!;
      S.textContent = `ESTACIÓN ${c.n} / 06`;
      T.textContent = c.nombre;
      D.textContent = c.desc;
      TR.textContent = c.traza;
      L.replaceChildren(
        ...c.cubre.map(([a, b]) => {
          const li = document.createElement('li');
          const strong = document.createElement('b');
          strong.textContent = a;
          const span = document.createElement('span');
          span.textContent = b;
          li.append(strong, span);
          return li;
        })
      );
      marcar(i);
    };

    const pick = (e: Event) => {
      const el = (e.target as Element)?.closest?.('[data-i]');
      if (el) render(Number((el as HTMLElement).dataset.i));
    };
    svg.addEventListener('pointerover', pick);
    svg.addEventListener('click', pick);
    svg.addEventListener('focusin', pick);
    svg.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if ((e.key === 'Enter' || e.key === ' ') && t?.dataset?.i) { e.preventDefault(); render(Number(t.dataset.i)); }
    });

    // el panel de la estación 01 ya viene renderizado del servidor: solo se marca
    marcar(0);
  }
</script>
