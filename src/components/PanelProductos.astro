---
import { nodosMarcas } from '../content/navegacion.ts';
import { marcas, rolVisible } from '../content/marcas.ts';

/* La estructura sale de navegacion.ts; el texto, de marcas.ts. */
const rolDe = (url: string) => {
  const m = marcas.find((x) => `/marcas/${x.slug}` === url);
  return m ? rolVisible(m) : '';
};

interface Props { rutaActual: string }
const { rutaActual } = Astro.props;
const activa = (url: string) => rutaActual === url || rutaActual.startsWith(url + '/');
---
<div
  id="panel-marcas"
  class="panel invisible absolute inset-x-0 top-(--spacing-header) z-40 border-b border-t
         border-rule bg-white opacity-0 transition-opacity duration-150 ease-out"
  hidden
>
  <div class="contenedor grid grid-cols-4 gap-px bg-rule py-px">
    {nodosMarcas.map((cat) => (
      <div class="bg-white p-6">
        <a
          href={cat.url}
          class:list={[
            'font-display text-[17px] leading-tight [font-variation-settings:\'wdth\'_110] font-bold',
            'border-b-2 pb-0.5 inline-block',
            activa(cat.url) ? 'border-signal' : 'border-transparent hover:border-rule',
          ]}
        >{cat.titulo}</a>
        <p class="mt-2 text-[13px] leading-snug text-steel">{rolDe(cat.url)}</p>
        {cat.hijos && (
          <ul class="mt-4 border-t border-rule">
            {cat.hijos.map((hijo) => (
              <li class="border-b border-rule">
                <a
                  href={hijo.url}
                  class:list={[
                    'block py-2.5 text-[14.5px] hover:text-steel',
                    activa(hijo.url) && 'border-l-2 border-signal pl-2.5',
                  ]}
                >{hijo.titulo}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    ))}

    <!-- Bloque de cierre: el panel es una entrada al concepto rector, no una lista plana. -->
    <div class="col-span-3 bg-paper p-6 flex flex-col justify-between gap-4">
      <p class="font-display text-[19px] leading-tight [font-variation-settings:'wdth'_110] font-bold max-w-[34ch]">
        Siete marcas, una sola conversación de servicio
      </p>
      <a href="/marcas" class="meta text-steel border-b border-rule pb-1 self-start hover:text-navy">
        Ver todas las marcas
      </a>
    </div>
  </div>
</div>

<style>
  .panel[data-abierto] { visibility: visible; opacity: 1; }
</style>
