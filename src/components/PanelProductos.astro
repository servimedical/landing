---
/* Mega-menú de marcas.

   Grilla de columnas iguales: 3 × 2 con las marcas que haya. No se rellenan
   celdas sobrantes —la grilla cierra limpia o no cierra—. La estructura y el
   texto salen de navegacion.ts, que a su vez deriva de src/datos. */
import { nodosMarcas } from '../content/navegacion.ts';

interface Props { rutaActual: string }
const { rutaActual } = Astro.props;
const activa = (url: string) => rutaActual === url || rutaActual.startsWith(url + '/');
---
<div
  id="panel-marcas"
  class="panel invisible absolute inset-x-0 top-(--spacing-header) z-40 border-b border-t
         border-rule bg-white opacity-0 transition-opacity duration-150 ease-out"
  hidden
>
  <div class="contenedor py-px">
    <ul class="grid grid-cols-3 gap-px bg-rule">
      {nodosMarcas.map((marca) => (
        <li class="bg-white p-6">
          <a
            href={marca.url}
            class:list={[
              "font-display inline-block border-b-2 pb-0.5 text-[17px] leading-tight font-bold [font-variation-settings:'wdth'_110]",
              activa(marca.url) ? 'border-signal' : 'border-transparent hover:border-rule',
            ]}
          >{marca.titulo}</a>
          <p class="mt-2 text-[13px] leading-snug text-steel">{marca.descriptor}</p>

          {marca.hijos?.length ? (
            <ul class="mt-4 border-t border-rule">
              {marca.hijos.map((linea) => (
                <li class="border-b border-rule">
                  <a
                    href={linea.url}
                    class:list={[
                      'block py-2.5 text-[14.5px] hover:text-steel',
                      activa(linea.url) && 'border-l-2 border-signal pl-2.5',
                    ]}
                  >{linea.titulo}</a>
                </li>
              ))}
            </ul>
          ) : null}
        </li>
      ))}
    </ul>

    <p class="border-t border-rule py-4">
      <a href="/marcas" class="meta text-[10px] text-steel hover:text-navy">Ver todas las marcas →</a>
    </p>
  </div>
</div>

<style>
  .panel[data-abierto] { visibility: visible; opacity: 1; }
</style>
