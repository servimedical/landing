---
/* Logotipo de marca.

   {{ POR CONFIRMAR: archivos de logotipo de las siete marcas, en SVG con
   fondo transparente }}

   Mientras no estén, se usa el nombre compuesto tipográficamente. No se
   dibuja el logotipo de un fabricante: o es el suyo, o no es. */
import type { Marca } from '../../content/marcas.ts';

interface Props { marca: Marca; class?: string }
const { marca, class: clase = '' } = Astro.props;
---
{marca.logo ? (
  <img
    src={`/img/marcas/${marca.logo}`} alt={marca.nombre}
    class:list={['h-7 w-auto object-contain', clase]} loading="lazy" decoding="async"
  />
) : (
  <span
    class:list={[
      "font-display text-[clamp(17px,1.6vw,21px)] leading-none font-bold",
      "[font-variation-settings:'wdth'_105]", clase,
    ]}
  >{marca.nombre}</span>
)}
