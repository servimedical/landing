---
/* Tarjeta de marca. La usan la home y /marcas: una sola definición, así que
   no pueden divergir. */
import BrandLogo from './BrandLogo.astro';
import { lineasDe, urlLinea } from '../../datos/lineas.ts';
import type { Marca } from '../../datos/tipos.ts';

interface Props { marca: Marca }
const { marca } = Astro.props;
const lineas = lineasDe(marca.slug);
---
<li class="flex flex-col border-b border-r border-rule p-6 lg:p-7">
  <a href={`/marcas/${marca.slug}`} class="group">
    <BrandLogo marca={marca} size="md" />
    <span class="meta mt-5 block text-[10px] text-steel">{marca.descriptor}</span>
  </a>

  {lineas.length > 0 && (
    <ul class="mt-5 flex flex-wrap gap-2">
      {lineas.map((l) => (
        <li>
          <a href={urlLinea(l)} class="inline-block border border-rule px-2.5 py-1.5 text-[13px] text-steel transition-colors hover:border-navy/35 hover:text-navy">
            {l.nombre}
          </a>
        </li>
      ))}
    </ul>
  )}

  <div class="mt-auto pt-7">
    <a href={`/marcas/${marca.slug}`} class="meta block border-t border-rule pt-4 text-[10px] text-steel hover:text-navy">
      Ver marca →
    </a>
  </div>
</li>
