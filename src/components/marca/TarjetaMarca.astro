---
/* Tarjeta de marca. La usan la home y /marcas: una sola definición, así que
   no pueden divergir.

   Misma lógica que la franja del inicio: el logo va solo (sin el texto que
   traen dibujado algunos, como 2i y SVM) y debajo, aparte, qué ofrece la
   marca y sus líneas de producto. */
import BrandLogo from './BrandLogo.astro';
import { lineasDeMarca, productosDeMarca, urlProducto } from '../../datos/productos.ts';
import { QUE_HACE, LOGO_SIN_TEXTO } from '../../datos/marcasTexto.ts';
import type { Marca } from '../../datos/tipos.ts';

interface Props { marca: Marca }
const { marca } = Astro.props;
const lineas = lineasDeMarca(marca.slug);
const productoDe = (slugLinea: string) => productosDeMarca(marca.slug).find((p) => p.linea === slugLinea)!;
const logoSinTexto = LOGO_SIN_TEXTO[marca.slug];
const marcaLogo = logoSinTexto ? { ...marca, logo: { ...marca.logo, src: logoSinTexto } } : marca;
const queHace = QUE_HACE[marca.slug];
---
<li class="flex flex-col border-b border-r border-rule p-6 lg:p-7">
  <a href={`/marcas/${marca.slug}`} class="group" aria-label={`Ver la marca ${marca.nombre}`}>
    <BrandLogo marca={marcaLogo} size="md" />
  </a>

  {queHace && (
    <div class="tarjeta-bloque mt-5">
      <p class="meta tarjeta-rotulo">Qué ofrece</p>
      <p class="tarjeta-que-hace">{queHace}</p>
    </div>
  )}

  {lineas.length > 0 && (
    <div class="tarjeta-bloque mt-5">
      <p class="meta tarjeta-rotulo">Líneas</p>
      <ul class="mt-2.5 flex flex-wrap gap-2">
        {lineas.map((l) => (
          <li>
            <a href={urlProducto(productoDe(l.slug))} class="inline-block border border-rule px-2.5 py-1.5 text-[13px] text-steel transition-colors hover:border-navy/35 hover:text-navy">
              {l.nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="mt-auto pt-7">
    <a href={`/marcas/${marca.slug}`} class="meta block border-t border-rule pt-4 text-[10px] text-steel hover:text-navy">
      Ver marca →
    </a>
  </div>
</li>

<style>
  .tarjeta-bloque {
    border-top: 1px solid var(--color-rule);
    padding-top: 12px;
  }
  .tarjeta-rotulo {
    font-size: 10px;
    color: var(--color-steel);
  }
  /* La misma voz que la franja del inicio: tipografía de títulos ensanchada,
     en mayúsculas espaciadas. Alto mínimo de dos líneas para que, en una
     misma fila de tarjetas, los bloques de líneas arranquen a la misma
     altura aunque un texto ocupe una línea y otro dos. */
  .tarjeta-que-hace {
    margin-top: 6px;
    min-block-size: calc(2 * 1.35em);
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 112;
    font-weight: 600;
    font-size: 13px;
    line-height: 1.35;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-navy);
    text-wrap: balance;
  }
</style>
