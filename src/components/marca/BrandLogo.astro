---
/* Logotipo de fabricante en caja de tamaño fijo.

   Tres tamaños y nada más. Un logo horizontal y uno cuadrado no pesan igual
   a la misma altura, así que la caja es fija y el archivo se ajusta dentro
   con `object-fit: contain`. Si uno queda visiblemente más grande o más
   pequeño que el resto, se corrige con `logoEscala` en src/datos/marcas.ts,
   no recortando el archivo.

   Si el archivo no está, cae a la marca tipográfica dentro de la misma caja
   —nunca a un ícono genérico ni a un rectángulo vacío—. No se dibuja el
   logotipo de un fabricante: o es el suyo, o no es. */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { Marca } from '../../datos/tipos.ts';

const CAJAS = {
  sm: { w: 132, h: 46 },  // menús, chips y la franja del hero
  md: { w: 180, h: 64 },  // tarjetas de la home y de /marcas
  lg: { w: 280, h: 96 },  // encabezado de la página de marca
} as const;

interface Props {
  marca: Pick<Marca, 'nombre' | 'logo' | 'logoEscala'>;
  size?: keyof typeof CAJAS;
  class?: string;
}
const { marca, size = 'md', class: clase } = Astro.props;
const caja = CAJAS[size];

/* Se acepta SVG o PNG con el mismo nombre: lo que haya en la carpeta.
   La ruta se resuelve contra `process.cwd()` —la raíz del proyecto— y no
   contra `import.meta.url`, que en el build apunta a dist/.prerender/chunks. */
/* El WebP primero: lo genera `npm run logos` y pesa una fracción del PNG.
   Si no está, se usa el archivo declarado en los datos. */
const sinExt = marca.logo.src.replace(/\.(svg|png|webp)$/, '');
const candidatos = [`${sinExt}.webp`, marca.logo.src, `${sinExt}.svg`, `${sinExt}.png`];
const archivo = candidatos.find((f) => existsSync(join(process.cwd(), 'public', f)));
const escala = marca.logoEscala ?? 1;
---
<span
  class:list={['svmg-logo', clase]}
  style={`--w:${caja.w}px;--h:${caja.h}px;--escala:${escala}`}
  data-tipografico={!archivo || undefined}
>
  {archivo
    ? <img src={archivo} alt={marca.logo.alt} width={caja.w} height={caja.h} loading="lazy" decoding="async" />
    : <span class="nombre">{marca.nombre}</span>}
</span>

<style>
  .svmg-logo {
    /* `inline-grid`, no `grid`: en el caso tipográfico la caja ajusta al
       texto y el nombre queda alineado con el titular, no centrado. */
    display: inline-grid;
    place-items: center start;
    block-size: var(--h);
    inline-size: var(--w);
    overflow: hidden;
  }

  .svmg-logo img {
    /* En unidades absolutas, no en %: un porcentaje sobre un grid item
       centrado se resuelve contra una altura indefinida y el logo se salía
       de la caja. Con `--w` y `--h` el contenido siempre cabe. */
    max-block-size: var(--h);
    max-inline-size: var(--w);
    inline-size: auto;
    block-size: auto;
    object-fit: contain;
    scale: var(--escala);
    /* A color en todo el sitio. El gris de reposo se retiró: apagaba marcas
       cuyo color es parte de su identidad —el verde de Celitron, el azul de
       2i— y obligaba a pasar el puntero para verlas como son. */
    transition: opacity 160ms ease;
  }

  @media (hover: hover) {
    :where(a, button):hover .svmg-logo img { opacity: 0.78; }
  }

  /* Marca tipográfica: misma altura de caja, ancho al contenido. */
  .svmg-logo[data-tipografico] { inline-size: max-content; max-inline-size: var(--w); }
  .svmg-logo .nombre {
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: 'wdth' 108;
    font-size: calc(var(--h) * 0.42);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
