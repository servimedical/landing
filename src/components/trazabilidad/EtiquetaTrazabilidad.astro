---
/* ETIQUETA DE PAQUETE ESTÉRIL Y SU LÍNEA DE VIDA.

   Renderizada en HTML, nunca como imagen. Los códigos se generan en
   compilación con semilla fija (ver src/content/trazabilidad.ts): idénticos
   entre construcciones y sin coste de JavaScript.

   El vínculo campo ↔ evento es el corazón de la pieza: se empareja por
   `data-k`, y `carga` apunta a dos eventos a propósito. */
import { etiqueta, campos, lineaDeVida, cierre, barras, matriz } from '../../content/trazabilidad.ts';

/** Cada campo describe los eventos que lo leen, para el lector de pantalla. */
const describe = (clave: string) =>
  lineaDeVida
    .map((e, i) => (e.clave === clave ? `evento-${i}` : null))
    .filter(Boolean)
    .join(' ');
---
<div class="grid gap-[clamp(28px,4vw,60px)] lg:grid-cols-[340px_1fr] lg:items-start">
  <div>
    <div class="rotulo relative border border-rule bg-white p-[18px_18px_16px]">
      <div class="troquel" aria-hidden="true"></div>

      <div class="flex items-baseline justify-between border-b-[1.5px] border-navy pb-2.5">
        <span class="font-display text-[13px] font-bold [font-variation-settings:'wdth'_110]">
          {etiqueta.institucion}
        </span>
        <span class="meta text-[9px] text-steel">{etiqueta.servicio}</span>
      </div>

      <p class="mt-3.5 mb-3 font-display text-[19px] leading-tight font-bold [font-variation-settings:'wdth'_108]">
        {etiqueta.paquete}
      </p>

      <div class="grid grid-cols-2 gap-px bg-[rgba(38,65,107,.14)]">
        {campos.map((c) => (
          <div
            class="campo bg-white px-[9px] py-2"
            data-k={c.clave} tabindex="0"
            aria-describedby={describe(c.clave)}
          >
            <p class="meta text-[8.5px] text-steel">{c.rotulo}</p>
            <p class="mt-[3px] font-mono text-[12.5px] font-semibold">{c.valor}</p>
          </div>
        ))}
      </div>

      <div class="mt-3.5 flex items-end gap-3" aria-hidden="true">
        <div class="flex h-[46px] flex-1 items-end gap-[1.5px]">
          {barras.map((w) => (<i class="block h-full bg-navy" style={`width:${w}px`}></i>))}
        </div>
        <div class="grid h-[52px] w-[52px] shrink-0 grid-cols-12 grid-rows-12">
          {matriz.map((on) => (<i class={on ? 'bg-navy' : ''}></i>))}
        </div>
      </div>

      <div class="meta mt-2.5 flex justify-between text-[9px] text-steel">
        <span>{etiqueta.pieIzq}</span><span>{etiqueta.pieDer}</span>
      </div>
    </div>

    <p class="mt-4 max-w-[42ch] text-[14px] leading-relaxed text-steel">{etiqueta.apoyo}</p>
  </div>

  <div>
    <ol class="border-t border-rule">
      {lineaDeVida.map((e, i) => (
        <li
          class="evento grid grid-cols-[68px_1fr_auto] items-baseline gap-4 border-b border-rule px-2 py-3.5"
          id={`evento-${i}`} data-k={e.clave} tabindex="0"
        >
          <span class="meta text-[11px] tracking-[.06em] text-steel">{e.hora}</span>
          <span>
            <span class="block text-[15.5px]">{e.evento}</span>
            <small class="mt-0.5 block text-[13px] text-steel">{e.subtexto}</small>
          </span>
          <a
            href={`/#/ciclo/0${e.estacion}`}
            class="meta shrink-0 text-[10.5px] text-steel underline decoration-rule underline-offset-4 hover:text-navy"
          >Estación 0{e.estacion}</a>
        </li>
      ))}
    </ol>
    <p class="mt-5 max-w-[52ch] text-[15px] text-steel">{cierre}</p>
  </div>
</div>

<style>
  /* Troquel del adhesivo: borde punteado a 6 px del margen. */
  .troquel {
    position: absolute;
    inset: 6px;
    border: 1px dashed var(--color-signal);
    pointer-events: none;
  }

  .campo, .evento { transition: background-color 200ms ease; cursor: default; }
  .campo.activo  { background: rgba(137, 216, 0, .28); }
  .evento.activo { background: rgba(137, 216, 0, .12); }

  @media (max-width: 560px) {
    .rotulo .grid-cols-2 { grid-template-columns: 1fr }
    .evento { grid-template-columns: 1fr; gap: .25rem }
  }
  @media (prefers-reduced-motion: reduce) {
    .campo, .evento { transition: none }
  }
</style>

<script>
  /* Emparejamiento bidireccional por `data-k`. Con eventos de puntero, no con
     mouseenter: en táctil no hay puntero que entre, y el vínculo debe poder
     activarse al tocar y mantenerse hasta tocar otro. También al recibir foco
     por teclado. */
  const marcados = document.querySelectorAll<HTMLElement>('.campo[data-k], .evento[data-k]');

  const pintar = (clave: string | null) => {
    marcados.forEach((el) => el.classList.toggle('activo', clave !== null && el.dataset.k === clave));
  };

  let fijado: string | null = null;

  marcados.forEach((el) => {
    const clave = el.dataset.k!;

    el.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'touch') return;
      pintar(clave);
    });
    el.addEventListener('pointerleave', (e) => {
      if ((e as PointerEvent).pointerType === 'touch') return;
      pintar(fijado);
    });

    // Táctil y clic: queda fijado hasta tocar otro.
    el.addEventListener('click', () => {
      fijado = fijado === clave ? null : clave;
      pintar(fijado);
    });

    el.addEventListener('focus', () => pintar(clave));
    el.addEventListener('blur', () => pintar(fijado));
  });
</script>
