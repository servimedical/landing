---
/* Base de los tres formularios. Cambian los campos, no el comportamiento:
   validación, errores por campo, estado de envío, acuse en la misma página y
   conservación de lo escrito si el envío falla.

   La casilla de autorización no viene marcada y sin ella no se envía:
   Ley 1581 de 2012 y Decreto 1377 de 2013. */
import { FORMULARIO, TEXTO_AUTORIZACION, URL_POLITICA, CAMPO_TRAMPA, INTRO } from '../../lib/formularios.ts';
import { contacto, canalesContacto, sitio } from '../../content/sitio.ts';

interface Props {
  id?: string;
  titulo?: string;
  /** 1 cuando el formulario es el contenido de la página (/contacto). */
  nivel?: 1 | 2;
  /** Muestra todos los canales con su rótulo, no sólo los tres de atajo. */
  detallado?: boolean;
  /** Qué se dimensiona en esta página. Decide el encuadre de la entradilla. */
  encuadre?: keyof typeof INTRO;
  /** Línea o marca de la página: se escribe al inicio de la descripción,
   *  editable, y preselecciona «Cotización». */
  contexto?: string;
}
const { id = 'cotizar', titulo, nivel = 2, detallado = false, encuadre = 'general', contexto } = Astro.props;
const form = FORMULARIO;
const Encabezado = nivel === 1 ? 'h1' : 'h2';
const intro = INTRO[encuadre];
const tipoPorDefecto = contexto ? 'Cotización' : '';
const descripcionInicial = contexto ? `${contexto}. ` : '';
const horarioVisible = !sitio.horario.startsWith('{{');
---
<section id={id} class="field-paper border-t border-rule" aria-labelledby={`${id}-t`}>
  <div class="contenedor py-14 lg:py-20">
    <div class="grid gap-[clamp(28px,5vw,64px)] lg:grid-cols-[1fr_1.2fr]">
      <div>
        <Encabezado id={`${id}-t`} class:list={[nivel === 1 ? 'text-[clamp(28px,3.4vw,42px)]' : 'text-[clamp(22px,2.6vw,32px)]']}>
          {titulo ?? form.titulo}
        </Encabezado>
        <p class="mt-4 max-w-[44ch] text-steel">{intro}</p>

        {detallado ? (
          <dl class="mt-8 border-t border-rule">
            {canalesContacto.map((c) => (
              <div class="flex flex-col gap-y-1 border-b border-rule py-3.5 sm:flex-row sm:items-baseline sm:gap-x-5 sm:gap-y-0">
                <dt class="meta w-[76px] shrink-0 text-[10px] text-steel">{c.rotulo}</dt>
                <dd class="text-[15.5px]">
                  {c.href
                    ? <a href={c.href} rel={c.href.startsWith('http') ? 'noopener' : undefined} class="hover:text-steel">{c.valor}</a>
                    : c.valor}
                </dd>
              </div>
            ))}
            {horarioVisible && (
              <div class="flex flex-col gap-y-1 border-b border-rule py-3.5 sm:flex-row sm:items-baseline sm:gap-x-5 sm:gap-y-0">
                <dt class="meta w-[76px] shrink-0 text-[10px] text-steel">Horario</dt>
                <dd class="text-[15.5px]">{sitio.horario}</dd>
              </div>
            )}
            <div class="flex flex-col gap-y-1 border-b border-rule py-3.5 sm:flex-row sm:items-baseline sm:gap-x-5 sm:gap-y-0">
              <dt class="meta w-[76px] shrink-0 text-[10px] text-steel">Licitaciones</dt>
              <dd class="max-w-[38ch] text-[15px] text-steel">
                Envíe el pliego a <a href={contacto.comercial.href} class="text-navy underline decoration-navy/35 underline-offset-[3px] hover:text-steel">{contacto.comercial.valor}</a> y
                lo revisamos contra lo que podemos cubrir.
              </dd>
            </div>
          </dl>
        ) : (
          <ul class="mt-8 border-t border-rule">
            <li class="border-b border-rule py-3 text-[14.5px] text-steel">
              <a href={contacto.whatsapp.href} rel="noopener" data-wa class="hover:text-navy">WhatsApp {contacto.whatsapp.valor}</a>
            </li>
            <li class="border-b border-rule py-3 text-[14.5px] text-steel">
              <a href={contacto.fijo.href} class="hover:text-navy">Fijo {contacto.fijo.valor}</a>
            </li>
            <li class="border-b border-rule py-3 text-[14.5px] text-steel">
              <a href={contacto.comercial.href} class="hover:text-navy">{contacto.comercial.valor}</a>
            </li>
          </ul>
        )}
      </div>

      <div>
        <form class="svmg-form" novalidate>
          <div class="grid gap-px border border-rule bg-rule sm:grid-cols-2">
            {form.campos.map((c) => {
              const idc = `${id}-${c.nombre}`;
              const desc = [c.ayuda ? `${idc}-ayuda` : null, `${idc}-error`].filter(Boolean).join(' ');
              return (
                <div class:list={['campo', c.ancho && 'campo--full']} role={c.tipo === 'opcion' ? 'group' : undefined} aria-labelledby={c.tipo === 'opcion' ? `${idc}-k` : undefined}>
                  {c.tipo === 'opcion' ? (
                    <span class="k" id={`${idc}-k`}>
                      {c.rotulo}<i class="req" aria-hidden="true"></i><span class="sr-only"> (obligatorio)</span>
                    </span>
                  ) : (
                    <label class="k" for={idc}>
                      {c.rotulo}{c.requerido && <i class="req" aria-hidden="true"></i>}
                      {c.requerido && <span class="sr-only"> (obligatorio)</span>}
                    </label>
                  )}

                  {c.tipo === 'area' ? (
                    <textarea id={idc} name={c.nombre} rows="3" placeholder={c.marcador}
                      aria-describedby={desc} required={c.requerido}
                      set:text={c.nombre === 'descripcion' ? descripcionInicial : ''} />
                  ) : c.tipo === 'opcion' ? (
                    <div class="opciones">
                      {c.opciones?.map((o) => (
                        <label class="opcion">
                          <input type="radio" name={c.nombre} value={o}
                            checked={o === tipoPorDefecto || undefined}
                            aria-describedby={desc} />
                          <span>{o}</span>
                        </label>
                      ))}
                    </div>
                  ) : (
                    <input id={idc} name={c.nombre}
                      type={c.tipo === 'correo' ? 'email' : c.tipo === 'telefono' ? 'tel' : 'text'}
                      placeholder={c.marcador} autocomplete={c.autocomplete}
                      aria-describedby={desc} required={c.requerido} />
                  )}

                  {c.ayuda && <p id={`${idc}-ayuda`} class="ayuda">{c.ayuda}</p>}
                  <p id={`${idc}-error`} class="error" data-error={c.nombre} hidden></p>
                </div>
              );
            })}
          </div>

          <!-- Trampa antispam: invisible para personas, irresistible para robots. -->
          <div class="trampa" aria-hidden="true">
            <label for={`${id}-${CAMPO_TRAMPA}`}>No rellene este campo</label>
            <input id={`${id}-${CAMPO_TRAMPA}`} name={CAMPO_TRAMPA} type="text" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Habeas data · Ley 1581 de 2012. La casilla nunca viene marcada. -->
          <div class="mt-5">
            <div class="flex items-start gap-3">
              <input id={`${id}-autorizacion`} name="autorizacion" type="checkbox"
                class="casilla" required aria-describedby={`${id}-autorizacion-error`} />
              <label for={`${id}-autorizacion`} class="text-[14px] leading-relaxed text-steel">
                {TEXTO_AUTORIZACION}{' '}
                <a href={URL_POLITICA} class="text-navy underline decoration-navy/35 underline-offset-[3px] hover:decoration-navy">
                  Ver la política</a>.
              </label>
            </div>
            <p id={`${id}-autorizacion-error`} class="error" data-error="autorizacion" hidden></p>
          </div>

          <p class="error error--global" data-error-global hidden role="alert"></p>

          <div class="mt-6">
            <button type="submit" class="enviar inline-flex items-center gap-2.5 border border-navy bg-navy px-5 py-3.5 text-[14.5px] font-medium text-white hover:bg-navy-deep disabled:opacity-60">
              <span class="senal" aria-hidden="true"></span>
              <span data-etiqueta>Enviar solicitud</span>
            </button>
            <p class="mt-3 text-[13px] text-steel">Servicio técnico 24/7. Cotizaciones en horario hábil.</p>
          </div>
        </form>

        <!-- Acuse: reemplaza el formulario, no lleva a otra página. -->
        <div class="acuse border border-navy bg-white p-6 lg:p-8" role="status" hidden>
          <p class="meta flex items-center gap-2.5 text-[10px] text-steel">
            <span aria-hidden="true" class="senal"></span>Solicitud enviada
          </p>
          <p class="mt-3 max-w-[46ch] text-[17px]" data-acuse></p>
          <dl class="mt-6 border-t border-rule" data-resumen></dl>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .campo { background: var(--color-white); padding: 14px 16px 15px; display: block }
  .campo--full { grid-column: 1 / -1 }
  .campo:focus-within { box-shadow: inset 3px 0 0 var(--color-signal) }
  .campo:has([aria-invalid='true']) { box-shadow: inset 3px 0 0 #b3261e }

  .k {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em;
    text-transform: uppercase; color: var(--color-steel); display: block;
  }
  .req { display: inline-block; width: 5px; height: 5px; background: var(--color-signal); margin-left: 5px }

  input:not(.casilla), textarea, select {
    width: 100%; margin-top: 8px; border: 0; padding: 0; background: transparent;
    font-family: var(--font-body); font-size: 16px; color: var(--color-navy); line-height: 1.45;
  }
  select { appearance: none; cursor: pointer }
  input[readonly] { color: var(--color-steel) }
  textarea { resize: vertical }
  input::placeholder, textarea::placeholder { color: #9fb0c4 }
  input:not(.casilla):focus, textarea:focus, select:focus { outline: 0 }

  /* Cuatro botones de selección, no un desplegable: el tipo de solicitud
     decide qué se pregunta después, así que tiene que verse entero. */
  .opciones { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px }
  .opcion {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    border: 1px solid var(--color-rule); padding: 8px 13px;
    font-size: 14.5px; color: var(--color-navy); line-height: 1.2;
    transition: border-color 120ms ease, background-color 120ms ease;
  }
  .opcion:hover { border-color: color-mix(in srgb, var(--color-navy) 35%, transparent) }
  .opcion input {
    width: 14px; height: 14px; flex: none; margin: 0;
    accent-color: var(--color-signal); cursor: pointer;
  }
  .opcion:has(input:checked) { border-color: var(--color-navy); background: var(--color-paper) }
  .opcion:has(input:focus-visible) { outline: 2px solid var(--color-navy); outline-offset: 2px }

  .casilla {
    width: 18px; height: 18px; flex: none; margin-top: 3px;
    accent-color: var(--color-signal); cursor: pointer;
  }

  .ayuda { margin-top: 6px; font-size: 12.5px; color: var(--color-steel) }
  .error { margin-top: 6px; font-size: 13px; color: #b3261e }
  .error--global { margin-top: 20px; font-size: 14.5px }

  /* Fuera de pantalla, no display:none: algunos robots ignoran lo oculto. */
  .trampa {
    position: absolute; left: -9999px; width: 1px; height: 1px;
    overflow: hidden;
  }
</style>

<script>
  import { FORMULARIO, validar, hayErrores, CAMPO_TRAMPA, DESCRIPCION_POR_TIPO } from '../../lib/formularios.ts';

  const emitir = (nombre: string, detalle: Record<string, unknown>) => {
    document.dispatchEvent(new CustomEvent(`svmg:${nombre}`, { detail: detalle }));
    (window as unknown as { dataLayer?: unknown[] }).dataLayer?.push({ event: `svmg.${nombre}`, ...detalle });
  };

  document.querySelectorAll<HTMLFormElement>('form.svmg-form').forEach((form) => {
    const def = FORMULARIO;
    const tipo = def.id;
    const seccion = form.closest('section')!;
    const acuse = seccion.querySelector<HTMLElement>('.acuse')!;
    const boton = form.querySelector<HTMLButtonElement>('.enviar')!;
    const etiqueta = boton.querySelector<HTMLElement>('[data-etiqueta]')!;
    const global = form.querySelector<HTMLElement>('[data-error-global]')!;
    const abierto = Date.now();

    const campo = (n: string) => form.querySelector<HTMLElement>(`[name="${n}"]`);
    const cajaError = (n: string) => form.querySelector<HTMLElement>(`[data-error="${n}"]`);

    /* Lo que se pide en la descripción depende del tipo de solicitud: a quien
       tiene el equipo parado no se le pregunta por el volumen de carga. */
    const descripcion = form.querySelector<HTMLTextAreaElement>('[name="descripcion"]');
    const ayudaDescripcion = form.querySelector<HTMLElement>(`#${CSS.escape(descripcion?.id ?? '')}-ayuda`);

    const ajustarDescripcion = (valor: string) => {
      const d = DESCRIPCION_POR_TIPO[valor as keyof typeof DESCRIPCION_POR_TIPO];
      if (!d || !descripcion) return;
      descripcion.placeholder = d.marcador;
      if (ayudaDescripcion) {
        ayudaDescripcion.textContent = d.ayuda ?? '';
        ayudaDescripcion.hidden = !d.ayuda;
      }
    };

    form.querySelectorAll<HTMLInputElement>('[name="tipo"]').forEach((r) => {
      r.addEventListener('change', () => {
        ajustarDescripcion(r.value);
        revisarCampo('tipo');
      });
      if (r.checked) ajustarDescripcion(r.value);
    });

    const limpiar = () => {
      global.hidden = true;
      form.querySelectorAll<HTMLElement>('[data-error]').forEach((e) => { e.hidden = true; e.textContent = ''; });
      form.querySelectorAll('[aria-invalid]').forEach((e) => e.removeAttribute('aria-invalid'));
    };

    const pintar = (errores: Record<string, string>) => {
      limpiar();
      for (const [n, msg] of Object.entries(errores)) {
        const caja = cajaError(n);
        if (caja) { caja.textContent = msg; caja.hidden = false; }
        campo(n)?.setAttribute('aria-invalid', 'true');
      }
      const primero = Object.keys(errores)[0];
      if (primero) (campo(primero) as HTMLElement | null)?.focus();
    };

    const datos = () => {
      const d = new FormData(form);
      const o: Record<string, string> = {};
      for (const c of def.campos) o[c.nombre] = String(d.get(c.nombre) ?? '');
      return o;
    };

    /* Validación en línea: cada campo se revisa al salir de él, y un campo
       que ya estaba marcado se corrige en cuanto deja de estar mal. Nunca se
       usan los avisos del navegador —de ahí el `novalidate`—. */
    function revisarCampo(nombre: string) {
      const errores = validar(def, datos());
      const msg = errores[nombre];
      const caja = cajaError(nombre);
      const control = campo(nombre);
      if (caja) { caja.textContent = msg ?? ''; caja.hidden = !msg; }
      if (control) {
        if (msg) control.setAttribute('aria-invalid', 'true');
        else control.removeAttribute('aria-invalid');
      }
    }

    for (const c of def.campos) {
      if (c.tipo === 'opcion') continue;
      const control = campo(c.nombre);
      control?.addEventListener('blur', () => revisarCampo(c.nombre));
      control?.addEventListener('input', () => {
        if (control.getAttribute('aria-invalid') === 'true') revisarCampo(c.nombre);
      });
    }

    const casilla = form.querySelector<HTMLInputElement>('[name="autorizacion"]');
    casilla?.addEventListener('change', () => {
      const caja = cajaError('autorizacion');
      if (caja && casilla.checked) { caja.hidden = true; caja.textContent = ''; }
    });

    /* Un error de envío nunca pierde lo escrito: el formulario sigue ahí, con
       sus valores, y se ofrece la vía alterna. */
    const comoTexto = () => {
      const d = datos();
      return `${def.titulo} — servimedicalgroup.com\n\n` +
        def.campos.filter((c) => d[c.nombre]?.trim())
          .map((c) => `${c.rotulo}: ${d[c.nombre]!.trim()}`).join('\n');
    };

    const falloDeEnvio = (motivo: string) => {
      const texto = encodeURIComponent(comoTexto());
      global.innerHTML =
        `No pudimos enviar la solicitud desde el sitio. Lo que escribió sigue aquí. ` +
        `Puede enviarlo por <a class="underline underline-offset-4" target="_blank" rel="noopener" ` +
        `href="https://wa.me/573192060943?text=${texto}">WhatsApp</a> o por ` +
        `<a class="underline underline-offset-4" href="mailto:comercial@servimedicalgroup.com` +
        `?subject=${encodeURIComponent(def.titulo)}&body=${texto}">correo</a>.`;
      global.hidden = false;
      emitir('formulario-error', { formulario: tipo, motivo });
    };

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      if (boton.disabled) return;

      const autorizacion = form.querySelector<HTMLInputElement>('[name="autorizacion"]')!.checked;
      const errores = validar(def, datos(), { autorizacion });
      if (hayErrores(errores)) { pintar(errores); return; }
      limpiar();

      boton.disabled = true;
      etiqueta.textContent = 'Enviando…';

      try {
        const r = await fetch('/api/formulario', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            ...datos(),
            formulario: tipo,
            autorizacion,
            abierto,
            origen: location.pathname + location.search,
            [CAMPO_TRAMPA]: String(new FormData(form).get(CAMPO_TRAMPA) ?? ''),
          }),
        });
        const cuerpo = await r.json().catch(() => ({}));

        if (r.ok && cuerpo.ok) {
          const d = datos();
          acuse.querySelector('[data-acuse]')!.textContent = def.acuse;
          acuse.querySelector('[data-resumen]')!.innerHTML = def.campos
            .filter((c) => d[c.nombre]?.trim())
            .map((c) => `<div class="flex justify-between gap-4 border-b border-rule py-2.5">` +
              `<dt class="meta text-[10px] text-steel">${c.rotulo}</dt>` +
              `<dd class="max-w-[26ch] text-right text-[14.5px]">${d[c.nombre]!.trim().replace(/</g, '&lt;')}</dd></div>`)
            .join('');
          form.hidden = true;
          acuse.hidden = false;
          acuse.focus?.();
          emitir('formulario-enviado', { formulario: tipo, origen: location.pathname });
          return;
        }

        if (r.status === 422 && cuerpo.errores) { pintar(cuerpo.errores); return; }
        falloDeEnvio(cuerpo.motivo ?? String(r.status));
      } catch {
        falloDeEnvio('sin-red');
      } finally {
        boton.disabled = false;
        etiqueta.textContent = 'Enviar solicitud';
      }
    });
  });

  /* Clic a WhatsApp como conversión. */
  document.querySelectorAll('a[href*="wa.me"]').forEach((a) => {
    a.addEventListener('click', () => emitir('whatsapp', { desde: location.pathname }));
  });
</script>
