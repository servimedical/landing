---
/* Maqueta de la etiqueta de un paquete estéril, ligada a su línea de vida.
   Códigos generados con semilla fija: mismo dibujo en cada build. */
let seed = 7;
const rnd = () => { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; };
const barras = Array.from({ length: 46 }, () => (rnd() > .62 ? 3 : 1.5));
const dm = Array.from({ length: 144 }, (_, i) => {
  const r = Math.floor(i / 12), k = i % 12;
  return (k === 0) || (r === 11) || ((r === 0 || k === 11) ? i % 2 === 0 : rnd() > .5);
});

const eventos: { t: string; e: string; s: string; w: string; k: string }[] = [
  { t:'07:12', e:'Empaque y sellado',         s:'Se genera el paquete y se imprime la etiqueta',        w:'Estación 02', k:'op' },
  { t:'08:04', e:'Carga del ciclo 0412',      s:'El paquete queda asociado a la carga y al operario',   w:'Estación 03', k:'ciclo' },
  { t:'08:38', e:'Ciclo terminado',           s:'Parámetros registrados: 134 °C · 2.1 bar · 4 min',     w:'Estación 03', k:'metodo' },
  { t:'09:05', e:'Carga liberada',            s:'Indicador biológico y químico conformes',              w:'Estación 04', k:'ciclo' },
  { t:'09:20', e:'Ingreso a estéril',         s:'Ubicación asignada y vencimiento en control',          w:'Estación 05', k:'vence' },
  { t:'11:47', e:'Entregado a quirófano 3',   s:'Queda vinculado al procedimiento y al paciente',       w:'Estación 06', k:'lote' },
];

const campos: [string, string, string][] = [
  ['lote',   'Lote',    '250825-A3'],
  ['ciclo',  'Ciclo',   '0412'],
  ['equipo', 'Equipo',  'AUTOCLAVE 02'],
  ['metodo', 'Método',  'VAPOR 134 °C'],
  ['op',     'Empacó',  'OP-114'],
  ['vence',  'Vence',   '24-11-2026'],
];
---
<div class="trace">
  <div>
    <div class="label" aria-label="Etiqueta de paquete estéril">
      <div class="label-top">
        <span class="inst">CENTRAL DE ESTERILIZACIÓN</span>
        <span class="mono tiny">CEyE-01</span>
      </div>
      <p class="label-item">Set laparoscopia<br />básico</p>
      <div class="fields">
        {campos.map(([k, rot, val]) => (
          <div class="f" data-k={k}><p class="k">{rot}</p><p class="v">{val}</p></div>
        ))}
      </div>
      <div class="codes" aria-hidden="true">
        <div class="barcode">{barras.map((w) => (<i style={`width:${w}px`}></i>))}</div>
        <div class="dm">{dm.map((on) => (<i class={on ? '' : 'off'}></i>))}</div>
      </div>
      <div class="label-foot"><span>SVMG · TRAZABILIDAD</span><span>250825A3-0412</span></div>
    </div>
    <p class="trace-caption">
      La etiqueta se imprime al cerrar el empaque y no se despega hasta que el paquete se abre en sala.
      Todo lo que sigue se registra leyéndola. Pase el cursor sobre un dato para ver dónde se usa.
    </p>
  </div>

  <ul class="tl">
    {eventos.map((ev) => (
      <li data-k={ev.k}>
        <span class="t num">{ev.t}</span>
        <span class="e">{ev.e}<small>{ev.s}</small></span>
        <span class="w">{ev.w}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .trace{ display:grid; grid-template-columns:340px 1fr; gap:clamp(28px,4vw,60px); align-items:start }

  .label{ background:#fff; color:var(--navy); padding:18px 18px 16px; position:relative }
  .label::after{ content:''; position:absolute; inset:6px; border:1px dashed rgba(38,65,107,.22); pointer-events:none }
  .label-top{ display:flex; justify-content:space-between; align-items:baseline; border-bottom:1.5px solid var(--navy); padding-bottom:9px }
  .inst{ font-family:var(--display); font-variation-settings:'wdth' 110; font-weight:700; font-size:13px }
  .tiny{ font-size:9px }
  .label-item{ font-family:var(--display); font-variation-settings:'wdth' 108; font-weight:700; font-size:19px; margin:13px 0 12px; line-height:1.1 }
  .fields{ display:grid; grid-template-columns:1fr 1fr; gap:1px; background:rgba(38,65,107,.14) }
  .f{ background:#fff; padding:8px 9px; transition:background .2s ease }
  .f.hot{ background:rgba(137,216,0,.28) }
  .f .k{ font-family:var(--meta); font-size:8.5px; letter-spacing:.12em; color:var(--steel); text-transform:uppercase }
  .f .v{ font-family:var(--meta); font-size:12.5px; font-weight:600; margin-top:3px }
  .codes{ display:flex; gap:12px; align-items:flex-end; margin-top:14px }
  .barcode{ display:flex; gap:1.5px; align-items:flex-end; height:46px; flex:1 }
  .barcode i{ background:var(--navy); height:100%; display:block }
  .dm{ width:52px; height:52px; display:grid; grid-template-columns:repeat(12,1fr); grid-template-rows:repeat(12,1fr); flex:none }
  .dm i{ background:var(--navy) }
  .dm i.off{ background:transparent }
  .label-foot{ font-family:var(--meta); font-size:9px; letter-spacing:.1em; color:var(--steel); margin-top:9px; display:flex; justify-content:space-between }
  .trace-caption{ color:rgba(255,255,255,.55); font-size:13.5px; margin-top:14px; line-height:1.5 }

  .tl li{
    display:grid; grid-template-columns:74px 1fr auto; gap:18px; align-items:baseline;
    padding:15px 0; border-top:1px solid var(--rule-d); transition:background .2s ease; color:rgba(255,255,255,.9);
  }
  .tl li:last-child{ border-bottom:1px solid var(--rule-d) }
  .tl li.hot{ background:rgba(137,216,0,.1) }
  .tl .t{ font-family:var(--meta); font-size:12px; color:rgba(255,255,255,.55); letter-spacing:.06em }
  .tl .e{ font-size:15.5px }
  .tl .e small{ display:block; color:rgba(255,255,255,.5); font-size:13px; margin-top:2px }
  .tl .w{ font-family:var(--meta); font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:rgba(255,255,255,.5); white-space:nowrap }
  .tl li.hot .w{ color:var(--signal) }

  @media (max-width:1000px){ .trace{ grid-template-columns:1fr } }
  @media (max-width:600px){
    .fields{ grid-template-columns:1fr }
    .tl li{ grid-template-columns:1fr; gap:4px }
  }
</style>

<script>
  const link = (k: string, on: boolean) => {
    document.querySelectorAll(`.f[data-k="${k}"], .tl li[data-k="${k}"]`)
      .forEach((e) => e.classList.toggle('hot', on));
  };
  document.querySelectorAll<HTMLElement>('.f[data-k], .tl li[data-k]').forEach((el) => {
    const k = el.dataset.k!;
    el.addEventListener('pointerenter', () => link(k, true));
    el.addEventListener('pointerleave', () => link(k, false));
  });
</script>
