---
/* Marca de estación para las páginas de producto. Estática y sin gráfico:
   dice dónde vive el producto dentro del proceso y enlaza al proceso. */
import { estaciones } from '../../content/ciclo.ts';

interface Props { numero: 1 | 2 | 3 | 4 | 5 | 6; secundarias?: (1 | 2 | 3 | 4 | 5 | 6)[] }
const { numero, secundarias = [] } = Astro.props;
const est = estaciones[numero - 1]!;
---
<div class="max-w-[62ch] border border-rule p-6">
  <p class="meta text-steel">Estación {String(est.numero).padStart(2, '0')} de 06</p>
  <p class="mt-3 font-display text-[21px] leading-tight font-bold [font-variation-settings:'wdth'_110]">
    {est.nombre}
  </p>
  <p class="mt-3 text-[15px] text-steel">{est.descripcion}</p>

  {secundarias.length > 0 && (
    <p class="mt-4 text-[14.5px] text-steel">
      También interviene en {secundarias.map((n, i) => (
        <>{i > 0 && ', '}<span class="text-navy">{estaciones[n - 1]!.nombre.toLowerCase()}</span></>
      ))}.
    </p>
  )}

  <a href="/#proceso" class="meta mt-5 inline-block border-t border-rule pt-4 text-[10px] text-steel hover:text-navy">
    Ver el proceso completo
  </a>
</div>
