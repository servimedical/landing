---
/* El proceso, estación por estación. Estático: sin JavaScript y sin
   interacción. Es el catálogo ordenado como lo vive la central. */
import { estaciones } from '../../content/ciclo.ts';
---
<ol class="border-t border-rule">
  {estaciones.map((e) => (
    <li class="grid gap-x-10 gap-y-5 border-b border-rule py-8 lg:grid-cols-[3rem_1.1fr_1fr]">
      <p class="meta text-[12px] text-steel">{String(e.numero).padStart(2, '0')}</p>

      <div>
        <h3 class="text-[clamp(18px,2vw,22px)]">{e.nombre}</h3>
        <p class="mt-3 max-w-[46ch] text-[15.5px] leading-relaxed text-steel">{e.descripcion}</p>
        <p class="mt-4 max-w-[44ch] text-[15px] font-medium">{e.dolor}</p>
      </div>

      <ul class="lg:border-l lg:border-rule lg:pl-10">
        {e.items.map((i) => (
          <li class="border-t border-rule first:border-t-0 lg:first:border-t">
            <a href={i.url} class="flex items-baseline justify-between gap-4 py-2.5 hover:text-steel">
              <span class="text-[15px]">{i.nombre}</span>
              <span class="meta shrink-0 text-[10px] text-steel">{i.categoria}</span>
            </a>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
