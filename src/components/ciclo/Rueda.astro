---
/* Orquestador de la rueda. Monta una isla única con `client:visible`: la
   interactividad no se descarga hasta que la sección entra en pantalla.
   Dentro, la isla decide por CSS entre el anillo (≥1000 px) y el riel.

   El contenido se inyecta por props y no se importa dentro de la isla, para
   que el texto de las seis estaciones no viaje duplicado en el JavaScript. */
import CicloIsla from './CicloIsla';
import { estaciones, reposo } from '../../content/ciclo.ts';
---
<CicloIsla estaciones={estaciones} reposo={reposo} client:visible />

<!--
  Toda la información de la rueda como texto, para quien no ve el gráfico.
  Se renderiza en el servidor y fuera de la isla: es contenido estático y no
  tiene por qué viajar dentro del paquete de JavaScript.
-->
<ol class="sr-only">
  {estaciones.map((e) => (
    <li>
      Estación {e.numero} de 6: {e.nombre}. {e.descripcion} {e.dolor}
      <ul>
        {e.items.map((i) => (
          <li><a href={i.url}>{i.nombre} — {i.categoria}</a></li>
        ))}
      </ul>
      <p>{e.trazabilidad}</p>
    </li>
  ))}
</ol>

<script>
  /* El desplazamiento del enlace profundo no puede vivir dentro de la isla:
     con `client:visible` la isla no hidrata hasta que la sección es visible,
     y la sección no es visible hasta que se desplaza. Este script corre en la
     carga y rompe esa dependencia circular. La isla sigue encargándose de
     fijar la estación y de los cambios de hash posteriores. */
  (function () {
    if (!/^#\/ciclo\/[\w-]+$/.test(location.hash)) return;

    /* El navegador restaura la posición de desplazamiento al terminar la
       carga y pisaba este salto. Con `manual` mandamos nosotros. */
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';

    var suave = !matchMedia('(prefers-reduced-motion: reduce)').matches;

    var objetivo = function () {
      var destino = document.getElementById('ciclo');
      return destino ? destino.getBoundingClientRect().top + window.scrollY : null;
    };

    var ir = function (comportamiento) {
      var y = objetivo();
      if (y === null) return;
      window.scrollTo({ top: y, behavior: comportamiento });
    };

    var cuandoCargue = function () {
      requestAnimationFrame(function () {
        ir(suave ? 'smooth' : 'auto');
        /* La carga tardía de fuentes, la hidratación de la isla y la
           restauración de posición del navegador pueden interrumpir un
           desplazamiento suave recién iniciado. Se comprueba en dos momentos
           y, si quedó a medias, se remata sin animación. */
        [600, 1500].forEach(function (ms) {
          setTimeout(function () {
            var y = objetivo();
            if (y !== null && Math.abs(window.scrollY - y) > 24) ir('auto');
          }, ms);
        });
      });
    };

    if (document.readyState === 'complete') cuandoCargue();
    else addEventListener('load', cuandoCargue, { once: true });
  })();
</script>
