---
/* Mega-menú. Lo usan «Líneas» y «Marcas»: cambian las columnas, no el
   comportamiento ni la forma. La grilla es de columnas iguales y no se
   rellenan celdas sobrantes —cierra limpia o no cierra—.

   El id entra por props porque hay dos paneles en la misma página y el guion
   de NavEscritorio los engancha por `aria-controls`. */
import BrandLogo from './marca/BrandLogo.astro';
import { marcaPorSlug } from '../datos/marcas.ts';

export type ItemMenu = { titulo: string; url: string };
export type ColumnaMenu = {
  titulo: string;
  url: string;
  descriptor: string;
  items: ItemMenu[];
  /** Slug de marca. Cuando viene, la cabecera de la columna es el logotipo y
   *  el nombre pasa a ser el texto accesible del enlace. */
  marca?: string;
};

interface Props {
  id: string;
  columnas: ColumnaMenu[];
  pie: { texto: string; url: string };
  /** Columnas de la grilla en escritorio. */
  cols: 2 | 3 | 4;
  rutaActual: string;
  /* `simple` no lista los hijos de cada columna: sólo nombre y descriptor.
     El panel entonces no necesita todo el ancho de la pantalla. */
  variante?: 'completa' | 'simple';
}
const { id, columnas, pie, cols, rutaActual, variante = 'completa' } = Astro.props;
const simple = variante === 'simple';
/* La rejilla es de columnas iguales sobre un fondo que es la propia línea
   divisoria. Si la última fila queda a medias, lo que se ve en los huecos no
   es blanco: es el fondo gris de la rejilla. Se rellenan con celdas vacías
   para que el panel cierre. */
const sobran = columnas.length % cols;
const relleno = sobran === 0 ? 0 : cols - sobran;
const activa = (url: string) => rutaActual === url || rutaActual.startsWith(url + '/');
---
<div
  id={id}
  class:list={[
    'panel invisible absolute top-(--spacing-header) z-40 border border-rule bg-white opacity-0',
    'transition-opacity duration-150 ease-out',
    simple ? 'w-[min(620px,calc(100vw-2*clamp(20px,5vw,64px)))] border-t-0' : 'inset-x-0 border-x-0',
  ]}
  data-anclado={simple || undefined}
  style={simple ? 'left: clamp(20px, 5vw, 64px)' : undefined}
>
  <div class:list={[simple ? '' : 'contenedor py-px']}>
    <ul class:list={['grid gap-px bg-rule', cols === 2 ? 'grid-cols-2' : cols === 4 ? 'grid-cols-4' : 'grid-cols-3']}>
      {columnas.map((col) => (
        <li class="bg-white">
          {simple ? (
            <a href={col.url} class:list={['group block p-5 transition-colors hover:bg-paper', activa(col.url) && 'bg-paper']}>
              <span class="font-display block text-[15.5px] leading-tight font-bold [font-variation-settings:'wdth'_110]">
                {col.titulo}
              </span>
              <span class="mt-1.5 block truncate text-[13px] text-steel">{col.descriptor}</span>
            </a>
          ) : (
            <div class="p-6">
              {col.marca ? (
                /* El logotipo reconoce la marca más rápido que el nombre: el
                   visitante que llega buscando Tuttnauer busca el rojo. */
                <a
                  href={col.url}
                  aria-label={`Ver la marca ${col.titulo}`}
                  class:list={[
                    'inline-block border-b-2 pb-1.5',
                    activa(col.url) ? 'border-signal' : 'border-transparent hover:border-rule',
                  ]}
                ><BrandLogo marca={marcaPorSlug(col.marca)!} size="xs" /></a>
              ) : (
                <a
                  href={col.url}
                  class:list={[
                    "font-display inline-block border-b-2 pb-0.5 text-[17px] leading-tight font-bold [font-variation-settings:'wdth'_110]",
                    activa(col.url) ? 'border-signal' : 'border-transparent hover:border-rule',
                  ]}
                >{col.titulo}</a>
              )}
              <p class="mt-2 text-[13px] leading-snug text-steel">{col.descriptor}</p>

              {col.items.length > 0 && (
                <ul class="mt-4 border-t border-rule">
                  {col.items.map((item) => (
                    <li class="border-b border-rule">
                      <a
                        href={item.url}
                        class:list={[
                          'block py-2.5 text-[14.5px] hover:text-steel',
                          activa(item.url) && 'border-l-2 border-signal pl-2.5',
                        ]}
                      >{item.titulo}</a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </li>
      ))}
      {Array.from({ length: relleno }, () => <li class="bg-white" aria-hidden="true"></li>)}
    </ul>

    <p class:list={['border-t border-rule', simple ? 'px-5 py-3.5' : 'py-4']}>
      <a href={pie.url} class="meta text-[10px] text-steel hover:text-navy">{pie.texto} →</a>
    </p>
  </div>
</div>

<style>
  /* El panel se oculta con `visibility`, no con el atributo `hidden`.
     `visibility: hidden` ya saca sus enlaces del orden de tabulación y del
     árbol de accesibilidad, y así el estado abierto es un solo atributo que
     la transición puede animar sin depender de requestAnimationFrame —que no
     corre cuando la pestaña está en segundo plano—. */
  .panel[data-abierto] { visibility: visible; opacity: 1; }
</style>
