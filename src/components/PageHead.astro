---
interface Props {
  eyebrow: string;
  idx?: string;
  titulo: string;
  intro?: string;
  meta?: [string, string][];
}
const { eyebrow, idx, titulo, intro, meta = [] } = Astro.props;
---
<div class="phead field-navy">
  <div class="wrap">
    <p class="mono eyebrow">{eyebrow}</p>
    <div class="row">
      {idx && <span class="big-idx mono num">{idx}</span>}
      <h1>{titulo}</h1>
    </div>
    {intro && <p class="intro">{intro}</p>}
    {meta.length > 0 && (
      <dl class="meta">
        {meta.map(([k, v]) => (<div><dt class="mono">{k}</dt><dd>{v}</dd></div>))}
      </dl>
    )}
  </div>
</div>

<style>
  .phead{ padding:clamp(44px,6vw,76px) 0 clamp(38px,5vw,60px) }
  .row{ display:flex; align-items:flex-start; gap:clamp(14px,2vw,26px); margin-top:18px }
  .big-idx{
    font-size:13px; color:var(--signal); letter-spacing:.14em;
    padding-top:.55em; flex:none;
  }
  h1{ font-size:clamp(32px,4.6vw,56px); max-width:18ch }
  .intro{ color:var(--ink-d); margin-top:22px; max-width:60ch; font-size:clamp(16px,1.3vw,18px) }
  .meta{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr));
    gap:1px; background:var(--rule-d); border:1px solid var(--rule-d);
    margin:clamp(30px,4vw,44px) 0 0;
  }
  .meta > div{ background:var(--navy); padding:16px 18px }
  dt{ font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.5) }
  dd{ margin:6px 0 0; font-size:15px; color:#fff }
</style>
