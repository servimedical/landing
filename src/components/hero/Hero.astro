---
/* Hero del home. Fondo blanco y un equipo real como protagonista.

   El gesto es que el equipo sobresale por debajo del panel gris: por eso el
   panel lleva `overflow: visible` y la imagen un margen inferior negativo. La
   sombra de piso es un gradiente en CSS, no un `drop-shadow` sobre la imagen,
   porque un drop-shadow sobre un PNG recortado delata el recorte.

   Si la imagen no está, el panel queda vacío con su etiqueta y no se rompe
   nada. `npm run hero` dice qué falta. */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { contacto } from '../../content/sitio.ts';

const CARPETA = join(process.cwd(), 'public', 'hero');
const BASE = 'autoclave-tuttnauer';

/* Se prefieren las versiones que genera `npm run hero`; si no existen, se usa
   el original tal cual, para que poner el archivo baste. */
const hay = (f: string) => existsSync(join(CARPETA, f));
const optimizadas = hay(`${BASE}-1600.webp`) && hay(`${BASE}-800.webp`);
const original = ['webp', 'png', 'jpg', 'jpeg'].map((e) => `${BASE}.${e}`).find(hay);
const imagen = optimizadas ? `/hero/${BASE}-1600.webp` : original ? `/hero/${original}` : null;

/* Las dimensiones reales evitan el salto de maquetación. Se leen del archivo
   servido, no se escriben a mano. */
let dim = { w: 1200, h: 1600 };
if (imagen) {
  try {
    const sharp = (await import('sharp')).default;
    const m = await sharp(join(CARPETA, imagen.replace('/hero/', ''))).metadata();
    if (m.width && m.height) dim = { w: m.width, h: m.height };
  } catch {
    /* sin sharp se usan las proporciones por defecto; no vale romper el build */
  }
}
---
<section class="hero" aria-labelledby="hero-h">
  <div class="contenedor hero-rejilla">
    <div class="hero-texto">
      <p class="meta text-steel">Centrales de esterilización · Colombia</p>

      <h1 id="hero-h" class="hero-titular">
        Del lavado a la <span class="block text-steel">carga liberada.</span>
      </h1>

      <p class="hero-lead">
        Importamos y respaldamos los equipos y consumibles de cada etapa de la central,
        con servicio técnico propio y repuesto en Bogotá.
      </p>

      <div class="hero-acciones">
        <a href="/contacto" class="hero-cta">
          <span aria-hidden="true" class="senal"></span>Hablar con un especialista
        </a>
        <a href="/lineas" class="hero-enlace">Ver las líneas →</a>
      </div>

      <p class="hero-soporte">
        ¿Equipo detenido? Llame al{' '}
        <a href={contacto.fijo.href} class="hero-telefono">(601) 211 4014</a>
      </p>
    </div>

    <div class="hero-figura">
      <div class="hero-panel">
        <div class="hero-caja">
          {imagen && (
            <picture>
              {optimizadas && (
                <source
                type="image/webp"
                srcset={`/hero/${BASE}-800.webp 800w, /hero/${BASE}-1600.webp 1600w`}
                  sizes="(min-width: 1024px) 45vw, 90vw"
                />
              )}
              <img
              class="hero-equipo"
              src={imagen}
              alt="Autoclave de vapor Tuttnauer con carro de carga e instrumental empacado"
              width={dim.w}
              height={dim.h}
              fetchpriority="high"
              decoding="async"
            />
            </picture>
          )}
        </div>

        <a href="/marcas/tuttnauer/vapor" class="hero-etiqueta">
          <span aria-hidden="true" class="hero-punto"></span>
          <span>
            <span class="hero-etiqueta-titulo">Autoclave de vapor · Tuttnauer</span>
            <span class="hero-etiqueta-dato">430–565 L · EN 285 →</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--color-white); }

  .hero-rejilla {
    display: grid;
    gap: 40px;
    padding-block: 32px 40px;
  }

  .hero-titular {
    margin-top: 16px;
    /* 4.6vw y no 7.4: en escritorio el titular vive en media columna,
       y a 1024 px un tamaño mayor lo parte en cuatro líneas. */
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 20px;
    max-inline-size: 52ch;
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--color-steel);
  }

  .hero-acciones {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-block-size: 48px;
    padding: 0 20px;
    border: 1px solid var(--color-navy);
    background: var(--color-navy);
    color: var(--color-white);
    font-size: 15px;
    font-weight: 500;
  }
  .hero-cta:hover { background: var(--color-navy-deep); border-color: var(--color-navy-deep); }

  .hero-enlace {
    align-self: start;
    font-size: 15px;
    padding-block: 4px;
    border-bottom: 1px solid var(--color-rule);
  }
  .hero-enlace:hover { border-bottom-color: var(--color-navy); }

  .hero-soporte {
    margin-top: 20px;
    font-size: 14.5px;
    color: var(--color-steel);
  }
  .hero-telefono {
    color: var(--color-navy);
    border-bottom: 1px solid var(--color-rule);
  }
  .hero-telefono:hover { border-bottom-color: var(--color-navy); }

  /* ---------------------------------------------------------------- panel */

  /* `hero-panel` envuelve la caja gris y la etiqueta. En móvil la etiqueta va
     debajo, en flujo; en escritorio flota sobre la caja. Por eso son hermanas
     y no está una dentro de la otra. */
  .hero-panel { position: relative; }

  .hero-caja {
    position: relative;
    display: grid;
    place-items: end center;
    background: var(--color-paper);
    border-radius: 6px;
    block-size: 300px;
    /* El equipo se sale por abajo: ese es el gesto. */
    overflow: visible;
  }

  /* Sombra de piso, no sobre la imagen: un drop-shadow sobre un recorte
     delata el recorte. */
  .hero-caja::after {
    content: '';
    position: absolute;
    inset-inline: 18%;
    bottom: -30px;
    block-size: 26px;
    background: radial-gradient(ellipse at center, rgba(38, 65, 107, 0.12), transparent 72%);
    pointer-events: none;
  }

  .hero-equipo {
    position: relative;
    z-index: 1;
    display: block;
    inline-size: auto;
    max-inline-size: 86%;
    block-size: calc(100% + 24px);
    object-fit: contain;
    object-position: bottom center;
    margin-bottom: -24px;
    animation: hero-entra 600ms ease-out both;
  }

  .hero-etiqueta {
    position: relative;
    z-index: 2;
    margin-top: 34px;
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 16px;
    background: var(--color-white);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    animation: hero-entra 600ms ease-out 200ms both;
  }
  .hero-etiqueta:hover { border-color: color-mix(in srgb, var(--color-navy) 40%, transparent); }

  .hero-punto {
    inline-size: 8px;
    block-size: 8px;
    flex: none;
    margin-top: 5px;
    background: var(--color-signal);
    border-radius: 50%;
  }
  .hero-etiqueta-titulo { display: block; font-size: 14.5px; line-height: 1.3; }
  .hero-etiqueta-dato {
    display: block;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-steel);
  }

  @keyframes hero-entra {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-equipo, .hero-etiqueta { animation: none; }
  }

  /* --------------------------------------------------------------- tablet */
  @media (width >= 48rem) {
    .hero-titular { font-size: clamp(40px, 6vw, 56px); }
    .hero-panel { max-inline-size: 420px; margin-inline: auto; }
    .hero-caja { block-size: 360px; }
    .hero-acciones { flex-direction: row; align-items: center; gap: 18px; }
    .hero-cta { padding: 0 24px; }
  }

  /* ------------------------------------------------------------ escritorio */
  @media (width >= 62.5rem) {
    .hero-rejilla {
      grid-template-columns: repeat(12, 1fr);
      align-items: center;
      column-gap: clamp(32px, 4vw, 64px);
      padding-block: 80px 64px;
    }
    .hero-texto { grid-column: 1 / 7; }
    .hero-figura { grid-column: 7 / 13; }

    .hero-panel { max-inline-size: none; margin-inline: 0; }
    .hero-caja { block-size: min(60vh, 440px); }

    .hero-equipo {
      block-size: calc(100% + 40px);
      margin-bottom: -40px;
      max-inline-size: 78%;
    }

    .hero-caja::after { bottom: -46px; }

    /* Flotante sobre el panel, abajo a la izquierda, sin tapar el equipo. */
    .hero-etiqueta {
      position: absolute;
      left: 20px;
      bottom: 20px;
      margin-top: 0;
    }
  }
</style>
