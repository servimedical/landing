---
/* Hero del home. Fondo blanco y un equipo real como protagonista.

   El gesto es que el equipo sobresale por debajo del panel gris: por eso el
   panel lleva `overflow: visible` y la imagen un margen inferior negativo. La
   sombra de piso es un gradiente en CSS, no un `drop-shadow` sobre la imagen,
   porque un drop-shadow sobre un PNG recortado delata el recorte.

   Si la imagen no está, el panel queda vacío con su etiqueta y no se rompe
   nada. `npm run hero` dice qué falta. */
import { contacto } from '../../content/sitio.ts';
import { diapositivasHero } from '../../lib/heroImagen.ts';

const slides = await diapositivasHero();
const etiqueta = slides[0]?.etiqueta;
---
<section class="hero w-full" aria-labelledby="hero-h">
  <div class="contenedor hero-rejilla">
    <div class="hero-texto">
      <p class="meta text-steel">Centrales de esterilización · Colombia</p>

      <h1 id="hero-h" class="hero-titular">
        Especialistas en <span class="block text-steel">esterilización</span>
      </h1>

      <p class="hero-lead">
        Importamos y comercializamos equipos y consumibles para esterilización,
        con servicio técnico propio.
      </p>

      <div class="hero-acciones">
        <a href="/contacto" class="hero-cta">
          <span aria-hidden="true" class="senal"></span>Hablar con un especialista
        </a>
        <a href="/lineas" class="hero-enlace">Ver las líneas →</a>
      </div>

      <p class="hero-soporte">
        ¿Equipo detenido? Llame al{' '}
        <a href={contacto.fijo.href} class="hero-telefono">(601) 211 4014</a>
      </p>
    </div>

    <div class="hero-figura">
      <div class="hero-panel">
        <div class="hero-caja" data-carrusel={slides.length > 1 ? '' : undefined}>
          {slides.map((d, i) => (
            <picture class="hero-lamina" data-activa={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
              {d.srcset && (
                <source type="image/webp" srcset={d.srcset} sizes="(min-width: 1024px) 45vw, 90vw" />
              )}
              <img
                class="hero-equipo"
                src={d.src}
                alt={d.alt}
                width={d.ancho}
                height={d.alto}
                fetchpriority={i === 0 ? 'high' : undefined}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </picture>
          ))}

          {slides.length > 1 && (
            <>
              <button type="button" class="hero-flecha hero-flecha--atras" data-ir="-1" aria-label="Equipo anterior">
                <svg viewBox="0 0 10 16" aria-hidden="true"><path d="M8 1 2 8l6 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
              <button type="button" class="hero-flecha hero-flecha--adelante" data-ir="1" aria-label="Equipo siguiente">
                <svg viewBox="0 0 10 16" aria-hidden="true"><path d="m2 1 6 7-6 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
              </button>
            </>
          )}
        </div>

        {etiqueta && (
          <a href={etiqueta.url} class="hero-etiqueta" data-etiqueta>
            <span aria-hidden="true" class="hero-punto"></span>
            <span>
              <span class="hero-etiqueta-titulo" data-etiqueta-titulo>{etiqueta.titulo}</span>
              <span class="hero-etiqueta-dato" data-etiqueta-dato>{etiqueta.dato} →</span>
            </span>
          </a>
        )}
      </div>

      {slides.length > 1 && (
        <div class="hero-puntos" role="tablist" aria-label="Equipos destacados">
          {slides.map((d, i) => (
            <button
              type="button"
              class="hero-punto-nav"
              role="tab"
              data-punto={i}
              data-activa={i === 0 ? '' : undefined}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={d.alt}
            ></button>
          ))}
        </div>
      )}
    </div>
  </div>

  {slides.length > 1 && (
    <script
      type="application/json"
      data-etiquetas
      set:html={JSON.stringify(slides.map((d) => d.etiqueta ?? null))}
      is:inline
    />
  )}
</section>

<style>
  .hero { background: var(--color-white); }

  .hero-rejilla {
    display: grid;
    gap: 40px;
    padding-block: 32px 40px;
    inline-size: 100%;
  }

  .hero-titular {
    margin-top: 16px;
    /* 4.6vw y no 7.4: en escritorio el titular vive en media columna,
       y a 1024 px un tamaño mayor lo parte en cuatro líneas. */
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero-lead {
    margin-top: 20px;
    max-inline-size: 52ch;
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.6;
    color: var(--color-steel);
  }

  .hero-acciones {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-block-size: 48px;
    padding: 0 20px;
    border: 1px solid var(--color-navy);
    background: var(--color-navy);
    color: var(--color-white);
    font-size: 15px;
    font-weight: 500;
  }
  .hero-cta:hover { background: var(--color-navy-deep); border-color: var(--color-navy-deep); }

  .hero-enlace {
    align-self: start;
    font-size: 15px;
    padding-block: 4px;
    border-bottom: 1px solid var(--color-rule);
  }
  .hero-enlace:hover { border-bottom-color: var(--color-navy); }

  .hero-soporte {
    margin-top: 20px;
    font-size: 14.5px;
    color: var(--color-steel);
  }
  .hero-telefono {
    color: var(--color-navy);
    border-bottom: 1px solid var(--color-rule);
  }
  .hero-telefono:hover { border-bottom-color: var(--color-navy); }

  /* ---------------------------------------------------------------- panel */

  /* `hero-panel` envuelve la caja gris y la etiqueta. En móvil la etiqueta va
     debajo, en flujo; en escritorio flota sobre la caja. Por eso son hermanas
     y no está una dentro de la otra. */
  /* `--sobresale` se declara en el panel para que la lean tanto la caja como
     los puntos, que son hermanos y no descendientes de la caja. */
  .hero-panel { position: relative; }
  .hero-figura { --sobresale: 24px; }

  .hero-caja {
    /* Cuánto sobresale el equipo por debajo del panel. Vive aquí porque lo
       necesitan la imagen, la sombra de piso y los puntos del carrusel: si
       sólo lo supiera la imagen, los puntos quedarían debajo del equipo. */
    position: relative;
    display: grid;
    place-items: end center;
    background: var(--color-paper);
    border-radius: 6px;
    block-size: 300px;
    /* El equipo se sale por abajo: ese es el gesto. */
    overflow: visible;
  }

  /* Sombra de piso, no sobre la imagen: un drop-shadow sobre un recorte
     delata el recorte. */
  .hero-caja::after {
    content: '';
    position: absolute;
    inset-inline: 18%;
    bottom: calc(-1 * var(--sobresale) - 6px);
    block-size: 26px;
    background: radial-gradient(ellipse at center, rgba(38, 65, 107, 0.12), transparent 72%);
    pointer-events: none;
  }

  /* Las láminas se apilan en la misma celda: el panel mide siempre lo mismo y
     el cambio de equipo no mueve nada de la página. */
  .hero-caja[data-carrusel] { display: grid; }
  .hero-caja[data-carrusel] > .hero-lamina { grid-area: 1 / 1; }

  .hero-lamina {
    display: contents;
  }
  .hero-caja[data-carrusel] > .hero-lamina {
    display: grid;
    place-items: end center;
    opacity: 0;
    transition: opacity 600ms ease;
    pointer-events: none;
  }
  .hero-caja[data-carrusel] > .hero-lamina[data-activa] { opacity: 1; }

  .hero-equipo {
    position: relative;
    z-index: 1;
    display: block;
    inline-size: auto;
    max-inline-size: 86%;
    block-size: calc(100% + var(--sobresale));
    object-fit: contain;
    object-position: bottom center;
    margin-bottom: calc(-1 * var(--sobresale));
    animation: hero-entra 600ms ease-out both;
  }

  /* Flechas: sólo en escritorio y sólo cuando hay más de un equipo. */
  .hero-flecha {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: none;
    translate: 0 -50%;
    inline-size: 36px;
    block-size: 36px;
    place-items: center;
    background: var(--color-white);
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    color: var(--color-navy);
    cursor: pointer;
  }
  .hero-flecha svg { inline-size: 9px; block-size: 14px; }
  .hero-flecha:hover { border-color: color-mix(in srgb, var(--color-navy) 40%, transparent); }
  .hero-flecha--atras { left: -18px; }
  .hero-flecha--adelante { right: -18px; }

  .hero-puntos {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    gap: 8px;
    /* Debajo de lo que el equipo sobresale, no debajo del panel. */
    margin-top: calc(var(--sobresale, 24px) + 22px);
  }
  .hero-punto-nav {
    inline-size: 7px;
    block-size: 7px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--color-mist);
    cursor: pointer;
    transition: background-color 160ms ease, scale 160ms ease;
  }
  .hero-punto-nav[data-activa] { background: var(--color-navy); scale: 1.3; }
  .hero-punto-nav:hover { background: var(--color-steel); }

  .hero-etiqueta {
    position: relative;
    z-index: 2;
    margin-top: 34px;
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 16px;
    background: var(--color-white);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    animation: hero-entra 600ms ease-out 200ms both;
  }
  .hero-etiqueta:hover { border-color: color-mix(in srgb, var(--color-navy) 40%, transparent); }

  .hero-punto {
    inline-size: 8px;
    block-size: 8px;
    flex: none;
    margin-top: 5px;
    background: var(--color-signal);
    border-radius: 50%;
  }
  .hero-etiqueta-titulo { display: block; font-size: 14.5px; line-height: 1.3; }
  .hero-etiqueta-dato {
    display: block;
    margin-top: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-steel);
  }

  @keyframes hero-entra {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-equipo, .hero-etiqueta { animation: none; }
    .hero-caja[data-carrusel] > .hero-lamina { transition: none; }
  }

  /* --------------------------------------------------------------- tablet */
  @media (width >= 48rem) {
    .hero-titular { font-size: clamp(40px, 6vw, 56px); }
    .hero-panel { max-inline-size: 420px; margin-inline: auto; }
    .hero-caja { block-size: 360px; }
    .hero-acciones { flex-direction: row; align-items: center; gap: 18px; }
    .hero-cta { padding: 0 24px; }
  }

  /* ------------------------------------------------------------ escritorio */
  @media (width >= 62.5rem) {
    .hero-rejilla {
      grid-template-columns: repeat(12, 1fr);
      align-items: center;
      column-gap: clamp(32px, 4vw, 64px);
      padding-block: 64px 56px;
    }
    .hero-texto { grid-column: 1 / 7; }
    .hero-figura { grid-column: 7 / 13; }

    .hero-panel { max-inline-size: none; margin-inline: 0; }
    .hero-caja { block-size: min(60vh, 440px); }
    .hero-figura { --sobresale: 40px; }

    .hero-equipo {
      max-inline-size: 78%;
      /* A la derecha del centro: la etiqueta vive en la esquina inferior
         izquierda y el encargo pide que no tape el equipo. */
      justify-self: end;
      margin-inline-end: 6%;
    }

    .hero-caja::after { bottom: calc(-1 * var(--sobresale) - 6px); }

    .hero-flecha { display: grid; }

    /* Flotante sobre el panel, abajo a la izquierda, sin tapar el equipo. */
    .hero-etiqueta {
      position: absolute;
      left: 20px;
      bottom: 20px;
      margin-top: 0;
    }
  }
</style>

<script>
  /* Carrusel del hero. Sin librería: son seis imágenes apiladas y un índice.

     La etiqueta no se reconstruye en el guion: viaja como JSON desde los datos
     del producto, para que no pueda contradecir a la ficha. */
  const caja = document.querySelector<HTMLElement>('.hero-caja[data-carrusel]');

  if (caja) {
    const laminas = [...caja.querySelectorAll<HTMLElement>('.hero-lamina')];
    const puntos = [...document.querySelectorAll<HTMLButtonElement>('.hero-punto-nav')];
    const flechas = [...caja.querySelectorAll<HTMLButtonElement>('.hero-flecha')];
    const panel = caja.closest<HTMLElement>('.hero-panel')!;
    const etiqueta = panel.querySelector<HTMLAnchorElement>('[data-etiqueta]');
    const titulo = panel.querySelector<HTMLElement>('[data-etiqueta-titulo]');
    const dato = panel.querySelector<HTMLElement>('[data-etiqueta-dato]');

    const crudo = document.querySelector<HTMLScriptElement>('[data-etiquetas]')?.textContent;
    const etiquetas: ({ titulo: string; dato: string; url: string } | null)[] =
      crudo ? JSON.parse(crudo) : [];

    const quieto = matchMedia('(prefers-reduced-motion: reduce)');
    const INTERVALO = 6000;

    let actual = 0;
    let reloj: number | undefined;

    const mostrar = (i: number) => {
      actual = (i + laminas.length) % laminas.length;
      laminas.forEach((l, k) => {
        l.toggleAttribute('data-activa', k === actual);
        /* Lo que no se ve no se anuncia ni recibe foco. */
        if (k === actual) l.removeAttribute('aria-hidden');
        else l.setAttribute('aria-hidden', 'true');
      });
      puntos.forEach((p, k) => {
        p.toggleAttribute('data-activa', k === actual);
        p.setAttribute('aria-selected', String(k === actual));
      });

      const e = etiquetas[actual];
      if (etiqueta && titulo && dato) {
        if (e) {
          etiqueta.hidden = false;
          etiqueta.href = e.url;
          titulo.textContent = e.titulo;
          dato.textContent = `${e.dato} →`;
        } else {
          etiqueta.hidden = true;
        }
      }
    };

    const arrancar = () => {
      if (quieto.matches) return;
      detener();
      reloj = window.setInterval(() => mostrar(actual + 1), INTERVALO);
    };
    const detener = () => { if (reloj) window.clearInterval(reloj); reloj = undefined; };

    for (const f of flechas)
      f.addEventListener('click', () => { mostrar(actual + Number(f.dataset.ir)); arrancar(); });

    puntos.forEach((p, k) =>
      p.addEventListener('click', () => { mostrar(k); arrancar(); }));

    /* Se pausa mientras el puntero o el foco estén dentro: nadie quiere que la
       imagen cambie justo cuando va a hacer clic en la etiqueta. */
    for (const ev of ['mouseenter', 'focusin'] as const) panel.addEventListener(ev, detener);
    for (const ev of ['mouseleave', 'focusout'] as const) panel.addEventListener(ev, arrancar);
    document.addEventListener('visibilitychange', () => (document.hidden ? detener() : arrancar()));
    quieto.addEventListener('change', () => (quieto.matches ? detener() : arrancar()));

    arrancar();
  }
</script>
