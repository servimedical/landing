---
/* Carta de ciclo de esterilización: curva real de vapor 134 °C
   (prevacío fraccionado → exposición → secado) con lectura en vivo. */
---
<figure class="chart">
  <figcaption class="chart-head mono">
    <span>Ciclo 134 °C · instrumental empacado</span>
    <span class="live"><i></i><span id="live-state">En proceso</span></span>
  </figcaption>

  <svg viewBox="0 0 520 262" role="img"
       aria-label="Gráfica de un ciclo de esterilización por vapor: prevacío fraccionado, exposición a 134 grados durante 4 minutos y secado.">
    <line class="grid-line" x1="46" y1="40"  x2="510" y2="40"  />
    <line class="grid-line" x1="46" y1="100" x2="510" y2="100" />
    <line class="grid-line" x1="46" y1="160" x2="510" y2="160" />
    <line class="grid-line" x1="46" y1="212" x2="510" y2="212" />
    <text class="axis-lbl" x="6"  y="44">134 °C</text>
    <text class="axis-lbl" x="6"  y="104">100 °C</text>
    <text class="axis-lbl" x="14" y="164">60 °C</text>
    <text class="axis-lbl" x="14" y="216">20 °C</text>
    <rect class="band" x="228" y="34" width="112" height="178" />
    <text class="phase" x="60"  y="242">PREVACÍO</text>
    <text class="phase" x="236" y="242">EXPOSICIÓN 4:00</text>
    <text class="phase" x="382" y="242">SECADO</text>
    <path id="curve" class="curve"
          d="M46,212 L74,168 L92,196 L118,150 L136,182 L162,128 L182,160 L206,74 L228,40 L340,40 L360,96 L392,150 L440,182 L510,196" />
    <circle id="head" class="head" r="4.5" cx="46" cy="212" />
  </svg>

  <div class="readout">
    <div><p class="val num" id="r-temp">20 °C</p><p class="key mono">Temperatura</p></div>
    <div><p class="val num" id="r-bar">0.0 bar</p><p class="key mono">Presión cámara</p></div>
    <div><p class="val num" id="r-time">00:00</p><p class="key mono">Tiempo de ciclo</p></div>
  </div>
</figure>

<style>
  .chart{ background:var(--paper); border:1px solid var(--rule); padding:22px; margin:0 }
  .chart-head{ display:flex; justify-content:space-between; gap:12px; color:var(--steel); margin-bottom:14px }
  .live{ display:flex; align-items:center; gap:7px; color:var(--navy); white-space:nowrap }
  .live i{ width:var(--atom); height:var(--atom); background:var(--signal); animation:pulse 2.2s infinite; font-style:normal }
  @keyframes pulse{ 0%,100%{ opacity:1 } 50%{ opacity:.22 } }
  svg{ display:block; width:100%; height:auto }
  .curve{ fill:none; stroke:var(--signal); stroke-width:2.5; stroke-linecap:square }
  .head{ fill:var(--navy) }
  .grid-line{ stroke:var(--mist); stroke-width:1 }
  .axis-lbl{ font-family:var(--meta); font-size:9.5px; fill:var(--steel); letter-spacing:.1em }
  .phase{ font-family:var(--meta); font-size:9.5px; fill:var(--navy); letter-spacing:.1em }
  .band{ fill:rgba(137,216,0,.13) }
  .readout{ display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid var(--rule); margin-top:16px }
  .readout div{ padding:14px 0 2px }
  .readout div + div{ border-left:1px solid var(--rule); padding-left:16px }
  .val{ font-family:var(--display); font-variation-settings:'wdth' 100; font-weight:700; font-size:26px; line-height:1 }
  .key{ color:var(--steel); margin-top:6px }
  @media (max-width:600px){
    .readout{ grid-template-columns:1fr }
    .readout div + div{ border-left:0; border-top:1px solid var(--rule); padding-left:0 }
  }
</style>

<script>
  const RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const path = document.getElementById('curve') as SVGPathElement | null;
  const head = document.getElementById('head');
  const rT = document.getElementById('r-temp');
  const rB = document.getElementById('r-bar');
  const rTime = document.getElementById('r-time');
  const state = document.getElementById('live-state');

  if (path && head && rT && rB && rTime && state) {
    const len = path.getTotalLength();
    path.style.strokeDasharray = String(len);
    path.style.strokeDashoffset = RM ? '0' : String(len);

    // y del gráfico → temperatura; temperatura → presión de vapor saturado (aprox. lineal en el tramo útil)
    const y2t = (y: number) => 20 + (212 - y) * (114 / 172);
    const t2b = (t: number) => Math.max(0, (t - 100) * (2.1 / 34));

    const set = (p: number) => {
      const pt = path.getPointAtLength(len * p);
      const temp = y2t(pt.y);
      head.setAttribute('cx', String(pt.x));
      head.setAttribute('cy', String(pt.y));
      rT.textContent = temp.toFixed(0) + ' °C';
      rB.textContent = t2b(temp).toFixed(1) + ' bar';
      const secs = Math.round(p * 34 * 60);
      rTime.textContent =
        String(Math.floor(secs / 60)).padStart(2, '0') + ':' + String(secs % 60).padStart(2, '0');
    };

    const done = () => {
      state.textContent = 'Ciclo conforme';
      rT.textContent = '134 °C'; rB.textContent = '2.1 bar'; rTime.textContent = '34:00';
    };

    if (RM) { set(1); done(); }
    else {
      const D = 3800;
      let t0: number | null = null;
      const frame = (ts: number) => {
        if (t0 === null) t0 = ts;
        const p = Math.min(1, (ts - t0) / D);
        const e = p < .5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
        path.style.strokeDashoffset = String(len * (1 - e));
        set(e);
        if (p < 1) requestAnimationFrame(frame); else done();
      };
      const svg = path.closest('svg');
      if (svg) {
        new IntersectionObserver((es, o) => {
          es.forEach((e) => { if (e.isIntersecting) { requestAnimationFrame(frame); o.disconnect(); } });
        }, { threshold: .3 }).observe(svg);
      }
    }
  }
</script>
