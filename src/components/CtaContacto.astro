---
import { contacto } from '../data/site.ts';
interface Props { titulo?: string; texto?: string }
const {
  titulo = 'Cuéntenos qué necesita esterilizar.',
  texto  = 'Con el tipo de material, el volumen por turno y el espacio disponible le proponemos el equipo y le enviamos cotización.',
} = Astro.props;
---
<section class="field-navy" id="contacto">
  <div class="wrap contact">
    <div>
      <p class="mono eyebrow">Contacto</p>
      <h2>{titulo}</h2>
      <p class="lede2">{texto}</p>
      <a class="btn btn--signal wa" href={contacto.whatsapp.href} rel="noopener">
        <span class="dot"></span>Escribir por WhatsApp
      </a>
    </div>

    <div class="cdata hair">
      <a href={contacto.fijo.href}><span class="k mono">Fijo</span><span class="v">{contacto.fijo.label}</span></a>
      <a href={contacto.whatsapp.href} rel="noopener"><span class="k mono">WhatsApp</span><span class="v">{contacto.whatsapp.label}</span></a>
      <a href={contacto.comercial.href}><span class="k mono">Comercial</span><span class="v">{contacto.comercial.label}</span></a>
      <a href={contacto.general.href}><span class="k mono">General</span><span class="v">{contacto.general.label}</span></a>
      <div><span class="k mono">Sede</span><span class="v">{contacto.sede.label}</span></div>
    </div>
  </div>
</section>

<style>
  .contact{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(28px,5vw,72px); align-items:center }
  h2{ font-size:clamp(30px,4vw,50px); margin-top:18px }
  .lede2{ color:var(--ink-d); margin-top:18px; max-width:44ch }
  .wa{ margin-top:26px }
  .cdata a, .cdata div{
    padding:17px 22px; text-decoration:none; display:flex;
    justify-content:space-between; gap:16px; align-items:baseline; transition:background .2s ease;
  }
  .cdata a:hover{ background:var(--navy-deep) }
  .k{ color:rgba(255,255,255,.5) }
  .v{ font-size:16px; font-weight:500; color:#fff }
  @media (max-width:900px){ .contact{ grid-template-columns:1fr } }
  @media (max-width:520px){
    .cdata a, .cdata div{ flex-direction:column; gap:6px }
    .v{ font-size:15px }
  }
</style>
