---
/* Botón flotante de WhatsApp, abajo a la derecha, en todas las páginas.
   Lleva al mismo número del sitio (src/content/sitio.ts), así que si cambia
   el número cambia aquí solo.

   Es la única pieza redonda del sitio, a pedido: global.css anula cualquier
   radio de esquina (`border-radius: 0 !important` en la capa base), así que
   el círculo se hace con `clip-path` y la sombra con `filter: drop-shadow`
   en el contenedor, que sí sigue la forma recortada.

   Interacción: un anillo que late suave cada pocos segundos para que se note,
   y al pasar el puntero el botón sube y aparece la etiqueta «Escríbanos por
   WhatsApp». Sin animación si el sistema pide reducir movimiento. */
import { contacto } from '../content/sitio.ts';

/* Mensaje con el que se abre el chat. La persona lo completa antes de
   enviarlo; así el equipo sabe que el contacto llegó desde la web. */
const MENSAJE = '¡Hola! Visité la página web y estoy interesado en...';
const enlace = `${contacto.whatsapp.href}?text=${encodeURIComponent(MENSAJE)}`;
---
<a
  href={enlace}
  class="wa-flotante"
  target="_blank"
  rel="noopener"
  aria-label={`Escríbanos por WhatsApp al ${contacto.whatsapp.valor}`}
>
  <span class="wa-etiqueta" aria-hidden="true">Escríbanos por WhatsApp</span>
  <span class="wa-boton">
    <span class="wa-anillo" aria-hidden="true"></span>
    <span class="wa-circulo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
        />
      </svg>
    </span>
  </span>
</a>

<style>
  .wa-flotante {
    position: fixed;
    /* Respeta la barra inferior de los iPhone. */
    right: calc(20px + env(safe-area-inset-right));
    bottom: calc(20px + env(safe-area-inset-bottom));
    /* Debajo del menú móvil y de la barra (z-50): no tapa un menú abierto. */
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 10px;
    -webkit-tap-highlight-color: transparent;
  }

  /* Contenedor del círculo: lleva la sombra, que sigue la forma recortada. */
  .wa-boton {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 58px;
    block-size: 58px;
    filter: drop-shadow(0 6px 14px rgba(27, 48, 80, 0.25));
    transition: transform 180ms ease, filter 180ms ease;
  }

  .wa-circulo {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    inline-size: 100%;
    block-size: 100%;
    clip-path: circle(50%);
    background: #25d366;
    color: #fff;
    transition: background-color 180ms ease;
  }
  .wa-circulo svg {
    inline-size: 31px;
    block-size: 31px;
    transition: transform 180ms ease;
  }

  /* Anillo que late: crece y se desvanece cada 4 s. */
  .wa-anillo {
    position: absolute;
    inset: 0;
    clip-path: circle(50%);
    background: #25d366;
    animation: wa-latido 4s ease-out infinite;
  }
  @keyframes wa-latido {
    0%   { transform: scale(1);   opacity: 0.55; }
    40%  { transform: scale(1.6); opacity: 0; }
    100% { transform: scale(1.6); opacity: 0; }
  }

  /* Etiqueta que aparece al pasar el puntero (solo con mouse). */
  .wa-etiqueta {
    padding: 9px 14px;
    background: var(--color-white);
    border: 1px solid var(--color-rule);
    color: var(--color-navy);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(27, 48, 80, 0.14) !important;
    opacity: 0;
    transform: translateX(8px);
    pointer-events: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  @media (hover: hover) {
    .wa-flotante:hover .wa-boton {
      transform: translateY(-3px) scale(1.06);
      filter: drop-shadow(0 10px 20px rgba(27, 48, 80, 0.32));
    }
    .wa-flotante:hover .wa-circulo { background: #1ebe5b; }
    .wa-flotante:hover .wa-circulo svg { transform: rotate(-8deg); }
    .wa-flotante:hover .wa-etiqueta { opacity: 1; transform: none; }
    /* Mientras el puntero está encima, el anillo se calla. */
    .wa-flotante:hover .wa-anillo { animation: none; opacity: 0; }
  }

  /* Al tocar en el celular: un pequeño hundimiento. */
  .wa-flotante:active .wa-boton { transform: scale(0.94); }

  /* Foco por teclado: anillo verde señal, alrededor del círculo. */
  .wa-flotante:focus-visible { outline: none; }
  .wa-flotante:focus-visible .wa-boton {
    filter: drop-shadow(0 0 0 #25d366) drop-shadow(0 0 3px var(--color-navy));
  }
  .wa-flotante:focus-visible .wa-etiqueta { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .wa-anillo { animation: none; opacity: 0; }
    .wa-boton, .wa-circulo, .wa-circulo svg, .wa-etiqueta { transition: none; }
  }
  @media print {
    .wa-flotante { display: none; }
  }
</style>
