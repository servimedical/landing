---
import Logo from './Logo.astro';
import { columnaFooter, inicio, politicaDatos } from '../content/navegacion.ts';
import { sitio, canalesContacto } from '../content/sitio.ts';

const productos = columnaFooter('productos');
/* Servicios junto a Nosotros, según el mapa del pie. Trazabilidad entra aquí
   por ser pilar propio y no una categoría de producto. */
const compania = [...columnaFooter('servicios'), ...columnaFooter('empresa')];
const anio = new Date().getFullYear();
---
<footer class="bg-navy-deep text-ink-dark">
  <div class="contenedor pb-8 pt-14">
    <div class="grid gap-8 border-b border-rule-dark pb-8 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1.2fr]">
      <div>
        <a href={inicio.url} aria-label={`${sitio.nombre} — ir al inicio`} class="text-white">
          <Logo sufijo="GROUP SAS" variante="oscuro" />
        </a>
        <p class="mt-4 max-w-[34ch] text-[14.5px] leading-relaxed">{sitio.lineaMarca}</p>
      </div>

      <nav aria-label="Productos">
        <h2 class="meta mb-3.5 text-white/70">Productos</h2>
        <ul>
          {productos.map((n) => (
            <li class="py-1"><a href={n.url} class="text-[14.5px] hover:text-white">{n.titulo}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Servicios y compañía">
        <h2 class="meta mb-3.5 text-white/70">Servicios y compañía</h2>
        <ul>
          {compania.map((n) => (
            <li class="py-1"><a href={n.url} class="text-[14.5px] hover:text-white">{n.titulo}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="meta mb-3.5 text-white/70">Contacto</h2>
        <ul>
          {canalesContacto.map((c) => (
            <li class="py-1 text-[14.5px]">
              {c.href
                ? <a href={c.href} rel={c.href.startsWith('http') ? 'noopener' : undefined} class="hover:text-white">{c.valor}</a>
                : <span>{c.valor}</span>}
            </li>
          ))}
          <li class="py-1 text-[14.5px]">{sitio.horario}</li>
        </ul>
      </div>
    </div>

    <div class="meta flex flex-wrap items-center gap-x-6 gap-y-3 pt-5 text-[10px] text-white/70">
      <span>© {anio} {sitio.razon}</span>
      <a href={politicaDatos.url} class="underline decoration-white/30 underline-offset-4 hover:text-white">
        {politicaDatos.titulo}
      </a>
      <span class="ml-auto">{sitio.ciudad} · {sitio.pais}</span>
    </div>

    <!--
      El sitio anterior enlazaba redes de otra marca. No se arrastran:
      {{ POR CONFIRMAR: redes sociales propias de SVMG }}
    -->
  </div>
</footer>
