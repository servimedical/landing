---
import Base from '../layouts/Base.astro';
import { inicio, enNavbar } from '../content/navegacion.ts';
import { sitio } from '../content/sitio.ts';
---
<Base
  titulo={`${sitio.nombre} — {{ POR CONFIRMAR: título de la home }}`}
  descripcion="{{ POR CONFIRMAR: descripción de la home }}"
>
  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[20ch] text-[clamp(30px,4vw,48px)]">{inicio.titulo}</h1>

    <p class="meta mt-8 inline-block border border-rule px-4 py-3 text-steel">
      {'{{ CONTENIDO PENDIENTE — paso 2 }}'}
    </p>

    <nav aria-label="Secciones del sitio" class="mt-10 max-w-xl border-t border-rule">
      <ul>
        {enNavbar.map((n) => (
          <li class="border-b border-rule">
            <a href={n.url} class="block py-3.5 text-[16px] hover:text-steel">{n.titulo}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Destino del ancla del panel de productos. La rueda del ciclo llega en el paso 2. -->
  <section id="ciclo" class="border-t border-rule bg-paper">
    <div class="contenedor py-12 lg:py-16">
      <h2 class="text-[clamp(24px,3vw,34px)]">El ciclo de esterilización</h2>
      <p class="meta mt-6 inline-block border border-rule bg-white px-4 py-3 text-steel">
        {'{{ CONTENIDO PENDIENTE — paso 2 }}'}
      </p>
    </div>
  </section>
</Base>
