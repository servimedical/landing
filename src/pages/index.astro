---
import Base from '../layouts/Base.astro';
import CartaCiclo from '../components/hero/CartaCiclo.astro';
import Rueda from '../components/ciclo/Rueda.astro';
import { home } from '../content/institucional.ts';
import { marcas } from '../content/sitio.ts';
---
<Base
  titulo="Servimedical Group — Centrales de esterilización en Colombia"
  descripcion="Equipos de esterilización, consumibles, accesorios, repuestos, mobiliario en acero y trazabilidad de paquete, con servicio técnico propio. Importación directa desde Bogotá, cobertura nacional."
>
  <!-- 1 · Hero -->
  <div class="contenedor grid items-center gap-[clamp(32px,5vw,72px)] py-12 lg:grid-cols-[1.03fr_.97fr] lg:py-16">
    <div>
      <p class="meta flex items-center gap-2.5 text-steel">
        <span aria-hidden="true" class="senal"></span>Central de esterilización · Colombia
      </p>
      <h1 class="mt-5 max-w-[15ch] text-[clamp(34px,4.6vw,58px)]">
        El ciclo completo<span class="block text-steel">con un solo responsable.</span>
      </h1>
      <p class="mt-6 max-w-[52ch] text-[clamp(16px,1.3vw,18.5px)] text-steel">
        Un paquete estéril pasa por seis estaciones antes de llegar al quirófano. Ponemos el
        equipo, el insumo, el repuesto y la trazabilidad de cada una, y respondemos cuando algo falla.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contacto" class="inline-flex items-center gap-2.5 border border-navy bg-navy px-5 py-3.5 text-[14.5px] font-medium text-white hover:bg-navy-deep">
          <span aria-hidden="true" class="senal"></span>Solicitar cotización
        </a>
        <a href="#ciclo" class="inline-flex items-center border border-rule px-5 py-3.5 text-[14.5px] hover:bg-paper">
          Recorrer el ciclo
        </a>
      </div>
    </div>
    <CartaCiclo />
  </div>

  <!-- 2 · Franja de marcas -->
  <div class="field-navy border-t border-rule">
    <div class="contenedor flex flex-wrap items-center gap-x-[clamp(18px,3vw,44px)] gap-y-3 py-6">
      <span class="meta text-[10px] text-white/70">Marcas que representamos</span>
      <ul class="ml-auto flex flex-wrap items-center gap-x-[clamp(18px,3.2vw,44px)] gap-y-2">
        {marcas.map((m) => (
          <li class="font-display text-[clamp(14px,1.4vw,18px)] font-bold text-white/92 [font-variation-settings:'wdth'_105]">
            {m.nombre}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 3 · La rueda del ciclo -->
  <section id="ciclo" class="field-paper border-t border-rule" aria-labelledby="ciclo-titulo">
    <div class="contenedor py-14 lg:py-20">
      <div class="mb-10 max-w-[62ch] lg:mb-14">
        <p class="meta flex items-center gap-2.5 text-steel">
          <span aria-hidden="true" class="senal"></span>Cómo trabajamos
        </p>
        <h2 id="ciclo-titulo" class="mt-4 text-[clamp(28px,3.6vw,44px)]">
          Seis estaciones y un hilo que las cose.
        </h2>
        <p class="mt-5 text-[17px] text-steel">
          El material sucio entra por un extremo y sale estéril por el otro. El flujo es
          unidireccional y no admite retrocesos: lo que una estación no resuelve, la siguiente
          no corrige.
        </p>
      </div>
      <Rueda />
    </div>
  </section>

  <!-- 4 · Líneas de negocio -->
  <section class="border-t border-rule" aria-labelledby="lineas">
    <div class="contenedor py-14 lg:py-20">
      <h2 id="lineas" class="sr-only">Líneas de negocio</h2>
      <div class="grid gap-px border border-rule bg-rule lg:grid-cols-2">
        {home.lineas.map((l) => (
          <a href={l.url} class="group flex flex-col bg-white p-8 transition-colors hover:bg-paper lg:p-12">
            <span class="meta text-[10.5px] text-steel">{l.etiqueta}</span>
            <span class="mt-4 font-display text-[clamp(26px,3.2vw,38px)] leading-tight font-bold [font-variation-settings:'wdth'_112]">
              {l.titulo}
            </span>
            <span class="mt-4 max-w-[44ch] flex-1 text-[16px] leading-relaxed text-steel">{l.texto}</span>
            <span class="meta mt-8 border-t border-rule pt-5 text-[10px] text-steel group-hover:text-navy">Ver la línea →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 · A quién servimos -->
  <div class="border-t border-rule">
    <div class="contenedor flex flex-wrap items-baseline gap-x-8 gap-y-3 py-7">
      <span class="meta text-[10px] text-steel">A quién servimos</span>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {home.sectores.map((s) => (<li class="text-[15px] text-steel">{s}</li>))}
      </ul>
    </div>
  </div>

  <!-- 6 · Puente a trazabilidad -->
  <section class="field-navy border-t border-rule" aria-labelledby="puente">
    <div class="contenedor flex flex-wrap items-end justify-between gap-8 py-14 lg:py-16">
      <div>
        <p class="meta flex items-center gap-2.5 text-white/70">
          <span aria-hidden="true" class="senal"></span>Trazabilidad
        </p>
        <h2 id="puente" class="mt-4 max-w-[20ch] text-[clamp(24px,3.2vw,38px)] text-white">
          {home.trazabilidad.titulo}
        </h2>
        <p class="mt-4 max-w-[54ch] text-ink-dark">{home.trazabilidad.texto}</p>
      </div>
      <a href={home.trazabilidad.url} class="inline-flex items-center gap-2.5 border border-signal bg-signal px-5 py-3.5 text-[14.5px] font-semibold text-navy-deep hover:bg-[#7cc400]">
        <span aria-hidden="true" class="senal !bg-navy-deep"></span>{home.trazabilidad.boton}
      </a>
    </div>
  </section>

  <!-- 7 · CTA de cierre -->
  <section class="border-t border-rule" aria-labelledby="cierre">
    <div class="contenedor flex flex-wrap items-end justify-between gap-8 py-14 lg:py-20">
      <div>
        <h2 id="cierre" class="max-w-[18ch] text-[clamp(26px,3.4vw,40px)]">{home.cierre.titulo}</h2>
        <p class="mt-5 max-w-[52ch] text-[17px] text-steel">{home.cierre.texto}</p>
      </div>
      <a href={home.cierre.url} class="inline-flex items-center gap-2.5 border border-navy bg-navy px-5 py-3.5 text-[14.5px] font-medium text-white hover:bg-navy-deep">
        <span aria-hidden="true" class="senal"></span>{home.cierre.boton}
      </a>
    </div>
  </section>
</Base>
