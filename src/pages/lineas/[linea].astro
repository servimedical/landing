---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Formulario from '../../components/formulario/Formulario.astro';
import TarjetaProducto from '../../components/catalogo/TarjetaProducto.astro';
import { lineas, rotuloEtapa } from '../../datos/lineas.ts';
import { productosDeLinea, lineaTienePagina } from '../../datos/productos.ts';
import { normalizar } from '../../content/navegacion.ts';
import { sitio } from '../../content/sitio.ts';
import type { Linea } from '../../datos/tipos.ts';

export function getStaticPaths() {
  /* Una línea con un solo producto no merece página: sería un paso intermedio
     vacío entre el menú y el equipo. Esas redirigen con 301 desde vercel.json,
     y la lista se deriva de estos mismos datos. */
  return lineas
    .filter((l) => lineaTienePagina(l.slug))
    .sort((a, b) => a.orden - b.orden)
    .map((l) => ({ params: { linea: l.slug }, props: { l } }));
}

const { l } = Astro.props as { l: Linea };
const rutaActual = normalizar(Astro.url.pathname);
const suyos = productosDeLinea(l.slug);

const jsonld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: l.nombre,
    description: l.seo.descripcion,
    url: new URL(rutaActual, sitio.dominio).href,
  },
];
if (l.faq?.length)
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: l.faq.map((f) => ({
      '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r },
    })),
  });
---
<Base titulo={l.seo.titulo} descripcion={l.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  {/* 1 · Mini hero */}
  <div class="contenedor py-12 lg:py-14">
    <p class="meta text-steel">{rotuloEtapa(l)}</p>
    <h1 class="mt-4 max-w-[20ch] text-[clamp(30px,4vw,48px)]">{l.nombre}</h1>
    <p class="mt-5 max-w-[56ch] text-[clamp(17px,1.4vw,19px)] leading-relaxed text-steel">{l.lead}</p>
  </div>

  {/* 2 · Cómo funciona */}
  <section class="field-paper border-t border-rule" aria-labelledby="como">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="como" class="text-[clamp(22px,2.6vw,30px)]">Cómo funciona</h2>
      <div class="mt-7 max-w-[68ch] space-y-5">
        {l.comoFunciona.map((p) => (<p class="text-[16.5px] leading-relaxed text-steel">{p}</p>))}
      </div>
      {l.empaque && (
        <p class="mt-7 flex max-w-[58ch] items-start gap-3 text-[16px] font-medium">
          <span aria-hidden="true" class="senal mt-2"></span>{l.empaque}
        </p>
      )}
    </div>
  </section>

  {/* 3 · Qué procesa y qué no */}
  <section class="border-t border-rule" aria-labelledby="alcance">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="alcance" class="text-[clamp(22px,2.6vw,30px)]">Qué procesa y qué no</h2>
      <div class="rejilla mt-8 lg:grid-cols-2">
        <div class="border-b border-r border-rule p-6 lg:p-8">
          <p class="meta text-[10px] text-steel">Compatible</p>
          <ul class="mt-5 border-t border-rule">
            {l.compatible.map((x) => (
              <li class="flex items-start gap-3 border-b border-rule py-3 text-[15.5px]">
                <span aria-hidden="true" class="senal mt-2"></span>{x}
              </li>
            ))}
          </ul>
        </div>
        <div class="border-b border-r border-rule p-6 lg:p-8">
          <p class="meta text-[10px] text-steel">No compatible</p>
          <ul class="mt-5 border-t border-rule">
            {l.noCompatible.map((x) => (
              <li class="flex items-start gap-3 border-b border-rule py-3 text-[15.5px]">
                <span aria-hidden="true" class="mt-2 block h-[7px] w-[7px] shrink-0 bg-mist"></span>{x}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* 4 · Normas de referencia */}
  <section class="border-t border-rule" aria-labelledby="normas">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="normas" class="text-[clamp(22px,2.6vw,30px)]">Normas de referencia</h2>
      <dl class="mt-8 max-w-[76ch] border-t border-rule">
        {l.normas.map((n) => (
          <div class="flex flex-col gap-1.5 border-b border-rule py-4 sm:flex-row sm:gap-8">
            <dt class="meta w-[180px] shrink-0 pt-[3px] text-[10px] text-navy">{n.norma}</dt>
            <dd class="text-[15.5px] leading-relaxed text-steel">{n.que}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* 5 · Productos disponibles */}
  <section class="field-paper border-t border-rule" aria-labelledby="productos">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="productos" class="text-[clamp(22px,2.6vw,30px)]">Productos disponibles</h2>
      <ul class="rejilla mt-8 sm:grid-cols-2 lg:grid-cols-3">
        {suyos.map((p) => (<TarjetaProducto producto={p} />))}
      </ul>
    </div>
  </section>

  {/* 6 · Preguntas frecuentes del método */}
  {l.faq?.length ? (
    <section class="border-t border-rule" aria-labelledby="faq">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="faq" class="text-[clamp(22px,2.6vw,30px)]">Preguntas frecuentes</h2>
        <dl class="mt-8 max-w-[76ch] border-t border-rule">
          {l.faq.map((f) => (
            <div class="border-b border-rule py-5">
              <dt class="text-[17px] font-medium">{f.p}</dt>
              <dd class="mt-2.5 max-w-[64ch] text-[15.5px] leading-relaxed text-steel">{f.r}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  ) : null}

  {/* 7 · CTA */}
  <Formulario contexto={l.nombre} encuadre={l.etapa === 'monitoreo' || l.etapa === 'empaque' ? 'consumible' : 'equipo'} titulo="Hable con un especialista" />

  {jsonld.map((j) => (<script type="application/ld+json" set:html={JSON.stringify(j)} is:inline />))}
</Base>
