---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Formulario from '../../components/formulario/Formulario.astro';
import { lineas, rotuloEtapa, urlLinea } from '../../datos/lineas.ts';
import { productosDeLinea, urlProducto, lineaTienePagina } from '../../datos/productos.ts';
import { marcaPorSlug } from '../../datos/marcas.ts';
import { normalizar } from '../../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);

/* Una línea con un solo producto enlaza directo a él: /lineas/<linea>
   redirige allí de todas formas, y un salto de redirección es un salto de más. */
const fichas = [...lineas]
  .sort((a, b) => a.orden - b.orden)
  .map((l) => {
    const suyos = productosDeLinea(l.slug);
    return { l, suyos, url: lineaTienePagina(l.slug) ? urlLinea(l.slug) : urlProducto(suyos[0]!) };
  });
---
<Base
  titulo="Líneas | Servimedical"
  descripcion="El método de cada etapa de la central de esterilización —lavado, empaque, esterilización, monitoreo, almacenamiento y residuos— y los equipos que lo ofrecen en Colombia."
>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-14">
    <h1 class="text-[clamp(30px,4vw,48px)]">Líneas</h1>
    <p class="mt-5 max-w-[58ch] text-[clamp(17px,1.4vw,19px)] text-steel">
      El método de cada etapa de la central, y los equipos y consumibles que lo ofrecen en Colombia.
    </p>
  </div>

  <section class="border-t border-rule">
    <div class="contenedor py-12 lg:py-16">
      <ul class="rejilla sm:grid-cols-2 lg:grid-cols-4">
        {fichas.map(({ l, suyos, url }) => (
          <li class="flex flex-col border-b border-r border-rule p-6 lg:p-7">
            <span class="meta text-[10px] text-steel">{rotuloEtapa(l)}</span>

            <a href={url} class="group mt-4">
              <span class="font-display block text-[clamp(18px,2vw,22px)] leading-tight font-bold [font-variation-settings:'wdth'_110] group-hover:text-steel">
                {l.nombre}
              </span>
            </a>
            <p class="mt-3 text-[14.5px] leading-relaxed text-steel">{l.descriptor}</p>

            <ul class="mt-5 flex flex-wrap gap-2">
              {suyos.map((p) => (
                <li>
                  <a href={urlProducto(p)} class="inline-block border border-rule px-2.5 py-1.5 text-[13px] text-steel transition-colors hover:border-navy/35 hover:text-navy">
                    {marcaPorSlug(p.marca)!.nombre}
                  </a>
                </li>
              ))}
            </ul>

            <div class="mt-auto pt-7">
              <a href={url} class="meta block border-t border-rule pt-4 text-[10px] text-steel hover:text-navy">
                {lineaTienePagina(l.slug) ? 'Ver línea →' : 'Ver producto →'}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Formulario titulo="Hable con un especialista" />
</Base>
