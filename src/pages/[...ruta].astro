---
/* Comodín para las rutas del árbol que todavía no tienen página propia.
   A medida que llega el contenido se crea el archivo en src/pages/ y la ruta
   sale de aquí: Astro da prioridad a la ruta concreta, pero excluirlas
   explícitamente evita generar páginas que nunca se sirven. */
import Pagina from '../layouts/Pagina.astro';
import { todosLosNodos, type NodoNav } from '../content/navegacion.ts';
import { sitio } from '../content/sitio.ts';

export function getStaticPaths() {
  /* Astro extrae getStaticPaths a su propio módulo: lo que necesite tiene que
     estar aquí dentro o importado, no en el resto del frontmatter. */
  const conPaginaPropia = (url: string) =>
    url === '/' || url === '/trazabilidad' || url.startsWith('/productos');

  return todosLosNodos()
    .filter((n) => !conPaginaPropia(n.url))
    .map((nodo) => ({ params: { ruta: nodo.url.slice(1) }, props: { nodo } }));
}

interface Props { nodo: NodoNav }
const { nodo } = Astro.props;
---
<Pagina
  titulo={`${nodo.titulo} — ${sitio.nombre} · {{ POR CONFIRMAR }}`}
  descripcion={`{{ POR CONFIRMAR: descripción de ${nodo.titulo} }}`}
  encabezado={nodo.titulo}
>
  <p class="meta mt-8 inline-block border border-rule px-4 py-3 text-steel">
    {'{{ CONTENIDO PENDIENTE — paso 2 }}'}
  </p>

  {nodo.hijos && (
    <nav aria-label={`Dentro de ${nodo.titulo}`} class="mt-10 max-w-xl border-t border-rule">
      <ul>
        {nodo.hijos.map((hijo) => (
          <li class="border-b border-rule">
            <a href={hijo.url} class="block py-3.5 text-[16px] hover:text-steel">{hijo.titulo}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Pagina>
