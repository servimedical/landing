---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Formulario from '../components/formulario/Formulario.astro';
import { normalizar } from '../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);
---
<Base
  titulo="Contacto — Servimedical Group, Bogotá"
  descripcion="Solicite cotización, servicio técnico o repuesto. Fijo +57 (601) 211 4014 · WhatsApp +57 319 206 0943 · Transversal 27 N.º 53C-47, Bogotá."
>
  <Migas rutaActual={rutaActual} />

  {/* El formulario es la página: una sola entrada, con todos los datos al lado. */}
  <Formulario nivel={1} detallado id="cotizar" />
</Base>
