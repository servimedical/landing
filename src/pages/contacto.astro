---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Formulario from '../components/formulario/Formulario.astro';
import { contactoPagina } from '../content/institucional.ts';
import { canalesContacto } from '../content/sitio.ts';
import { normalizar } from '../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);
---
<Base
  titulo="Contacto — Servimedical Group, Bogotá"
  descripcion="Solicite cotización, servicio técnico o envíe un pliego de licitación. Fijo +57 (601) 211 4014 · WhatsApp +57 319 206 0943 · Transversal 27 N.º 53C-47, Bogotá."
>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[20ch] text-[clamp(30px,4vw,48px)]">{contactoPagina.titulo}</h1>
    <p class="mt-6 max-w-[64ch] text-[clamp(16px,1.3vw,18px)] text-steel">{contactoPagina.bajada}</p>
  </div>

  <section class="border-t border-rule" aria-labelledby="rutas">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">Tres necesidades distintas</p>
      <h2 id="rutas" class="mt-4 max-w-[24ch] text-[clamp(24px,3vw,34px)]">Escoja por dónde entrar.</h2>

      <div class="mt-9 grid gap-px border border-rule bg-rule lg:grid-cols-3">
        {contactoPagina.rutas.map((r) => (
          <div class="flex flex-col bg-white p-6 lg:p-8">
            <h3 class="text-[clamp(18px,2vw,23px)]">{r.titulo}</h3>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-steel">{r.texto}</p>
            {r.ancla && (
              <a href={r.ancla} class="meta mt-5 border-t border-rule pt-4 text-[10px] text-steel hover:text-navy">
                Ir al formulario →
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="field-paper border-t border-rule" aria-labelledby="datos">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">Datos</p>
      <h2 id="datos" class="mt-4 max-w-[24ch] text-[clamp(24px,3vw,34px)]">Dónde estamos y por dónde llamar.</h2>

      <dl class="mt-9 grid gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-3">
        {canalesContacto.map((c, i) => (
          <div class:list={['bg-white p-6', i === canalesContacto.length - 1 && 'sm:col-span-2']}>
            <dt class="meta text-[10px] text-steel">{c.rotulo}</dt>
            <dd class="mt-2 text-[16.5px]">
              {c.href
                ? <a href={c.href} rel={c.href.startsWith('http') ? 'noopener' : undefined} class="hover:text-steel">{c.valor}</a>
                : c.valor}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Formulario fijo="Cotización general" />
</Base>
