---
/* {{ REQUIERE REVISIÓN JURÍDICA }} — ver src/content/legal.ts */
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import { politica, VIGENCIA } from '../content/legal.ts';
import { normalizar, politicaDatos } from '../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);
---
<Base
  titulo="Política de tratamiento de datos personales — Servimedical Group"
  descripcion="Cómo Servimedical Group SAS trata los datos personales recogidos en este sitio: finalidad, derechos del titular, canal para ejercerlos y término de conservación. Ley 1581 de 2012."
>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[20ch] text-[clamp(28px,3.6vw,42px)]">{politicaDatos.titulo}</h1>
    <p class="mt-6 max-w-[62ch] text-[clamp(16px,1.3vw,18px)] text-steel">
      Servimedical Group SAS trata los datos personales recogidos en este sitio conforme a la
      Ley 1581 de 2012 y al Decreto 1377 de 2013. Esta página explica qué datos se recogen,
      para qué, durante cuánto tiempo y cómo ejercer los derechos que la ley reconoce.
    </p>
    {/* La fecha de vigencia y el canal del titular están en src/content/legal.ts
        con su marcador; aquí se anuncia el estado del documento en vez de
        mostrar el marcador crudo. VIGENCIA: {VIGENCIA} */}
    <div class="mt-8 max-w-[62ch] border border-rule p-5">
      <p class="meta text-[10px] text-steel">Documento en revisión</p>
      <p class="mt-3 text-[15px] leading-relaxed text-steel">
        Esta política está redactada y pendiente de validación jurídica. La fecha de entrada
        en vigencia y el canal de atención al titular se publican al aprobarse. Mientras tanto,
        las solicitudes sobre datos personales se atienden en
        <a href="mailto:comercial@servimedicalgroup.com" class="text-navy underline decoration-rule underline-offset-4">comercial@servimedicalgroup.com</a>.
      </p>
    </div>
  </div>

  <section class="border-t border-rule">
    <div class="contenedor py-12 lg:py-16">
      <div class="max-w-[70ch]">
        {politica.map((s, i) => (
          <div class="border-t border-rule py-8 first:border-t-0 first:pt-0">
            <p class="meta text-steel">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-3 text-[clamp(20px,2.2vw,26px)]">{s.titulo}</h2>
            {s.parrafos?.map((t) => (<p class="mt-4 text-[16px] leading-relaxed text-steel">{t}</p>))}
            {s.lista && (
              <ul class="mt-5 border-t border-rule">
                {s.lista.map((x) => (
                  <li class="flex items-start gap-3 border-b border-rule py-3 text-[15.5px]">
                    <span aria-hidden="true" class="senal mt-2"></span>{x}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
