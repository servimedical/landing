---
import Base from '../../../layouts/Base.astro';
import Migas from '../../../components/Migas.astro';
import BrandLogo from '../../../components/marca/BrandLogo.astro';
import Formulario from '../../../components/formulario/Formulario.astro';
import { marcaPorSlug } from '../../../datos/marcas.ts';
import { lineaPorSlug, urlLinea } from '../../../datos/lineas.ts';
import { productos, productoPorId, urlProducto, lineaTienePagina } from '../../../datos/productos.ts';
import { normalizar } from '../../../content/navegacion.ts';
import { sitio } from '../../../content/sitio.ts';
import type { Producto } from '../../../datos/tipos.ts';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { marca: p.marca, producto: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Producto };
const m = marcaPorSlug(p.marca)!;
const l = lineaPorSlug(p.linea)!;
const rutaActual = normalizar(Astro.url.pathname);

const esEquipo = p.tipo === 'equipo';
/* La línea propia no se firma: «Papel grado esterilización y Tyvek
   Servimedical» dice dos veces lo mismo. */
const propia = m.slug === 'servimedical';
const titular = propia ? p.nombre : `${p.nombre} ${m.nombre}`;
const cotizar = `Cotizar ${titular}`;
const conFoto = Boolean(p.media?.foto);
const tituloBloque = esEquipo ? 'El equipo' : p.tipo === 'mobiliario' ? 'El mobiliario' : 'El producto';
/* La nota sobre las normas del método sólo tiene sentido si la línea tiene
   página; si no, enlazaría a este mismo producto. */
const lineaConPagina = lineaTienePagina(l.slug);

const relacionadas = p.relacionadas
  .map((r) => ({ ...r, destino: productoPorId(r.producto) }))
  .filter((r) => r.destino);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: titular,
  description: p.seo.descripcion,
  category: l.nombre,
  brand: { '@type': 'Brand', name: m.nombre },
  url: new URL(rutaActual, sitio.dominio).href,
};
---
<Base titulo={p.seo.titulo} descripcion={p.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  {/* 1 · Mini hero. Con foto va a dos columnas; sin foto, a una, y la franja
      de datos pasa a ocupar el ancho. Nunca queda un hueco ni un marcador. */}
  <div class="contenedor py-12 lg:py-14">
    <div class:list={['grid gap-x-[clamp(32px,5vw,72px)] gap-y-9', conFoto && 'lg:grid-cols-[1.05fr_.95fr] lg:items-start']}>
      <div>
        <a href={`/marcas/${m.slug}`} class="inline-block" aria-label={`Ver la marca ${m.nombre}`}>
          <BrandLogo marca={m} size="sm" />
        </a>
        <h1 class="mt-5 max-w-[20ch] text-[clamp(28px,3.6vw,44px)]">{titular}</h1>
        <p class="mt-5 max-w-[52ch] text-[clamp(16px,1.3vw,18px)] leading-relaxed text-steel">{p.lead}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#cotizar" class="inline-flex items-center gap-2.5 border border-navy bg-navy px-5 py-3.5 text-[14.5px] font-medium text-white hover:bg-navy-deep">
            <span aria-hidden="true" class="senal"></span>{cotizar}
          </a>
          {p.media?.brochure && (
            <a href={p.media.brochure.url} class="inline-flex items-center border border-rule px-5 py-3.5 text-[14.5px] hover:bg-paper">
              Descargar brochure <span class="meta ml-2 text-[10px] text-steel">PDF · {p.media.brochure.pesoKB} kB</span>
            </a>
          )}
        </div>

        {!conFoto && (
          <dl class="rejilla mt-10 sm:grid-cols-2 lg:grid-cols-4">
            {p.franja.map((s) => (
              <div class="border-b border-r border-rule p-5">
                <dt class="meta text-[10px] text-steel">{s.label}</dt>
                <dd class="mt-2 text-[16px] leading-snug">{s.valor}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      {conFoto && (
        <div>
          <img src={p.media!.foto} alt={titular} width="1600" height="1200"
               class="aspect-[4/3] w-full bg-paper object-contain" loading="eager" decoding="async" />
          <dl class="mt-px border border-rule">
            {p.franja.map((s, i) => (
              <div class:list={['flex flex-col gap-1 p-5 sm:flex-row sm:items-baseline sm:gap-5', i > 0 && 'border-t border-rule']}>
                <dt class="meta w-[142px] shrink-0 text-[10px] text-steel">{s.label}</dt>
                <dd class="text-[15.5px] leading-snug">{s.valor}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}
    </div>
  </div>

  {/* 2 · Descripción */}
  <section class="field-paper border-t border-rule" aria-labelledby="descripcion">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="descripcion" class="text-[clamp(22px,2.6vw,30px)]">{tituloBloque}</h2>
      <div class="mt-7 max-w-[68ch] space-y-5">
        {p.descripcion.map((t) => (<p class="text-[16.5px] leading-relaxed text-steel">{t}</p>))}
      </div>
    </div>
  </section>

  {/* 3 · Modelos */}
  {p.modelos && (
    <section class="border-t border-rule" aria-labelledby="modelos">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="modelos" class="text-[clamp(22px,2.6vw,30px)]">{esEquipo ? 'Modelos' : 'Presentaciones'}</h2>
        <div class="mt-8 overflow-x-auto border border-rule">
          <table class="w-full min-w-[640px] border-collapse text-[15px]">
            <thead>
              <tr>{p.modelos.encabezados.map((h) => (
                <th scope="col" class="meta border-b border-rule bg-paper px-5 py-3 text-left text-[10px] text-steel">{h}</th>
              ))}</tr>
            </thead>
            <tbody>
              {p.modelos.filas.map((fila) => (
                <tr class="border-b border-rule last:border-b-0">
                  {fila.map((c, i) => (
                    <td class:list={['px-5 py-3.5 align-top', i === 0 && 'font-medium']}>{c}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {/* 4 · Ciclos y pruebas */}
  {p.ciclos?.length ? (
    <section class="border-t border-rule" aria-labelledby="ciclos">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="ciclos" class="text-[clamp(22px,2.6vw,30px)]">Ciclos y pruebas</h2>
        <ul class="rejilla mt-8 sm:grid-cols-2 lg:grid-cols-3">
          {p.ciclos.map((c) => (
            <li class="border-b border-r border-rule p-5 text-[15.5px] leading-snug">{c}</li>
          ))}
        </ul>
      </div>
    </section>
  ) : null}

  {/* 5 · Requisitos de instalación */}
  {esEquipo && p.instalacion?.length ? (
    <section class="field-paper border-t border-rule" aria-labelledby="instalacion">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="instalacion" class="text-[clamp(22px,2.6vw,30px)]">Requisitos de instalación</h2>
        <p class="mt-4 max-w-[58ch] text-steel">Se verifican antes de despachar el equipo.</p>
        <dl class="rejilla mt-8 sm:grid-cols-2 lg:grid-cols-3">
          {p.instalacion.map((r) => (
            <div class="border-b border-r border-rule bg-white p-6">
              <dt class="meta text-[10px] text-steel">{r.label}</dt>
              <dd class="mt-2.5 text-[15.5px] leading-relaxed">{r.valor}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  ) : null}

  {/* 6 · Normas declaradas por el fabricante */}
  {p.normasDeclaradas?.length ? (
    <section class="border-t border-rule" aria-labelledby="normas">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="normas" class="text-[clamp(22px,2.6vw,30px)]">Normas declaradas por el fabricante</h2>
        <ul class="mt-7 flex flex-wrap gap-2.5">
          {p.normasDeclaradas.map((n) => (
            <li class="meta border border-rule px-3 py-2 text-[10.5px] text-navy">{n}</li>
          ))}
        </ul>
        {lineaConPagina && (
          <p class="mt-6 max-w-[58ch] text-[15px] text-steel">
            Las normas que gobiernan el método, y no este equipo en particular, están en{' '}
            <a href={urlLinea(l.slug)} class="text-navy underline decoration-navy/35 underline-offset-[3px] hover:text-steel">
              {l.nombre.toLowerCase()}</a>.
          </p>
        )}
      </div>
    </section>
  ) : null}

  {/* 7 · Qué preguntamos antes de cotizar */}
  <section class="border-t border-rule" aria-labelledby="cotizacion">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="cotizacion" class="text-[clamp(22px,2.6vw,30px)]">Qué preguntamos antes de cotizar</h2>
      <ol class="mt-8 max-w-[70ch] border-t border-rule">
        {p.preguntasCotizacion.map((q, i) => (
          <li class="flex items-baseline gap-5 border-b border-rule py-3.5">
            <span class="meta w-6 shrink-0 text-[10px] text-steel">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[15.5px]">{q}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 8 · Servicio */}
  <section class="border-t border-rule" aria-labelledby="servicio">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="servicio" class="text-[clamp(22px,2.6vw,30px)]">Servicio</h2>
      <ul class="mt-8 max-w-[62ch] border-t border-rule">
        {p.servicio.map((x) => (
          <li class="flex items-start gap-3 border-b border-rule py-3.5 text-[15.5px]">
            <span aria-hidden="true" class="senal mt-2"></span>{x}
          </li>
        ))}
      </ul>
      <a href="/servicios" class="meta mt-6 inline-block text-[10px] text-steel hover:text-navy">Ver los servicios →</a>
    </div>
  </section>

  {/* 9 · Completa el ciclo */}
  {relacionadas.length > 0 && (
    <section class="field-paper border-t border-rule" aria-labelledby="completa">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="completa" class="text-[clamp(22px,2.6vw,30px)]">Completa el ciclo</h2>
        <ul class="rejilla mt-8 sm:grid-cols-2 lg:grid-cols-3">
          {relacionadas.map((r) => (
            <li class="border-b border-r border-rule bg-white">
              <a href={urlProducto(r.destino!)} class="group flex h-full flex-col p-6 transition-colors hover:bg-paper">
                <span class="meta text-[10px] text-steel">{marcaPorSlug(r.destino!.marca)!.nombre}</span>
                <span class="font-display mt-3 text-[clamp(16px,1.7vw,19px)] leading-tight font-bold [font-variation-settings:'wdth'_110]">
                  {r.destino!.nombre}
                </span>
                <span class="mt-3 flex-1 text-[14.5px] leading-relaxed text-steel">{r.porque}</span>
                <span class="meta mt-6 border-t border-rule pt-4 text-[10px] text-steel group-hover:text-navy">Ver producto →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* 10 · Sobre el método */}
  {lineaConPagina && (
    <div class="border-t border-rule">
      <div class="contenedor flex flex-wrap items-baseline justify-between gap-4 py-7">
        <p class="max-w-[52ch] text-[16px] text-steel">
          Cómo funciona el método, qué procesa y bajo qué normas: está en la línea, no en el equipo.
        </p>
        <a href={urlLinea(l.slug)} class="meta text-[10px] text-steel hover:text-navy">Sobre {l.nombre.toLowerCase()} →</a>
      </div>
    </div>
  )}

  {/* 11 · CTA */}
  <Formulario contexto={titular} encuadre={esEquipo ? 'equipo' : 'consumible'} titulo={cotizar} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
</Base>
