---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import BrandLogo from '../../components/marca/BrandLogo.astro';
import Formulario from '../../components/formulario/Formulario.astro';
import { lineaPorSlug } from '../../datos/lineas.ts';
import { productosDeMarca, urlProducto } from '../../datos/productos.ts';
import { normalizar } from '../../content/navegacion.ts';
import { sitio } from '../../content/sitio.ts';

export async function getStaticPaths() {
  const marcas = await getCollection('marcas');
  return marcas
    .sort((a, b) => a.data.orden - b.data.orden)
    .map((e) => ({ params: { marca: e.data.slug }, props: { m: e.data } }));
}

const { m } = Astro.props;
const rutaActual = normalizar(Astro.url.pathname);
const suyos = productosDeMarca(m.slug);

/* Ficha rápida: sólo lo confirmado. Un campo vacío no se renderiza. */
const origen = [m.fabricante.razonSocial, m.fabricante.ciudad, m.fabricante.pais].filter(Boolean).join(' · ');
const ficha: [string, string][] = [
  ['Fabricante', m.fabricante.fundacion ? `${origen} · desde ${m.fabricante.fundacion}` : origen],
  ['Rol de Servimedical', m.rolSVMG === 'representante' ? 'Representante en Colombia' : 'Distribuidor autorizado'],
  ...(suyos.length ? ([['Líneas', suyos.map((p) => lineaPorSlug(p.linea)!.nombre).join(' · ')]] as [string, string][]) : []),
  ...(m.invima ? ([['Registro INVIMA', m.invima]] as [string, string][]) : []),
];

const pruebas = (m.pruebas ?? []).filter((p) => p.dato && p.fuente);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Brand',
  name: m.nombre,
  description: m.seo.descripcion,
  url: new URL(rutaActual, sitio.dominio).href,
};
---
<Base titulo={m.seo.titulo} descripcion={m.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  {/* 1 · Mini hero */}
  <div class="contenedor grid gap-x-[clamp(32px,5vw,72px)] gap-y-9 py-12 lg:grid-cols-[1.05fr_.95fr] lg:py-14">
    <div>
      {/* El logotipo hace de titular: repetir el nombre debajo era decir dos
          veces lo mismo. El h1 queda para lectores y buscadores. */}
      <BrandLogo marca={m} size="lg" />
      <h1 class="sr-only">{m.nombre}</h1>
      <p class="mt-6 max-w-[56ch] text-[clamp(17px,1.4vw,19px)] leading-relaxed text-steel">{m.lead}</p>

      <a href="#cotizar" class="mt-8 inline-flex items-center gap-2.5 border border-navy bg-navy px-5 py-3.5 text-[14.5px] font-medium text-white hover:bg-navy-deep">
        <span aria-hidden="true" class="senal"></span>Hablar con un especialista
      </a>
    </div>

    <dl class="self-start border border-rule">
      {ficha.map(([k, v], i) => (
        <div class:list={['flex flex-col gap-1 p-5 sm:flex-row sm:items-baseline sm:gap-5', i > 0 && 'border-t border-rule']}>
          <dt class="meta w-[142px] shrink-0 text-[10px] text-steel">{k}</dt>
          <dd class="text-[15.5px] leading-snug">{v}</dd>
        </div>
      ))}
    </dl>
  </div>

  {/* 2 · Quién es el fabricante */}
  <section class="field-paper border-t border-rule" aria-labelledby="quien">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="quien" class="text-[clamp(22px,2.6vw,30px)]">Quién es el fabricante</h2>
      <p class="mt-7 max-w-[68ch] text-[16.5px] leading-relaxed text-steel">{m.quienEs}</p>
    </div>
  </section>

  {/* 3 · Productos de esta marca */}
  {suyos.length > 0 && (
    <section class="border-t border-rule" aria-labelledby="productos">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="productos" class="text-[clamp(22px,2.6vw,30px)]">Productos de esta marca</h2>

        <ul class="rejilla mt-8 sm:grid-cols-2 lg:grid-cols-3">
          {suyos.map((p) => (
            <li class="flex flex-col border-b border-r border-rule">
              <a href={urlProducto(p)} class="group flex h-full flex-col p-6 transition-colors hover:bg-paper lg:p-7">
                {p.media?.foto && (
                  <img src={p.media.foto} alt={p.nombre} width="800" height="600"
                       class="mb-6 aspect-[4/3] w-full bg-paper object-contain" loading="lazy" decoding="async" />
                )}
                <span class="meta text-[10px] text-steel">{lineaPorSlug(p.linea)!.nombre}</span>
                <span class="font-display mt-3 block text-[clamp(17px,1.9vw,21px)] leading-tight font-bold [font-variation-settings:'wdth'_110]">
                  {p.nombre}
                </span>
                <span class="mt-3 text-[14.5px] leading-relaxed text-steel">{p.franja[0]!.valor}</span>
                <span class="meta mt-auto block pt-6 text-[10px] text-steel group-hover:text-navy">Ver producto →</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* 4 · Por qué esta marca — sólo con datos que tengan fuente */}
  {pruebas.length > 0 && (
    <section class="border-t border-rule" aria-labelledby="pruebas">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="pruebas" class="text-[clamp(22px,2.6vw,30px)]">Por qué esta marca</h2>
        <ul class="rejilla mt-8 sm:grid-cols-2 lg:grid-cols-3">
          {pruebas.map((p) => (
            <li class="border-b border-r border-rule p-6">
              <p class="text-[16px] leading-relaxed">{p.dato}</p>
              <p class="meta mt-4 text-[10px] text-steel">{p.fuente}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* 5 · Respaldo en Colombia */}
  {m.respaldo?.length ? (
    <section class="border-t border-rule" aria-labelledby="respaldo">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="respaldo" class="text-[clamp(22px,2.6vw,30px)]">Respaldo en Colombia</h2>
        <ul class="mt-8 max-w-[62ch] border-t border-rule">
          {m.respaldo.map((x) => (
            <li class="flex items-start gap-3 border-b border-rule py-3.5 text-[15.5px]">
              <span aria-hidden="true" class="senal mt-2"></span>{x}
            </li>
          ))}
        </ul>
        <a href="/servicios" class="meta mt-6 inline-block text-[10px] text-steel hover:text-navy">Ver los servicios →</a>
      </div>
    </section>
  ) : null}

  {/* 6 · Documentación */}
  {m.documentos?.length ? (
    <section class="border-t border-rule" aria-labelledby="docs">
      <div class="contenedor py-12 lg:py-16">
        <h2 id="docs" class="text-[clamp(22px,2.6vw,30px)]">Documentación</h2>
        <ul class="mt-8 max-w-[70ch] border-t border-rule">
          {m.documentos.map((d) => (
            <li class="border-b border-rule">
              <a href={d.url} class="flex flex-wrap items-baseline gap-x-5 gap-y-1 py-4 hover:text-steel">
                <span class="flex-1 text-[15.5px]">{d.titulo}</span>
                <span class="meta text-[10px] text-steel">{d.tipo} · {d.peso}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : null}

  <Formulario contexto={m.nombre} titulo={`Hable con un especialista en ${m.nombre}`} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
</Base>
