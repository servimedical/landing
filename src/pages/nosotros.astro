---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Formulario from '../components/formulario/Formulario.astro';
import { nosotros } from '../content/institucional.ts';
import { estaciones } from '../content/ciclo.ts';
import { normalizar } from '../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);
---
<Base
  titulo="Nosotros — Servimedical Group, especialistas en centrales de esterilización"
  descripcion="Servimedical Group SAS importa y comercializa equipamiento hospitalario en Colombia, con especialidad en esterilización. Marcas representadas, criterios de representación y servicio técnico propio."
>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[20ch] text-[clamp(30px,4vw,48px)]">{nosotros.titulo}</h1>
    <p class="mt-6 max-w-[64ch] text-[clamp(16px,1.3vw,18px)] text-steel">{nosotros.bajada}</p>
  </div>

  <section class="border-t border-rule" aria-labelledby="distinto">
    <div class="contenedor grid gap-[clamp(28px,5vw,64px)] py-12 lg:grid-cols-[1fr_1.3fr] lg:py-16">
      <div>
        <p class="meta text-steel">01 · El argumento</p>
        <h2 id="distinto" class="mt-4 max-w-[16ch] text-[clamp(24px,3vw,34px)]">{nosotros.distinto.titulo}</h2>
      </div>
      <div class="max-w-[58ch]">
        {nosotros.distinto.parrafos.map((t, i) => (
          <p class:list={['text-[17px] leading-relaxed', i === 0 ? 'font-medium' : 'mt-6 text-steel']}>{t}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="field-paper border-t border-rule" aria-labelledby="exigencias">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">02 · Criterio de representación</p>
      <h2 id="exigencias" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">{nosotros.exigencias.titulo}</h2>
      <p class="mt-5 max-w-[54ch] text-steel">{nosotros.exigencias.bajada}</p>

      <ol class="mt-9 grid gap-px border border-rule bg-rule sm:grid-cols-2">
        {nosotros.exigencias.pasos.map((p, i) => (
          <li class="bg-white p-6 lg:p-8">
            <p class="meta text-[11px] text-steel">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 text-[clamp(18px,2vw,22px)]">{p.titulo}</h3>
            <p class="mt-3 max-w-[42ch] text-[15px] leading-relaxed text-steel">{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="border-t border-rule" aria-labelledby="marcas">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">03 · Marcas</p>
      <h2 id="marcas" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">{nosotros.marcas.titulo}</h2>

      <ul class="mt-9 grid gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-4">
        {nosotros.marcas.items.map((m) => (
          <li class="bg-white p-6">
            <p class="font-display text-[19px] leading-tight font-bold [font-variation-settings:'wdth'_105]">{m.nombre}</p>
            <p class="mt-3 text-[14.5px] text-steel">{m.papel}</p>
            <a href={`/#/ciclo/0${m.estacion}`} class="meta mt-5 block border-t border-rule pt-4 text-[10px] text-steel hover:text-navy">
              Estación 0{m.estacion} · {estaciones[m.estacion - 1]!.nombre}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="field-paper border-t border-rule" aria-labelledby="cifras">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">04 · Cifras</p>
      <h2 id="cifras" class="mt-4 max-w-[24ch] text-[clamp(24px,3vw,34px)]">Lo que se puede comprobar.</h2>

      <div class="mt-9 grid gap-px border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-4">
        {nosotros.cifras.map((c) => (
          <div class="bg-white p-6">
            <p class="font-display text-[clamp(26px,3.2vw,38px)] leading-none font-bold [font-variation-settings:'wdth'_100] tabular-nums">{c.valor}</p>
            <p class="meta mt-3 text-[10px] text-steel">{c.clave}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <Formulario tipo="cotizacion" fijo="Visita técnica de evaluación" titulo={nosotros.cta.titulo} />
</Base>
