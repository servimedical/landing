---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import BrandStrip from '../components/BrandStrip.astro';
import CtaContacto from '../components/CtaContacto.astro';
import { marcas, sectores } from '../data/site.ts';
---
<Base
  titulo="Nosotros — Servimedical Group"
  descripcion="Servimedical Group SAS: empresa colombiana de importación y comercialización de equipamiento hospitalario, especializada en centrales de esterilización. Bogotá, cobertura nacional."
>
  <PageHead
    eyebrow="Nosotros"
    titulo="Una empresa colombiana de equipamiento hospitalario."
    intro="Servimedical Group SAS importa y comercializa equipamiento hospitalario en Colombia, con especialidad en esterilización. Representamos marcas internacionales, sostenemos su servicio técnico en el país y acompañamos a la institución desde el estudio previo hasta la operación diaria de la central."
    meta={[
      ['Sede', 'Bogotá, Colombia'],
      ['Cobertura', 'Nacional'],
      ['Marcas representadas', '6'],
      ['Líneas de negocio', 'Productos y servicios'],
    ]}
  />

  <section>
    <div class="wrap two">
      <div>
        <p class="mono eyebrow">Cómo trabajamos</p>
        <h2>El negocio está en volver, no en vender una vez.</h2>
      </div>
      <div>
        <p class="muted">
          Un autoclave se compra cada diez años. El papel, el indicador, el empaque y el repuesto se
          compran todos los meses, y el mantenimiento se agenda todos los semestres. Por eso montamos
          la compañía alrededor del ciclo entero y no alrededor de la venta del equipo.
        </p>
        <p class="muted mt">
          Eso obliga a algo incómodo pero sano: si el equipo que instalamos falla, el problema es
          nuestro. Tenemos técnicos propios, inventario de repuestos en Bogotá y contratos con tiempo
          de respuesta pactado porque somos nosotros los que tenemos que responder.
        </p>
        <p class="muted mt">
          La institución termina con un solo interlocutor para el equipo, el consumible, el repuesto,
          la trazabilidad y el mantenimiento — en vez de cinco proveedores señalándose entre ellos
          cuando un ciclo sale no conforme.
        </p>
      </div>
    </div>
  </section>

  <section class="field-paper">
    <div class="wrap">
      <div class="sec-head reveal">
        <p class="mono eyebrow">Marcas</p>
        <h2>Qué representamos y para qué.</h2>
        <p class="lede">Importación directa de fábrica. Cada marca cubre una parte concreta del ciclo, no un catálogo genérico.</p>
      </div>
      <ul class="marcas hair">
        {marcas.map((m, i) => (
          <li>
            <span class="mono n num">{String(i + 1).padStart(2, '0')}</span>
            <span class="nm">{m.nombre}</span>
            <span class="rol muted">{m.rol}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap two">
      <div>
        <p class="mono eyebrow">A quién atendemos</p>
        <h2>Instituciones que tienen que demostrar su proceso.</h2>
        <div class="tags who">{sectores.map((s) => (<span class="tag">{s}</span>))}</div>
      </div>
      <div class="figs hair">
        <div><p class="figure-v num">6</p><p class="figure-k mono">Marcas representadas</p></div>
        <div><p class="figure-v num">6 / 6</p><p class="figure-k mono">Estaciones del ciclo cubiertas</p></div>
        <div><p class="figure-v">Nacional</p><p class="figure-k mono">Cobertura de servicio técnico</p></div>
        <div><p class="figure-v">Bogotá</p><p class="figure-k mono">Sala de ventas y taller</p></div>
      </div>
    </div>
  </section>

  <BrandStrip />
  <CtaContacto />
</Base>

<style>
  h2{ font-size:clamp(26px,3.4vw,42px); margin-top:18px }
  .mt{ margin-top:16px }
  .marcas{ grid-template-columns:1fr }
  .marcas li{ display:grid; grid-template-columns:56px 1fr 1.2fr; gap:20px; align-items:baseline; padding:18px 22px }
  .marcas .n{ font-size:11px; color:var(--steel) }
  .marcas .nm{ font-family:var(--display); font-variation-settings:'wdth' 108; font-weight:700; font-size:clamp(18px,2vw,23px) }
  .marcas .rol{ font-size:15px }
  .who{ margin-top:26px }
  .figs{ grid-template-columns:1fr 1fr }
  .figs > div{ padding:24px }
  @media (max-width:700px){
    .marcas li{ grid-template-columns:40px 1fr; gap:10px }
    .marcas .rol{ grid-column:2 }
    .figs{ grid-template-columns:1fr }
  }
</style>
