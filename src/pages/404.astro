---
import Base from '../layouts/Base.astro';
import { navegacion } from '../content/navegacion.ts';
import { sitio } from '../content/sitio.ts';

/* Salidas de emergencia: productos, trazabilidad y contacto. */
const salidas = navegacion.filter((n) =>
  ['/productos', '/trazabilidad', '/contacto'].includes(n.url)
);
---
<Base
  titulo={`Página no encontrada — ${sitio.nombre}`}
  descripcion="La página que busca no existe o cambió de dirección. Vuelva al catálogo de productos, a trazabilidad o al contacto de Servimedical Group."
>
  <div class="contenedor py-16 lg:py-24">
    <p class="meta text-steel">Error 404</p>
    <h1 class="mt-4 max-w-[18ch] text-[clamp(30px,4vw,48px)]">
      Esta página no existe o cambió de dirección.
    </h1>

    <nav aria-label="Salidas" class="mt-10 max-w-xl border-t border-rule">
      <ul>
        {salidas.map((n) => (
          <li class="border-b border-rule">
            <a href={n.url} class="block py-3.5 text-[16px] hover:text-steel">{n.titulo}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</Base>
