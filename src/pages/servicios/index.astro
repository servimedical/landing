---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaContacto from '../../components/CtaContacto.astro';
import { servicios } from '../../data/catalogo.ts';
---
<Base
  titulo="Servicios — Servimedical Group"
  descripcion="Servicio técnico con técnicos propios entrenados por fábrica, y asesoría y diseño hospitalario para centrales de esterilización. Cobertura nacional desde Bogotá."
>
  <PageHead
    eyebrow="Línea 2 · Servicios"
    idx="2.0"
    titulo="Antes de comprar el equipo y mucho después."
    intro="El equipo es una parte del problema. El resto es cómo se diseña la central y quién responde cuando el ciclo falla un martes a las 6 a. m. Las dos puntas del proceso las cubrimos nosotros."
    meta={[
      ['Servicios', '2'],
      ['Técnicos', 'Propios, entrenados por fábrica'],
      ['Cobertura', 'Nacional'],
      ['Alcance', 'Marcas propias y de terceros'],
    ]}
  />

  <section>
    <div class="wrap">
      <div class="svc hair">
        {servicios.map((s) => (
          <article>
            <p class="mono idx num">{s.idx}</p>
            <h2>{s.nombre}</h2>
            <p class="muted resumen">{s.resumen}</p>
            <ul class="marks">{s.puntos.map((p) => (<li>{p}</li>))}</ul>
            <a class="btn btn--ghost go" href={`/servicios/${s.slug}/`}>Ver el servicio</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaContacto
    titulo="¿Equipo detenido o central por diseñar?"
    texto="Para servicio técnico indíquenos marca, modelo y la falla. Para diseño de central, los planos y el número de salas."
  />
</Base>

<style>
  .svc{ grid-template-columns:repeat(2,1fr) }
  .svc article{ padding:clamp(28px,3.4vw,46px); display:flex; flex-direction:column }
  .idx{ font-size:11px; color:var(--steel) }
  h2{ font-size:clamp(24px,2.8vw,34px); margin:10px 0 14px }
  .resumen{ font-size:16px; max-width:46ch }
  .marks{ margin:24px 0 0 }
  .go{ margin-top:28px; align-self:flex-start }
  @media (max-width:900px){ .svc{ grid-template-columns:1fr } }
</style>
