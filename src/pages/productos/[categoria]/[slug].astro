---
import ProductoLayout from '../../../layouts/Producto.astro';
import { productos, type Producto } from '../../../content/productos/index.ts';

export function getStaticPaths() {
  return productos.map((producto) => ({
    params: { categoria: producto.categoria, slug: producto.slug },
    props: { producto },
  }));
}

interface Props { producto: Producto }
const { producto } = Astro.props;
---
<ProductoLayout producto={producto} />
