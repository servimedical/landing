---
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import { categorias, indiceGeneral, porCategoria, urlProducto, repuestos } from '../../content/productos/index.ts';
import { normalizar } from '../../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);
---
<Base titulo={indiceGeneral.seo.titulo} descripcion={indiceGeneral.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[18ch] text-[clamp(30px,4vw,48px)]">{indiceGeneral.titulo}</h1>
    <p class="mt-6 max-w-[62ch] text-[clamp(16px,1.3vw,18px)] text-steel">{indiceGeneral.intro}</p>
  </div>

  <section class="border-t border-rule">
    <div class="contenedor py-12 lg:py-16">
      <ul class="grid gap-px border border-rule bg-rule">
        {categorias.map((c, i) => {
          const url = `/productos/${c.slug}`;
          const hijos = c.slug === 'repuestos' ? [] : porCategoria(c.slug as never);
          return (
            <li class="bg-white">
              <div class="grid gap-6 p-6 lg:grid-cols-[64px_1fr_1.1fr] lg:gap-10 lg:p-8">
                <p class="meta text-[11px] text-steel">1.{i + 1}</p>
                <div>
                  <h2 class="text-[clamp(20px,2.2vw,26px)]">
                    <a href={url} class="border-b-2 border-transparent hover:border-signal">{c.titulo}</a>
                  </h2>
                  <p class="mt-3 max-w-[46ch] text-[15.5px] text-steel">{c.intro}</p>
                </div>
                <ul class="border-t border-rule lg:border-t-0">
                  {hijos.map((p) => (
                    <li class="border-b border-rule lg:border-b-0 lg:border-t">
                      <a href={urlProducto(p)} class="flex items-baseline justify-between gap-4 py-3 hover:text-steel">
                        <span class="text-[15px]">{p.titulo}</span>
                        <span class="meta shrink-0 text-[10px] text-steel">Estación 0{p.estacionPrimaria}</span>
                      </a>
                    </li>
                  ))}
                  {c.slug === 'repuestos' && repuestos.grupos.map((g) => (
                    <li class="border-b border-rule lg:border-b-0 lg:border-t">
                      <a href="/productos/repuestos" class="block py-3 text-[15px] hover:text-steel">{g.titulo}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>

      <p class="mt-8 max-w-[58ch] text-[15.5px] text-steel">
        Si prefiere entrar por el proceso y no por la categoría,
        <a href="/#ciclo" class="text-navy underline decoration-rule underline-offset-4">recorra el ciclo</a>:
        cada estación lista lo que la sostiene.
      </p>
    </div>
  </section>
</Base>
