---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CtaContacto from '../../components/CtaContacto.astro';
import BrandStrip from '../../components/BrandStrip.astro';
import { productos, ciclo } from '../../data/catalogo.ts';
import { marcas } from '../../data/site.ts';

const nCat = productos.length;
const enLetras: Record<number, string> = { 3:'Tres', 4:'Cuatro', 5:'Cinco', 6:'Seis', 7:'Siete', 8:'Ocho' };
---
<Base
  titulo="Productos — Servimedical Group"
  descripcion="Equipos de esterilización, trazabilidad, accesorios, consumibles y repuestos para centrales de esterilización. Importación directa con existencias en Bogotá."
>
  <PageHead
    eyebrow="Línea 1 · Productos"
    idx="1.0"
    titulo="Todo lo que una central consume."
    intro={`${enLetras[nCat] ?? nCat} categorías que cubren el ciclo entero. La institución compra el autoclave una vez; el papel, el indicador y el repuesto los compra todos los meses. Trabajamos las dos cosas con el mismo proveedor para que el equipo nunca se detenga esperando un insumo.`}
    meta={[
      ['Categorías', String(nCat)],
      ['Marcas representadas', String(marcas.length)],
      ['Existencias', 'Bogotá, despacho nacional'],
      ['Importación', 'Directa de fábrica'],
    ]}
  />

  <section>
    <div class="wrap">
      <ul class="lista hair">
        {productos.map((c) => (
          <li>
            <a href={`/productos/${c.slug}/`}>
              <div class="l-idx"><span class="mono num">{c.idx}</span></div>
              <div class="l-body">
                <h2>{c.nombre}{c.destacada && <span class="tag tag--hi nueva">Línea nueva</span>}</h2>
                <p class="muted">{c.resumen}</p>
                <div class="tags">
                  {c.familias.map((f) => (<span class="tag">{f.nombre}</span>))}
                </div>
              </div>
              <div class="l-est">
                <span class="mono k">Estaciones</span>
                <span class="dots" aria-label={`Interviene en las estaciones ${c.estaciones.join(', ')} de 6`}>
                  {ciclo.map((_, i) => (<i class={c.estaciones.includes(i + 1) ? 'on' : ''}></i>))}
                </span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <BrandStrip />
  <CtaContacto
    titulo="¿No sabe por dónde empezar?"
    texto="Díganos qué material procesa y cuántas salas atiende. Devolvemos una propuesta con el equipo, el consumible del primer año y el plan de mantenimiento."
  />
</Base>

<style>
  .lista{ grid-template-columns:1fr }
  .lista a{
    display:grid; grid-template-columns:70px 1fr 150px; gap:clamp(16px,3vw,40px);
    padding:clamp(24px,3vw,36px); text-decoration:none; align-items:start;
    transition:background .2s ease;
  }
  .lista a:hover{ background:#fbfcfe }
  .l-idx .mono{ font-size:12px; color:var(--steel) }
  h2{ font-size:clamp(21px,2.4vw,29px); display:flex; align-items:center; gap:12px; flex-wrap:wrap }
  .nueva{ font-size:9.5px; padding:4px 8px }
  .l-body p{ margin-top:12px; max-width:56ch; font-size:15.5px }
  .l-body .tags{ margin-top:16px }
  .l-est{ display:flex; flex-direction:column; gap:10px; align-items:flex-end }
  .l-est .k{ font-size:10px; color:var(--steel) }
  .dots{ display:flex; gap:5px }
  .dots i{ width:12px; height:12px; background:var(--mist); display:block }
  .dots i.on{ background:var(--signal) }
  @media (max-width:860px){
    .lista a{ grid-template-columns:52px 1fr }
    .l-est{ grid-column:1 / -1; flex-direction:row; align-items:center; gap:14px; justify-content:flex-start }
  }
</style>
