---
/* /productos/repuestos es índice y página a la vez. No sigue la plantilla de
   seis bloques: su argumento no es qué material procesa sino qué pasa cuando
   el equipo se detiene. */
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import MiniRueda from '../../components/ciclo/MiniRueda.astro';
import { repuestos } from '../../content/productos/index.ts';
import { normalizar } from '../../content/navegacion.ts';
import { contacto, sitio } from '../../content/sitio.ts';

const rutaActual = normalizar(Astro.url.pathname);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Repuestos originales para equipos de esterilización',
  description: repuestos.seo.descripcion,
  url: new URL(rutaActual, sitio.dominio).href,
  category: 'repuestos',
  seller: { '@type': 'Organization', '@id': `${sitio.dominio}/#organizacion` },
};

const URGENCIAS = ['Equipo detenido', 'Falla intermitente', 'Reposición programada'];
---
<Base titulo={repuestos.seo.titulo} descripcion={repuestos.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[16ch] text-[clamp(30px,4vw,48px)]">{repuestos.titulo}</h1>
    <p class="mt-6 max-w-[62ch] text-[clamp(16px,1.3vw,18px)] text-steel">{repuestos.entradilla}</p>
  </div>

  <!-- Grupos de partes -->
  <section class="border-t border-rule" aria-labelledby="partes">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">Qué partes manejamos</p>
      <h2 id="partes" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">
        Tres grupos, tres modos de fallar.
      </h2>

      <div class="mt-9 grid gap-px border border-rule bg-rule lg:grid-cols-3">
        {repuestos.grupos.map((g, i) => (
          <div class="flex flex-col bg-white p-6 lg:p-8">
            <p class="meta text-[11px] text-steel">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 text-[clamp(18px,2vw,22px)]">{g.titulo}</h3>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-steel">{g.descripcion}</p>
            <ul class="mt-5 border-t border-rule">
              {g.partes.map((x) => (
                <li class="flex items-start gap-3 border-b border-rule py-2.5 text-[14.5px]">
                  <span aria-hidden="true" class="senal mt-2"></span>{x}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reposición programada -->
  <section class="field-paper border-t border-rule" aria-labelledby="reposicion">
    <div class="contenedor py-12 lg:py-16">
      <div class="grid gap-[clamp(28px,5vw,64px)] lg:grid-cols-2">
        <div>
          <p class="meta text-steel">El argumento</p>
          <h2 id="reposicion" class="mt-4 max-w-[20ch] text-[clamp(24px,3vw,34px)]">
            {repuestos.reposicion.titulo}
          </h2>
          <p class="mt-5 max-w-[46ch] text-[15.5px] text-steel">{repuestos.reposicion.texto}</p>
        </div>
        <ul class="border-t border-rule">
          {repuestos.reposicion.puntos.map((x) => (
            <li class="flex items-start gap-3 border-b border-rule py-3.5 text-[15.5px]">
              <span aria-hidden="true" class="senal mt-2"></span>{x}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Mini-rueda transversal -->
  <section class="border-t border-rule" aria-labelledby="donde">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">En qué estación del ciclo vive</p>
      <h2 id="donde" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">
        En todas, que es el problema.
      </h2>
      <div class="mt-9 max-w-[560px]">
        <MiniRueda
          transversal
          nota="Una parte de desgaste puede detener el lavado, el sellado, el ciclo o la impresión del registro. Por eso los repuestos no se piden por estación, sino por equipo."
        />
      </div>
    </div>
  </section>

  <!-- Formulario específico de repuesto -->
  <section id="pedir" class="field-navy border-t border-rule" aria-labelledby="pedir-titulo">
    <div class="contenedor py-14 lg:py-20">
      <div class="grid gap-[clamp(28px,5vw,64px)] lg:grid-cols-[1fr_1.15fr]">
        <div>
          <p class="meta flex items-center gap-2.5 text-white/70">
            <span aria-hidden="true" class="senal"></span>Pedido de repuesto
          </p>
          <h2 id="pedir-titulo" class="mt-4 text-[clamp(24px,3vw,36px)] text-white">
            Díganos qué parte y de qué equipo.
          </h2>
          <p class="mt-5 max-w-[44ch] text-ink-dark">
            La placa del equipo trae marca, modelo y número de serie. Con esos tres
            datos identificamos la parte sin ir a la sede.
          </p>
          <p class="mt-5 max-w-[44ch] text-[14.5px] text-white/70">
            Si tiene una fotografía de la parte o de la placa, adjúntela en el chat
            después de enviar: es lo que más acelera la identificación.
          </p>
          <ul class="mt-8 border-t border-rule-dark">
            <li class="border-b border-rule-dark py-3 text-[14.5px] text-ink-dark">
              <a href={contacto.whatsapp.href} rel="noopener" class="hover:text-white">WhatsApp {contacto.whatsapp.valor}</a>
            </li>
            <li class="border-b border-rule-dark py-3 text-[14.5px] text-ink-dark">
              <a href={contacto.fijo.href} class="hover:text-white">Fijo {contacto.fijo.valor}</a>
            </li>
          </ul>
        </div>

        <form class="cot" data-producto="Repuesto" novalidate>
          <div class="grid gap-px border border-rule-dark bg-rule-dark sm:grid-cols-2">
            <label class="campo campo--full">
              <span class="k">Qué necesita</span>
              <input name="necesita" value="Repuesto" readonly />
            </label>
            <label class="campo">
              <span class="k">Marca del equipo <i class="req" aria-hidden="true"></i></span>
              <input name="marca" required placeholder="Tuttnauer" />
            </label>
            <label class="campo">
              <span class="k">Modelo <i class="req" aria-hidden="true"></i></span>
              <input name="modelo" required placeholder="El que figura en la placa" />
            </label>
            <label class="campo">
              <span class="k">Número de serie</span>
              <input name="serie" placeholder="El que figura en la placa" />
            </label>
            <label class="campo">
              <span class="k">Urgencia</span>
              <select name="urgencia">
                <option value="">Seleccione…</option>
                {URGENCIAS.map((u) => (<option value={u}>{u}</option>))}
              </select>
            </label>
            <label class="campo campo--full">
              <span class="k">Descripción de la parte <i class="req" aria-hidden="true"></i></span>
              <textarea name="parte" rows="3" required
                placeholder="Empaquetadura de puerta, válvula solenoide de entrada de vapor, sensor de cámara…"></textarea>
            </label>
            <label class="campo campo--full">
              <span class="k">Institución y contacto</span>
              <input name="contacto" placeholder="Clínica San Rafael · ana@clinica.com" />
            </label>
          </div>

          <p class="err meta" hidden role="alert"></p>

          <div class="mt-6 flex flex-wrap gap-3">
            <button type="submit" class="inline-flex items-center gap-2.5 border border-signal bg-signal px-5 py-3.5 text-[14.5px] font-semibold text-navy-deep">
              <span class="senal !bg-navy-deep" aria-hidden="true"></span>Enviar por WhatsApp
            </button>
            <button type="button" class="por-correo inline-flex items-center border border-rule-dark px-5 py-3.5 text-[14.5px] text-white hover:bg-white/10">
              Enviar por correo
            </button>
          </div>
          <p class="meta mt-5 max-w-[50ch] text-[10px] leading-relaxed text-white/70 normal-case tracking-[.06em]">
            Nada se guarda ni se envía a terceros desde esta página.
          </p>
        </form>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
</Base>

<style>
  .campo { background: var(--color-navy); padding: 14px 16px 15px; display: block }
  .campo--full { grid-column: 1 / -1 }
  .k {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: .14em;
    text-transform: uppercase; color: rgba(255,255,255,.72); display: block;
  }
  .req { display: inline-block; width: 5px; height: 5px; background: var(--color-signal); margin-left: 5px }
  input, textarea, select {
    width: 100%; margin-top: 8px; border: 0; padding: 0; background: transparent;
    font-family: var(--font-body); font-size: 16px; color: #fff; line-height: 1.45;
  }
  select { appearance: none; cursor: pointer }
  select option { color: var(--color-navy) }
  input[readonly] { color: rgba(255,255,255,.78) }
  textarea { resize: vertical }
  input::placeholder, textarea::placeholder { color: rgba(255,255,255,.5) }
  input:focus, textarea:focus, select:focus { outline: 0 }
  .campo:focus-within { box-shadow: inset 3px 0 0 var(--color-signal) }
  .err { margin-top: 16px; color: #ffb4a8; font-size: 11px }
</style>

<script>
  /* Rótulos propios del pedido de repuesto: la plantilla general usa otros. */
  const ROTULOS: Record<string, string> = {
    necesita: 'Necesita', marca: 'Marca', modelo: 'Modelo', serie: 'Serie',
    urgencia: 'Urgencia', parte: 'Parte', contacto: 'Institución y contacto',
  };

  const form = document.querySelector<HTMLFormElement>('form.cot');
  const err = form?.querySelector<HTMLElement>('.err');

  if (form && err) {
    const mensaje = () => {
      const d = new FormData(form);
      const filas = Object.entries(ROTULOS)
        .map(([k, r]) => [r, String(d.get(k) ?? '').trim()] as const)
        .filter(([, v]) => v !== '')
        .map(([r, v]) => `${r}: ${v}`);
      return `Pedido de repuesto — servimedicalgroup.com\n\n${filas.join('\n')}` +
        `\n\n(Si tiene fotografía de la parte o de la placa, adjúntela aquí.)`;
    };

    const valida = () => {
      if (form.checkValidity()) { err.hidden = true; return true; }
      const faltan = [...form.elements]
        .filter((e): e is HTMLInputElement => 'checkValidity' in e && 'name' in e)
        .filter((e) => !e.checkValidity())
        .map((e) => ROTULOS[e.name] ?? e.name);
      err.textContent = `Falta completar: ${faltan.join(', ')}.`;
      err.hidden = false;
      form.reportValidity();
      return false;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (valida()) window.open(`https://wa.me/573192060943?text=${encodeURIComponent(mensaje())}`, '_blank', 'noopener');
    });
    form.querySelector('.por-correo')?.addEventListener('click', () => {
      if (!valida()) return;
      location.href = `mailto:comercial@servimedicalgroup.com` +
        `?subject=${encodeURIComponent('Pedido de repuesto')}&body=${encodeURIComponent(mensaje())}`;
    });
  }
</script>
