---
/* /productos/repuestos es índice y página a la vez. No sigue la plantilla de
   seis bloques: su argumento no es qué material procesa sino qué pasa cuando
   el equipo se detiene. */
import Base from '../../layouts/Base.astro';
import Migas from '../../components/Migas.astro';
import Formulario from '../../components/formulario/Formulario.astro';
import { repuestos } from '../../content/productos/index.ts';
import { normalizar } from '../../content/navegacion.ts';
import { sitio } from '../../content/sitio.ts';

const rutaActual = normalizar(Astro.url.pathname);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Repuestos originales para equipos de esterilización',
  description: repuestos.seo.descripcion,
  url: new URL(rutaActual, sitio.dominio).href,
  category: 'repuestos',
  seller: { '@type': 'Organization', '@id': `${sitio.dominio}/#organizacion` },
};

---
<Base titulo={repuestos.seo.titulo} descripcion={repuestos.seo.descripcion}>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[16ch] text-[clamp(30px,4vw,48px)]">{repuestos.titulo}</h1>
    <p class="mt-6 max-w-[62ch] text-[clamp(16px,1.3vw,18px)] text-steel">{repuestos.entradilla}</p>
  </div>

  <!-- Grupos de partes -->
  <section class="border-t border-rule" aria-labelledby="partes">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">Qué partes manejamos</p>
      <h2 id="partes" class="mt-4 max-w-[26ch] text-[clamp(24px,3vw,34px)]">
        Tres grupos, tres modos de fallar.
      </h2>

      <div class="mt-9 grid gap-px border border-rule bg-rule lg:grid-cols-3">
        {repuestos.grupos.map((g, i) => (
          <div class="flex flex-col bg-white p-6 lg:p-8">
            <p class="meta text-[11px] text-steel">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-3 text-[clamp(18px,2vw,22px)]">{g.titulo}</h3>
            <p class="mt-3 flex-1 text-[15px] leading-relaxed text-steel">{g.descripcion}</p>
            <ul class="mt-5 border-t border-rule">
              {g.partes.map((x) => (
                <li class="flex items-start gap-3 border-b border-rule py-2.5 text-[14.5px]">
                  <span aria-hidden="true" class="senal mt-2"></span>{x}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reposición programada -->
  <section class="field-paper border-t border-rule" aria-labelledby="reposicion">
    <div class="contenedor py-12 lg:py-16">
      <div class="grid gap-[clamp(28px,5vw,64px)] lg:grid-cols-2">
        <div>
          <p class="meta text-steel">El argumento</p>
          <h2 id="reposicion" class="mt-4 max-w-[20ch] text-[clamp(24px,3vw,34px)]">
            {repuestos.reposicion.titulo}
          </h2>
          <p class="mt-5 max-w-[46ch] text-[15.5px] text-steel">{repuestos.reposicion.texto}</p>
        </div>
        <ul class="border-t border-rule">
          {repuestos.reposicion.puntos.map((x) => (
            <li class="flex items-start gap-3 border-b border-rule py-3.5 text-[15.5px]">
              <span aria-hidden="true" class="senal mt-2"></span>{x}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-rule" aria-labelledby="donde">
    <div class="contenedor py-12 lg:py-16">
      <h2 id="donde" class="max-w-[30ch] text-[clamp(22px,2.6vw,30px)]">Un repuesto no vive en una sola estación</h2>
      <p class="mt-4 max-w-[56ch] text-[16px] text-steel">
        Una parte de desgaste puede detener el lavado, el sellado, el ciclo o la impresión del
        registro. Por eso los repuestos se piden por equipo y no por estación.
      </p>
      <a href="/#proceso" class="meta mt-6 inline-block border-b border-rule pb-1 text-[10px] text-steel hover:text-navy">
        Ver el proceso completo
      </a>
    </div>
  </section>

  <Formulario tipo="repuestos" fijo="Repuesto" titulo="Díganos qué parte y de qué equipo." />

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} is:inline />
</Base>


