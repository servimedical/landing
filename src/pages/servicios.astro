---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Formulario from '../components/formulario/Formulario.astro';
import { servicios } from '../content/institucional.ts';
import { normalizar } from '../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);
const bloques = [servicios.tecnico, servicios.asesoria];
---
<Base
  titulo="Servicio técnico y diseño de centrales de esterilización — Servimedical Group"
  descripcion="Instalación, calificación y mantenimiento con técnicos propios entrenados por fábrica, y asesoría de diseño de centrales de esterilización para obra nueva, ampliación o remodelación."
>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor py-12 lg:py-16">
    <h1 class="max-w-[20ch] text-[clamp(30px,4vw,48px)]">{servicios.titulo}</h1>
    <p class="mt-6 max-w-[64ch] text-[clamp(16px,1.3vw,18px)] text-steel">{servicios.bajada}</p>
  </div>

  {bloques.map((b) => (
    <section class:list={['border-t border-rule', b.idx === '2.2' && 'field-paper']} aria-labelledby={`s-${b.idx}`}>
      <div class="contenedor py-12 lg:py-16">
        <p class="meta text-steel">{b.idx}</p>
        <h2 id={`s-${b.idx}`} class="mt-4 max-w-[24ch] text-[clamp(24px,3vw,34px)]">{b.titulo}</h2>
        <p class="mt-5 max-w-[56ch] text-[17px] text-steel">{b.intro}</p>

        {'angulo' in b && b.angulo && (
          <p class="mt-6 flex max-w-[58ch] items-start gap-3 text-[16px] font-medium">
            <span aria-hidden="true" class="senal mt-2"></span>{b.angulo}
          </p>
        )}

        <div class="mt-9 grid gap-px border border-rule bg-rule lg:grid-cols-2">
          {b.grupos.map((g) => (
            <div class:list={['p-6 lg:p-8', b.idx === '2.2' ? 'bg-white' : 'bg-white']}>
              <h3 class="text-[clamp(18px,2vw,23px)]">{g.titulo}</h3>
              {'angulo' in g && g.angulo && (
                <p class="mt-4 flex max-w-[42ch] items-start gap-3 text-[15px] font-medium">
                  <span aria-hidden="true" class="senal mt-2"></span>{g.angulo}
                </p>
              )}
              <ul class="mt-5 border-t border-rule">
                {g.puntos.map((x) => (
                  <li class="flex items-start gap-3 border-b border-rule py-3 text-[15px]">
                    <span aria-hidden="true" class="mt-2 block h-[7px] w-[7px] shrink-0 bg-mist"></span>{x}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {'alcance' in b && b.alcance && (
          <p class="meta mt-6 text-[10.5px] text-steel">{b.alcance}</p>
        )}
      </div>
    </section>
  ))}

  <section class="border-t border-rule" aria-labelledby="rutas">
    <div class="contenedor py-12 lg:py-16">
      <p class="meta text-steel">Por dónde empezar</p>
      <h2 id="rutas" class="mt-4 max-w-[24ch] text-[clamp(24px,3vw,34px)]">{servicios.cta.titulo}</h2>
      <p class="mt-5 max-w-[52ch] text-steel">{servicios.cta.texto}</p>

      <div class="mt-9 grid gap-px border border-rule bg-rule sm:grid-cols-2">
        {servicios.cta.rutas.map((r) => (
          <a href={r.ancla} class="group flex flex-col bg-white p-6 transition-colors hover:bg-paper lg:p-8">
            <span class="font-display text-[clamp(18px,2vw,23px)] leading-tight font-bold [font-variation-settings:'wdth'_110]">{r.titulo}</span>
            <span class="mt-3 flex-1 text-[15px] leading-relaxed text-steel">{r.texto}</span>
            <span class="meta mt-5 border-t border-rule pt-4 text-[10px] text-steel group-hover:text-navy">Ir al formulario →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Formulario tipo="servicio-tecnico" />
  <Formulario tipo="cotizacion" fijo="Asesoría y diseño de central" titulo="Cuéntenos del proyecto." />
</Base>
