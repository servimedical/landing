---
import Base from '../layouts/Base.astro';
import Migas from '../components/Migas.astro';
import Formulario from '../components/formulario/Formulario.astro';
import { servicios } from '../content/institucional.ts';
import { normalizar } from '../content/navegacion.ts';

const rutaActual = normalizar(Astro.url.pathname);
---
<Base
  titulo="Servicios | Servimedical"
  descripcion="Instalación y calificación, mantenimiento preventivo y correctivo, entrenamiento, y estudio y diseño de la central de esterilización. Técnicos propios en Colombia."
>
  <Migas rutaActual={rutaActual} />

  <div class="contenedor pt-10 pb-2 lg:pt-12">
    <h1 class="text-[clamp(30px,4vw,48px)]">Servicios</h1>
    <p class="mt-5 max-w-[58ch] text-[clamp(16px,1.3vw,18px)] text-steel">{servicios.lead}</p>
  </div>

  {servicios.items.map((s, i) => (
    <section class:list={['border-t border-rule', i % 2 === 1 && 'field-paper']} aria-labelledby={`s-${s.slug}`} id={s.slug}>
      <div class="contenedor py-12 lg:py-16">
        <h2 id={`s-${s.slug}`} class="text-[clamp(24px,3vw,34px)]">{s.titulo}</h2>
        <p class="mt-5 max-w-[56ch] text-[17px] text-steel">{s.resumen}</p>

        {s.angulo && (
          <p class="mt-6 flex max-w-[58ch] items-start gap-3 text-[16px] font-medium">
            <span aria-hidden="true" class="senal mt-2"></span>{s.angulo}
          </p>
        )}

        <ul class="mt-8 max-w-[70ch] border-t border-rule">
          {s.puntos.map((x) => (
            <li class="flex items-start gap-3 border-b border-rule py-3.5 text-[15.5px]">
              <span aria-hidden="true" class="mt-2 block h-[7px] w-[7px] shrink-0 bg-mist"></span>{x}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <Formulario titulo="Hable con un especialista en esterilización" />
</Base>
