# build
# Sin barra final: ahora son enlaces a las carpetas .nosync y un patrón con
# barra no casa con un enlace simbólico.
dist
.astro
.vercel

# dependencias
node_modules

# Carpetas excluidas de la sincronización de iCloud. macOS ignora todo lo que
# termine en .nosync, y así .git deja de corromperse mientras se sincroniza.
*.nosync

# entorno
.env
.env.production
.env*.local

# sistema / editor
.DS_Store
*.log
npm-debug.log*
.idea/
.vscode/

# config local del editor (rutas absolutas de esta máquina)
.claude/
scripts/.og.svg

# duplicados de Finder del intento previo en Next.js (25-08).
# Están en el disco, no en el repo. Se pueden borrar sin perder nada:
# quedaron registrados en el commit cfd902a.
src 2/
public 2/
